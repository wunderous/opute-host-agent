{
 "id": "selfcheck.broken-pass",
 "gate": "e2e-0",
 "description": "Negative control: the first call with a pass condition that cannot hold (health status 418) fails (pass-condition).",
 "inputs": {
  "agent": "the dev VM's production-style system unit (opute-bootstrap-mcp.service), test identity e2e-devvm-agent, test bearer token"
 },
 "requirements": [
  {
   "spec": "openspec/specs/host-agent-contract/spec.md",
   "requirement": "Compatible authenticated MCP surface",
   "scenario": "Read-only authenticated first call",
   "pass": [
    {
     "step": "discover",
     "path": "response.status",
     "equals": 200
    },
    {
     "step": "discover",
     "path": "response.body.result",
     "exists": true
    },
    {
     "step": "list",
     "path": "response.status",
     "equals": 200
    },
    {
     "step": "list",
     "path": "response.body.result.tools[0].name",
     "exists": true
    },
    {
     "step": "info",
     "path": "response.status",
     "equals": 200
    },
    {
     "step": "info",
     "path": "response.body.result.isError",
     "in": [
      null,
      false,
      "<absent>"
     ]
    },
    {
     "step": "info",
     "path": "response.body.result.structuredContent",
     "exists": true
    },
    {
     "step": "health",
     "path": "response.status",
     "equals": 418
    }
   ]
  }
 ],
 "effects": {
  "allow": [],
  "persist": []
 },
 "steps": [
  {
   "id": "health",
   "health": true
  },
  {
   "id": "discover",
   "mcp": "server/discover"
  },
  {
   "id": "list",
   "mcp": "tools/list"
  },
  {
   "id": "info",
   "mcp": "tools/call",
   "tool": "get_host_info",
   "arguments": {}
  }
 ],
 "cleanup": [],
 "maxMinutes": 10
}
