{
 "id": "neutral.reserved",
 "gate": "e2e-neutral",
 "description": "The Cloudflare provider's reserved-name guard as operator configuration: two 0.4.0 agents, each with its own Cloudflare provider and no Cloudflare credentials; one provider runs with OPUTE_RESERVED_HOSTNAMES=*.opute.io.",
 "inputs": {
  "agent": "the 0.4.0 candidate's release binary (the one the dev VM runs), started by the journey with `serve` and explicit settings",
  "provider": "the Rust Cloudflare provider 1.0.1 from the same release set, without Cloudflare credentials",
  "files": {
   "e2etool": {
    "path": "${REPO}/evidence/e2e/guest-tools/e2etool.py",
    "sha256": "ade206dda988e71aab7ddfcc6117a24d3283f70bf0b5995f0de439c552bfc606"
   },
   "mcpwire": {
    "path": "${REPO}/evidence/e2e/mcpwire.py",
    "sha256": "ab7a4bbac670918d7ab10f31ad5f157998404c8548b5c3ec974cae7aec0ab4fc"
   },
   "probe": {
    "path": "${REPO}/evidence/e2e/guest-tools/neutralprobe.py",
    "sha256": "1ed02ede839e09d7f4d0bea7779ae9e248951f6deb7c79a015af76cfbadfbdad"
   },
   "rust04": {
    "path": "${PARITY}/e2e/release/rust-0.4.0-rc1/host-agent-linux-x64.gz",
    "sha256": "8a5b5cf7edb696b290b4373ef26fee2e1c9a32fa9c3052ebc84e23833bd64654"
   },
   "providerCloudflare": {
    "path": "${PARITY}/e2e/release/rust-neutral/opute-provider-cloudflare-linux-x64",
    "sha256": "94afcf36c5af58c9e7c1f4f19d2176a6a903bbdd714c77bbf3b1cd24abeb3e77"
   },
   "activate": {
    "path": "${REPO}/evidence/e2e/journeys/inputs/cloudflare-activate-tunneling.yaml",
    "sha256": "6fec9957909058f39bc48bd35becae2e46be55a06b9b2ff4a9928a608772f460"
   }
  }
 },
 "requirements": [
  {
   "spec": "openspec/changes/platform-neutral-host-agent/specs/platform-neutral-host-agent/spec.md",
   "requirement": "Reserved names are operator configuration",
   "pass": [
    {
     "step": "providers",
     "path": "stdout",
     "equals": "2\n"
    },
    {
     "step": "toolsR",
     "path": "json.listed",
     "equals": true
    },
    {
     "step": "reservedName",
     "path": "response.body.result.result.isError",
     "equals": true
    },
    {
     "step": "reservedName",
     "path": "response.body.result.result.structuredContent.code",
     "equals": "reserved_hostname"
    },
    {
     "step": "reservedName",
     "path": "response.body.result.result.structuredContent.hostname",
     "equals": "mcp.opute.io"
    },
    {
     "step": "reservedName",
     "path": "response.body.result.result.structuredContent.pattern",
     "equals": "*.opute.io"
    },
    {
     "step": "otherName",
     "path": "response.body.result.result.isError",
     "equals": true
    },
    {
     "step": "otherName",
     "path": "response.body.result.result.content[0].text",
     "contains": "CLOUDFLARE_ACCOUNT_ID"
    }
   ],
   "scenario": "A deployment protects its names: with OPUTE_RESERVED_HOSTNAMES=*.opute.io a tunnel for mcp.opute.io is refused with reserved_hostname. The provider has no Cloudflare credentials, so no API call is possible; another hostname gets past the guard to that credentials error"
  },
  {
   "spec": "openspec/changes/platform-neutral-host-agent/specs/platform-neutral-host-agent/spec.md",
   "requirement": "Reserved names are operator configuration",
   "pass": [
    {
     "step": "toolsN",
     "path": "json.listed",
     "equals": true
    },
    {
     "step": "nothingReserved",
     "path": "response.body.result.result.isError",
     "equals": true
    },
    {
     "step": "nothingReserved",
     "path": "response.body.result.result.content[0].text",
     "contains": "CLOUDFLARE_ACCOUNT_ID"
    },
    {
     "step": "nothingReserved",
     "path": "response.body.result.result.structuredContent.code",
     "absent": true
    }
   ],
   "scenario": "Nothing reserved: mcp.opute.io is accepted like any other hostname and reaches the same credentials error"
  }
 ],
 "effects": {
  "allow": [
   "files//opt/opute-e2e/releases/rust-0.4.0*",
   "files//opt/opute-e2e/releases/rust-0.3.x*",
   "system/units/e2e-*",
   "system/unitFiles/e2e-*",
   "files//home/opute/.config/opute-e2e*",
   "files//opt/opute-e2e/providers*"
  ],
  "persist": []
 },
 "steps": [
  {
   "id": "tool",
   "copy": "e2etool",
   "to": "/opt/opute-e2e/guest/e2etool.py"
  },
  {
   "id": "wire",
   "copy": "mcpwire",
   "to": "/opt/opute-e2e/guest/mcpwire.py"
  },
  {
   "id": "probeCopy",
   "copy": "probe",
   "to": "/opt/opute-e2e/guest/neutralprobe.py"
  },
  {
   "id": "copy04",
   "copy": "rust04",
   "to": "/opt/opute-e2e/releases/rust-0.4.0/host-agent-linux-x64.gz"
  },
  {
   "id": "unpack04",
   "guest": "gzip -dc /opt/opute-e2e/releases/rust-0.4.0/host-agent-linux-x64.gz > /opt/opute-e2e/releases/rust-0.4.0/opute-host-agent && chmod 0755 /opt/opute-e2e/releases/rust-0.4.0/opute-host-agent && /opt/opute-e2e/releases/rust-0.4.0/opute-host-agent --version"
  },
  {
   "id": "providerCopy",
   "copy": "providerCloudflare",
   "to": "/opt/opute-e2e/providers/opute-provider-cloudflare",
   "mode": "0755"
  },
  {
   "id": "recipeCopy",
   "copy": "activate",
   "to": "/home/opute/.config/opute-e2e/cloudflare-activate-tunneling.yaml",
   "mode": "0644"
  },
  {
   "id": "agentR",
   "guest": "install -d -o opute -g opute /tmp/e2e-agents /tmp/e2e-agents/r /tmp/e2e-agents/r/home && systemd-run --quiet --collect --unit=e2e-agent-r --uid=opute --gid=opute --property=Restart=no --setenv='HOME=/tmp/e2e-agents/r/home' --setenv='OPUTE_REMOTE_AGENT_ID=e2e-cf-r' --setenv='MCP_AUTH_TOKEN=${SECRET:r}' --setenv='HOST_MCP_PORT=3041' --setenv='OPUTE_HOST_ALLOW_MUTATIONS=true' /opt/opute-e2e/releases/rust-0.4.0/opute-host-agent serve && for i in $(seq 120); do curl -fsS -o /dev/null http://127.0.0.1:3041/health && break; sleep 0.5; done; curl -fsS http://127.0.0.1:3041/health"
  },
  {
   "id": "agentN",
   "guest": "install -d -o opute -g opute /tmp/e2e-agents /tmp/e2e-agents/n /tmp/e2e-agents/n/home && systemd-run --quiet --collect --unit=e2e-agent-n --uid=opute --gid=opute --property=Restart=no --setenv='HOME=/tmp/e2e-agents/n/home' --setenv='OPUTE_REMOTE_AGENT_ID=e2e-cf-n' --setenv='MCP_AUTH_TOKEN=${SECRET:n}' --setenv='HOST_MCP_PORT=3042' --setenv='OPUTE_HOST_ALLOW_MUTATIONS=true' /opt/opute-e2e/releases/rust-0.4.0/opute-host-agent serve && for i in $(seq 120); do curl -fsS -o /dev/null http://127.0.0.1:3042/health && break; sleep 0.5; done; curl -fsS http://127.0.0.1:3042/health"
  },
  {
   "id": "listR",
   "mcp": "tools/list",
   "port": 3041,
   "auth": "secret:r"
  },
  {
   "id": "listN",
   "mcp": "tools/list",
   "port": 3042,
   "auth": "secret:n"
  },
  {
   "id": "providers",
   "guest": "chown -R opute /home/opute/.config/opute-e2e && systemd-run --quiet --collect --unit=e2e-provider-cf-r --uid=opute --gid=opute --setenv=HOME=/home/opute --setenv=OPUTE_PROVIDER_PORT=4330 --setenv='OPUTE_RESERVED_HOSTNAMES=*.opute.io' --property=Restart=no /opt/opute-e2e/providers/opute-provider-cloudflare && systemd-run --quiet --collect --unit=e2e-provider-cf-n --uid=opute --gid=opute --setenv=HOME=/home/opute --setenv=OPUTE_PROVIDER_PORT=4331 --property=Restart=no /opt/opute-e2e/providers/opute-provider-cloudflare && for i in $(seq 60); do ss -ltnH 'sport = :4330' | grep -q . && ss -ltnH 'sport = :4331' | grep -q . && break; sleep 0.5; done; ss -ltnH '( sport = :4330 or sport = :4331 )' | wc -l"
  },
  {
   "id": "installR",
   "mcp": "tools/call",
   "tool": "opute.provider.install",
   "arguments": {
    "descriptor": {
     "schema": "opute-provider-plugin.v1",
     "pluginId": "com.opute.cloudflare",
     "version": "1.0.1",
     "capabilities": [
      {
       "id": "opute.capability.tunneling.v1",
       "version": 1
      },
      {
       "id": "opute.capability.mesh-runtime.v1",
       "version": 1
      },
      {
       "id": "opute.capability.mesh-membership.v1",
       "version": 1
      },
      {
       "id": "opute.capability.public-ingress.v1",
       "version": 1
      }
     ],
     "server": {
      "transport": "streamable_http",
      "endpoint": "http://127.0.0.1:4330/mcp"
     }
    },
    "activate": true,
    "recipeSource": "/home/opute/.config/opute-e2e/cloudflare-activate-tunneling.yaml"
   },
   "port": 3041,
   "auth": "secret:r"
  },
  {
   "id": "installN",
   "mcp": "tools/call",
   "tool": "opute.provider.install",
   "arguments": {
    "descriptor": {
     "schema": "opute-provider-plugin.v1",
     "pluginId": "com.opute.cloudflare",
     "version": "1.0.1",
     "capabilities": [
      {
       "id": "opute.capability.tunneling.v1",
       "version": 1
      },
      {
       "id": "opute.capability.mesh-runtime.v1",
       "version": 1
      },
      {
       "id": "opute.capability.mesh-membership.v1",
       "version": 1
      },
      {
       "id": "opute.capability.public-ingress.v1",
       "version": 1
      }
     ],
     "server": {
      "transport": "streamable_http",
      "endpoint": "http://127.0.0.1:4331/mcp"
     }
    },
    "activate": true,
    "recipeSource": "/home/opute/.config/opute-e2e/cloudflare-activate-tunneling.yaml"
   },
   "port": 3042,
   "auth": "secret:n"
  },
  {
   "id": "toolsR",
   "guest": "python3 -c 'import sys, time, json; sys.path.insert(0, \"/opt/opute-e2e/guest\"); import mcpwire\nfor i in range(120):\n    r = mcpwire.mcp(3041, sys.argv[1], \"tools/list\", request_id=i + 1)\n    names = [t[\"name\"] for t in ((r.get(\"body\") or {}).get(\"result\") or {}).get(\"tools\") or []]\n    if \"opute.capability.tunneling.ensure-host-tunnel\" in names: break\n    time.sleep(0.5)\nprint(json.dumps({\"listed\": \"opute.capability.tunneling.ensure-host-tunnel\" in names}))' '${SECRET:r}'"
  },
  {
   "id": "toolsN",
   "guest": "python3 -c 'import sys, time, json; sys.path.insert(0, \"/opt/opute-e2e/guest\"); import mcpwire\nfor i in range(120):\n    r = mcpwire.mcp(3042, sys.argv[1], \"tools/list\", request_id=i + 1)\n    names = [t[\"name\"] for t in ((r.get(\"body\") or {}).get(\"result\") or {}).get(\"tools\") or []]\n    if \"opute.capability.tunneling.ensure-host-tunnel\" in names: break\n    time.sleep(0.5)\nprint(json.dumps({\"listed\": \"opute.capability.tunneling.ensure-host-tunnel\" in names}))' '${SECRET:n}'"
  },
  {
   "id": "catalogR",
   "mcp": "tools/list",
   "port": 3041,
   "auth": "secret:r"
  },
  {
   "id": "catalogN",
   "mcp": "tools/list",
   "port": 3042,
   "auth": "secret:n"
  },
  {
   "id": "reservedNameCall",
   "mcp": "tools/call",
   "tool": "opute.capability.tunneling.ensure-host-tunnel",
   "arguments": {
    "bindingId": "e2e",
    "placement": "host",
    "localTarget": "http://127.0.0.1:3041/mcp",
    "hostname": "mcp.opute.io",
    "tunnelName": "e2e-tunnel"
   },
   "port": 3041,
   "auth": "secret:r",
   "meta": {
    "io.modelcontextprotocol/clientCapabilities": {
     "extensions": {
      "io.modelcontextprotocol/tasks": {}
     }
    }
   },
   "capture": {
    "TID_reservedName": "response.body.result.taskId"
   }
  },
  {
   "id": "reservedName",
   "mcp": "tasks/get",
   "params": {
    "taskId": "${TID_reservedName}"
   },
   "meta": {
    "io.modelcontextprotocol/clientCapabilities": {
     "extensions": {
      "io.modelcontextprotocol/tasks": {}
     }
    }
   },
   "port": 3041,
   "auth": "secret:r",
   "until": {
    "path": "response.body.result.status",
    "in": [
     "completed",
     "failed",
     "cancelled"
    ]
   },
   "timeout": 120,
   "interval": 3
  },
  {
   "id": "otherNameCall",
   "mcp": "tools/call",
   "tool": "opute.capability.tunneling.ensure-host-tunnel",
   "arguments": {
    "bindingId": "e2e",
    "placement": "host",
    "localTarget": "http://127.0.0.1:3041/mcp",
    "hostname": "agent.example.test",
    "tunnelName": "e2e-tunnel"
   },
   "port": 3041,
   "auth": "secret:r",
   "meta": {
    "io.modelcontextprotocol/clientCapabilities": {
     "extensions": {
      "io.modelcontextprotocol/tasks": {}
     }
    }
   },
   "capture": {
    "TID_otherName": "response.body.result.taskId"
   }
  },
  {
   "id": "otherName",
   "mcp": "tasks/get",
   "params": {
    "taskId": "${TID_otherName}"
   },
   "meta": {
    "io.modelcontextprotocol/clientCapabilities": {
     "extensions": {
      "io.modelcontextprotocol/tasks": {}
     }
    }
   },
   "port": 3041,
   "auth": "secret:r",
   "until": {
    "path": "response.body.result.status",
    "in": [
     "completed",
     "failed",
     "cancelled"
    ]
   },
   "timeout": 120,
   "interval": 3
  },
  {
   "id": "nothingReservedCall",
   "mcp": "tools/call",
   "tool": "opute.capability.tunneling.ensure-host-tunnel",
   "arguments": {
    "bindingId": "e2e",
    "placement": "host",
    "localTarget": "http://127.0.0.1:3042/mcp",
    "hostname": "mcp.opute.io",
    "tunnelName": "e2e-tunnel"
   },
   "port": 3042,
   "auth": "secret:n",
   "meta": {
    "io.modelcontextprotocol/clientCapabilities": {
     "extensions": {
      "io.modelcontextprotocol/tasks": {}
     }
    }
   },
   "capture": {
    "TID_nothingReserved": "response.body.result.taskId"
   }
  },
  {
   "id": "nothingReserved",
   "mcp": "tasks/get",
   "params": {
    "taskId": "${TID_nothingReserved}"
   },
   "meta": {
    "io.modelcontextprotocol/clientCapabilities": {
     "extensions": {
      "io.modelcontextprotocol/tasks": {}
     }
    }
   },
   "port": 3042,
   "auth": "secret:n",
   "until": {
    "path": "response.body.result.status",
    "in": [
     "completed",
     "failed",
     "cancelled"
    ]
   },
   "timeout": 120,
   "interval": 3
  }
 ],
 "cleanup": [
  {
   "id": "clean",
   "guest": "python3 /opt/opute-e2e/guest/e2etool.py agent remove r >/dev/null; python3 /opt/opute-e2e/guest/e2etool.py agent remove n >/dev/null; systemctl stop e2e-provider-cf-r e2e-provider-cf-n 2>/dev/null; rm -rf /home/opute/.config/opute-e2e /opt/opute-e2e/providers; rm -rf /opt/opute-e2e/releases/rust-0.4.0 /opt/opute-e2e/releases/rust-0.3.x /opt/opute-e2e/guest/neutralprobe.py; true"
  }
 ],
 "maxMinutes": 15
}
