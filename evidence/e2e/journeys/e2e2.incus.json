{
 "id": "e2e2.incus",
 "gate": "e2e-2",
 "description": "Incus containers and VMs through typed calls on a second agent with ownership enforced: a container with a pinned address and a VM, both reachable; the VM's console (open, type, resize, detach, end with the agent) and a bridged NIC attached and removed; lifecycle; a VM resize; root disk growth and its quota; refusals on an instance the agent does not own; reset of an owned container; delete. Guests live in the default project (Q16).",
 "inputs": {
  "agent": "the dev VM's production-style system unit opute-bootstrap-mcp.service (Rust 0.4.0 release candidate binary, test identity e2e-devvm-agent, test token)",
  "agentB": "a transient Rust agent e2e-incus-b on port 3032 (e2etool agent start) with Incus ownership enforced and itself as the shared host owner",
  "images": "the snapshot's local Incus images parity-noble (container) and parity-noble-vm",
  "files": {
   "e2etool": {
    "path": "${REPO}/evidence/e2e/guest-tools/e2etool.py",
    "sha256": "ade206dda988e71aab7ddfcc6117a24d3283f70bf0b5995f0de439c552bfc606"
   },
   "mcpwire": {
    "path": "${REPO}/evidence/e2e/mcpwire.py",
    "sha256": "ab7a4bbac670918d7ab10f31ad5f157998404c8548b5c3ec974cae7aec0ab4fc"
   }
  }
 },
 "requirements": [
  {
   "spec": "the agent's published tools/list (inputSchema, outputSchema, description) for the tool named",
   "requirement": "provision_container, provision_vm, get_vm_info, list_vms, run_instance_command",
   "pass": [
    {
     "step": "listBefore",
     "path": "response.body.result.structuredContent.vms",
     "in": [
      [],
      "<absent>"
     ]
    },
    {
     "step": "container",
     "path": "response.body.result.result.isError",
     "equals": false
    },
    {
     "step": "container",
     "path": "response.body.result.result.structuredContent.uri",
     "equals": "container:local:e2e-c1"
    },
    {
     "step": "vm",
     "path": "response.body.result.result.isError",
     "equals": false
    },
    {
     "step": "vm",
     "path": "response.body.result.result.structuredContent.uri",
     "equals": "vm:local:e2e-v1"
    },
    {
     "step": "infoC",
     "path": "response.body.result.structuredContent.status",
     "equals": "running"
    },
    {
     "step": "vmAddress",
     "path": "stdout",
     "equals": "1\n"
    },
    {
     "step": "infoV",
     "path": "response.body.result.structuredContent.status",
     "equals": "running"
    },
    {
     "step": "infoV",
     "path": "response.body.result.structuredContent.agentReady",
     "equals": true
    },
    {
     "step": "listBoth",
     "path": "response.body.result.structuredContent.vms[0].uri",
     "equals": "container:local:e2e-c1"
    },
    {
     "step": "listBoth",
     "path": "response.body.result.structuredContent.vms[1].uri",
     "equals": "vm:local:e2e-v1"
    },
    {
     "step": "serveC",
     "path": "response.body.result.structuredContent.exitCode",
     "equals": 0
    },
    {
     "step": "reachC",
     "path": "stdout",
     "equals": "ping-ok\n200"
    },
    {
     "step": "runV",
     "path": "response.body.result.structuredContent.stdout",
     "equals": "1\nLinux\n"
    },
    {
     "step": "reachV",
     "path": "stdout",
     "matches": "^ping-ok\n"
    }
   ],
   "scenario": "A container and a virtual machine provisioned in the default project; both boot and answer at their addresses (ping and a TCP service)"
  },
  {
   "spec": "openspec/changes/incus-project-selection/specs/incus-project-selection/spec.md",
   "requirement": "One Incus project per agent",
   "pass": [
    {
     "step": "otherProject",
     "path": "stdout",
     "equals": "1\ne2e-other (current)\n"
    },
    {
     "step": "container",
     "path": "response.body.result.result.isError",
     "equals": false
    },
    {
     "step": "infoC",
     "path": "response.body.result.structuredContent.status",
     "equals": "running"
    },
    {
     "step": "inDefault",
     "path": "stdout",
     "equals": "e2e-c1\n0\n"
    },
    {
     "step": "projectBack",
     "path": "stdout",
     "equals": "restored\n"
    }
   ],
   "scenario": "With agent B's Incus client switched to project e2e-other, the container it provisions is created and observed in default, and e2e-other stays empty (D28)"
  },
  {
   "spec": "openspec/changes/declare-read-inputs/specs/capability-input-schemas/spec.md",
   "requirement": "A tool's published input schema declares every input it reads",
   "pass": [
    {
     "step": "infoC",
     "path": "response.body.result.structuredContent.ipv4[0]",
     "equals": "10.0.100.50"
    },
    {
     "step": "infoAfter",
     "path": "response.body.result.structuredContent.ipv4[0]",
     "equals": "10.0.100.50"
    }
   ],
   "scenario": "provision_container's declared ipv4Address pins the container's bridge address across stop, start and restart (D28)"
  },
  {
   "spec": "the agent's published tools/list (inputSchema, outputSchema, description) for the tool named",
   "requirement": "stop_vm, start_vm, restart_vm, update_vm_resources",
   "pass": [
    {
     "step": "stopC",
     "path": "response.body.result.result.structuredContent.status",
     "equals": "stopped"
    },
    {
     "step": "startC",
     "path": "response.body.result.result.structuredContent.status",
     "equals": "running"
    },
    {
     "step": "restartC",
     "path": "response.body.result.result.isError",
     "equals": false
    },
    {
     "step": "stopV",
     "path": "response.body.result.result.structuredContent.status",
     "equals": "stopped"
    },
    {
     "step": "resizeV",
     "path": "response.body.result.isError",
     "in": [
      false,
      "<absent>"
     ]
    },
    {
     "step": "startV",
     "path": "response.body.result.result.structuredContent.status",
     "equals": "running"
    },
    {
     "step": "limitsV",
     "path": "stdout",
     "equals": "2\n1536MiB\n"
    }
   ],
   "scenario": "Lifecycle of both kinds; a stopped VM resized and started with its new limits"
  },
  {
   "spec": "the agent's published tools/list (inputSchema, outputSchema, description) for the tool named",
   "requirement": "update_vm_resources disk is admitted only where the pool enforces it",
   "pass": [
    {
     "step": "grow",
     "path": "response.body.result.isError",
     "in": [
      false,
      "<absent>"
     ]
    },
    {
     "step": "rootSize",
     "path": "stdout",
     "equals": "5GiB\n"
    },
    {
     "step": "overQuota",
     "path": "response.body.result.structuredContent.exitCode",
     "gte": 1
    },
    {
     "step": "overQuota",
     "path": "response.body.result.structuredContent.stderr",
     "matches": "(Disk quota exceeded|No space left on device)"
    }
   ],
   "scenario": "The container's root disk grows to 5GiB on the btrfs pool, and a 6GiB write inside it fails at the quota"
  },
  {
   "spec": "the agent's published tools/list (inputSchema, outputSchema, description) for the tool named",
   "requirement": "Incus ownership (OPUTE_INCUS_OWNERSHIP_MODE=enforce)",
   "pass": [
    {
     "step": "listBefore",
     "path": "response.body.result.structuredContent.vms",
     "in": [
      [],
      "<absent>"
     ]
    },
    {
     "step": "stopForeign",
     "path": "response.body.result.result.isError",
     "equals": true
    },
    {
     "step": "stopForeign",
     "path": "response.body.result.result.structuredContent.code",
     "equals": "resource_binding"
    },
    {
     "step": "deleteForeign",
     "path": "response.body.result.result.isError",
     "equals": true
    },
    {
     "step": "deleteForeign",
     "path": "response.body.result.result.structuredContent.code",
     "equals": "resource_binding"
    },
    {
     "step": "resetForeign",
     "path": "response.body.result.result.isError",
     "equals": true
    },
    {
     "step": "resetForeign",
     "path": "response.body.result.result.content[0].text",
     "matches": "refuses unowned instance"
    },
    {
     "step": "foreignAfter",
     "path": "stdout",
     "equals": "RUNNING\n"
    }
   ],
   "scenario": "An instance created outside the agent is not listed by the enforcing agent, so stop and delete are refused at admission (unknown resource), reset refuses it as unowned, and it keeps running"
  },
  {
   "spec": "the agent's published tools/list (inputSchema, outputSchema, description) for the tool named",
   "requirement": "reset_virtualization_stack resets explicitly selected owned instances",
   "pass": [
    {
     "step": "reset",
     "path": "response.body.result.result.isError",
     "equals": false
    },
    {
     "step": "resetGone",
     "path": "stdout",
     "equals": "0\n"
    }
   ],
   "scenario": "The owned container is deleted and the stack reinstalled and verified, behind matching disposable-host fingerprints and authorization"
  },
  {
   "spec": "the agent's published tools/list (inputSchema, outputSchema, description) for the tool named",
   "requirement": "delete_vm",
   "pass": [
    {
     "step": "deleteV",
     "path": "response.body.result.result.structuredContent.deleted",
     "equals": true
    },
    {
     "step": "deleteAgain",
     "path": "response.body.result.result.isError",
     "in": [
      false,
      true
     ]
    },
    {
     "step": "listAfter",
     "path": "response.body.result.structuredContent.vms",
     "in": [
      [],
      "<absent>"
     ]
    },
    {
     "step": "left",
     "path": "stdout",
     "equals": "e2e-foreign\n"
    }
   ],
   "scenario": "Every owned guest is gone after delete; only the foreign instance remains"
  },
  {
   "spec": "openspec/changes/vm-console-session/specs/vm-console-session/spec.md",
   "requirement": "A console session runs the instance's console",
   "pass": [
    {
     "step": "console",
     "path": "response.body.result.structuredContent.status",
     "equals": "started"
    },
    {
     "step": "console",
     "path": "response.body.result.structuredContent.operationId",
     "equals": "console-e2e-v1"
    },
    {
     "step": "console",
     "path": "response.body.result.structuredContent.uri",
     "equals": "vm:local:e2e-v1"
    },
    {
     "step": "consoleAgain",
     "path": "response.body.result.structuredContent.status",
     "equals": "started"
    },
    {
     "step": "consoleProcs",
     "path": "stdout",
     "equals": "1\n"
    }
   ],
   "scenario": "One session per instance: a second start replaces the first, and one console process runs"
  },
  {
   "spec": "openspec/changes/vm-console-session/specs/vm-console-session/spec.md",
   "requirement": "Console output is read by pull from a bounded buffer",
   "pass": [
    {
     "step": "consoleRead",
     "path": "response.body.result.structuredContent.status",
     "equals": "sent"
    },
    {
     "step": "consoleRead",
     "path": "response.body.result.structuredContent.output",
     "matches": "(login|Password): $"
    },
    {
     "step": "consoleRead",
     "path": "response.body.result.structuredContent.closed",
     "equals": false
    },
    {
     "step": "consoleCtrlA",
     "path": "response.body.result.structuredContent.closed",
     "equals": false
    },
    {
     "step": "consoleDetach",
     "path": "response.body.result.structuredContent.closed",
     "equals": true
    },
    {
     "step": "consoleAfter",
     "path": "response.body.result.isError",
     "equals": true
    },
    {
     "step": "consoleAfter",
     "path": "response.body.result.content[0].text",
     "matches": "console-e2e-v1"
    },
    {
     "step": "consoleGone",
     "path": "stdout",
     "equals": "0\n"
    }
   ],
   "scenario": "Enter typed on the console brings the guest's getty prompt back; ctrl+a then q ends the session, the read that reports it is the last, and no console process is left"
  },
  {
   "spec": "openspec/changes/vm-console-session/specs/vm-console-session/spec.md",
   "requirement": "A console's size can be changed",
   "pass": [
    {
     "step": "consoleResize",
     "path": "response.body.result.structuredContent.status",
     "equals": "resized"
    },
    {
     "step": "consoleResizeBad",
     "path": "response.body.result.isError",
     "equals": true
    },
    {
     "step": "consoleResizeBad",
     "path": "response.body.result.content[0].text",
     "matches": "console size must be positive"
    }
   ],
   "scenario": "Resize to 120 by 40; a zero width is refused"
  },
  {
   "spec": "openspec/changes/vm-console-session/specs/vm-console-session/spec.md",
   "requirement": "Sessions end with the agent",
   "pass": [
    {
     "step": "consoleHeld",
     "path": "response.body.result.structuredContent.status",
     "equals": "started"
    },
    {
     "step": "consoleHeldProcs",
     "path": "stdout",
     "equals": "1\n"
    },
    {
     "step": "stopB",
     "path": "stdout",
     "equals": "0\n"
    },
    {
     "step": "restartB",
     "path": "stdout",
     "equals": "started\n"
    }
   ],
   "scenario": "With a session open, agent B is stopped (SIGTERM from its systemd unit) and no console process remains; B starts again on the same state. The unit's cgroup stop would also end it, so the agent's own close on shutdown is shown by the console unit test"
  },
  {
   "spec": "openspec/changes/vm-bridged-nic/specs/vm-bridged-nic/spec.md",
   "requirement": "configure_network attaches one bridged NIC",
   "pass": [
    {
     "step": "bridge",
     "path": "stdout",
     "equals": "up\n"
    },
    {
     "step": "nic",
     "path": "response.body.result.result.structuredContent.status",
     "equals": "attached"
    },
    {
     "step": "nic",
     "path": "response.body.result.result.structuredContent.deviceName",
     "equals": "eth1"
    },
    {
     "step": "nic",
     "path": "response.body.result.result.structuredContent.parent",
     "equals": "e2e-br0"
    },
    {
     "step": "nic",
     "path": "response.body.result.result.structuredContent.uri",
     "equals": "vm:local:e2e-v1"
    },
    {
     "step": "nicAgain",
     "path": "response.body.result.result.structuredContent.status",
     "equals": "attached"
    },
    {
     "step": "nicConflict",
     "path": "response.body.result.result.isError",
     "equals": true
    },
    {
     "step": "nicConflict",
     "path": "response.body.result.result.content[0].text",
     "matches": "different configuration"
    },
    {
     "step": "nicNoParent",
     "path": "response.body.result.result.isError",
     "equals": true
    },
    {
     "step": "nicNoParent",
     "path": "response.body.result.result.content[0].text",
     "matches": "e2e-nope"
    },
    {
     "step": "nicDevices",
     "path": "stdout",
     "equals": "1\nbridged\n0\n"
    },
    {
     "step": "nicGuest",
     "path": "response.body.result.structuredContent.stdout",
     "equals": "2\n"
    }
   ],
   "scenario": "Attach and attach again: one bridged eth1 on e2e-br0, seen by the guest as a second interface; a conflicting eth1 and a missing parent are refused and add nothing"
  },
  {
   "spec": "openspec/changes/remove-vm-network-device/specs/remove-vm-network-device/spec.md",
   "requirement": "remove_vm_network_device removes one NIC from an instance's own configuration",
   "pass": [
    {
     "step": "nicProfile",
     "path": "response.body.result.result.isError",
     "equals": true
    },
    {
     "step": "nicProfile",
     "path": "response.body.result.result.content[0].text",
     "matches": "profile"
    },
    {
     "step": "nicRemove",
     "path": "response.body.result.result.structuredContent.removed",
     "equals": true
    },
    {
     "step": "nicRemoveAgain",
     "path": "response.body.result.result.structuredContent.removed",
     "equals": false
    },
    {
     "step": "nicAfter",
     "path": "stdout",
     "equals": "0\n1\ngone\n"
    }
   ],
   "scenario": "The profile's eth0 is refused and the VM keeps its address; eth1 is removed, then removing it again changes nothing"
  }
 ],
 "effects": {
  "allow": [
   "incus/*",
   "files//home/opute/.config/incus*",
   "system/units/e2e-*",
   "system/unitFiles/e2e-*",
   "files//opt/incus*",
   "files//usr/lib/systemd/system/incus*",
   "system/units/linstor-satellite.service",
   "system/units/packagekit.service",
   "files//var/lib/dpkg*",
   "files//var/lib/apt*",
   "files//var/cache*",
   "files//var/log*",
   "system/units/sys-devices-virtual-net-veth*",
   "system/units/sys-subsystem-net-devices-veth*",
   "system/units/sys-devices-virtual-net-tap*",
   "system/units/sys-subsystem-net-devices-tap*",
   "system/units/sys-devices-virtual-net-e2e*",
   "system/units/sys-subsystem-net-devices-e2e*"
  ],
  "persist": [
   "files//opt/incus*",
   "files//usr/lib/systemd/system/incus*",
   "system/units/linstor-satellite.service",
   "system/units/packagekit.service",
   "files//var/lib/dpkg*",
   "files//var/lib/apt*",
   "files//var/cache*",
   "files//var/log*"
  ]
 },
 "steps": [
  {
   "id": "tool",
   "copy": "e2etool",
   "to": "/opt/opute-e2e/guest/e2etool.py"
  },
  {
   "id": "wire",
   "copy": "mcpwire",
   "to": "/opt/opute-e2e/guest/mcpwire.py"
  },
  {
   "id": "agentB",
   "guest": "python3 /opt/opute-e2e/guest/e2etool.py agent start b --port 3032 --id e2e-incus-b --env OPUTE_STANDALONE_ALLOW_MUTATIONS=true --env OPUTE_HOST_AGENT_INSTANCE=e2e-incus-b --env OPUTE_INCUS_OWNERSHIP_MODE=enforce --env OPUTE_SHARED_HOST_OWNER_INSTANCE=e2e-incus-b --env MCP_AUTH_TOKEN='${SECRET:tokenB}' >/dev/null && echo started"
  },
  {
   "id": "catalogB",
   "mcp": "tools/list",
   "port": 3032,
   "auth": "secret:tokenB"
  },
  {
   "id": "foreign",
   "guest": "incus launch parity-noble e2e-foreign -q && incus list e2e-foreign -c s -f csv"
  },
  {
   "id": "otherProject",
   "guest": "cp -p /home/opute/.config/incus/config.yml /root/e2e-incus-config.yml && incus project create e2e-other -q && runuser -u opute -- incus project switch e2e-other && runuser -u opute -- incus project list -f csv | grep -c '(current)' && runuser -u opute -- incus project list -f csv | grep '(current)' | cut -d, -f1"
  },
  {
   "id": "listBefore",
   "mcp": "tools/call",
   "tool": "list_vms",
   "arguments": {},
   "port": 3032,
   "auth": "secret:tokenB",
   "retryOn": [
    "host_capacity_saturated"
   ]
  },
  {
   "id": "containerCall",
   "mcp": "tools/call",
   "tool": "provision_container",
   "arguments": {
    "containerName": "e2e-c1",
    "image": "parity-noble",
    "disk": "4GiB",
    "cpus": 1,
    "memory": "1GiB",
    "ipv4Address": "10.0.100.50"
   },
   "port": 3032,
   "auth": "secret:tokenB",
   "meta": {
    "io.modelcontextprotocol/clientCapabilities": {
     "extensions": {
      "io.modelcontextprotocol/tasks": {}
     }
    }
   },
   "capture": {
    "TID_container": "response.body.result.taskId"
   },
   "retryOn": [
    "host_capacity_saturated"
   ]
  },
  {
   "id": "container",
   "mcp": "tasks/get",
   "params": {
    "taskId": "${TID_container}"
   },
   "meta": {
    "io.modelcontextprotocol/clientCapabilities": {
     "extensions": {
      "io.modelcontextprotocol/tasks": {}
     }
    }
   },
   "port": 3032,
   "auth": "secret:tokenB",
   "until": {
    "path": "response.body.result.status",
    "in": [
     "completed",
     "failed",
     "cancelled"
    ]
   },
   "timeout": 600,
   "interval": 3
  },
  {
   "id": "vmCall",
   "mcp": "tools/call",
   "tool": "provision_vm",
   "arguments": {
    "name": "e2e-v1",
    "instanceType": "virtual-machine",
    "image": "parity-noble-vm",
    "cpus": 1,
    "memory": "1GiB",
    "disk": "10GiB"
   },
   "port": 3032,
   "auth": "secret:tokenB",
   "meta": {
    "io.modelcontextprotocol/clientCapabilities": {
     "extensions": {
      "io.modelcontextprotocol/tasks": {}
     }
    }
   },
   "capture": {
    "TID_vm": "response.body.result.taskId"
   },
   "retryOn": [
    "host_capacity_saturated"
   ]
  },
  {
   "id": "vm",
   "mcp": "tasks/get",
   "params": {
    "taskId": "${TID_vm}"
   },
   "meta": {
    "io.modelcontextprotocol/clientCapabilities": {
     "extensions": {
      "io.modelcontextprotocol/tasks": {}
     }
    }
   },
   "port": 3032,
   "auth": "secret:tokenB",
   "until": {
    "path": "response.body.result.status",
    "in": [
     "completed",
     "failed",
     "cancelled"
    ]
   },
   "timeout": 900,
   "interval": 3
  },
  {
   "id": "infoC",
   "mcp": "tools/call",
   "tool": "get_vm_info",
   "arguments": {
    "uri": "container:local:e2e-c1"
   },
   "port": 3032,
   "auth": "secret:tokenB",
   "retryOn": [
    "host_capacity_saturated"
   ]
  },
  {
   "id": "inDefault",
   "guest": "incus list e2e-c1 --project default -c n -f csv; incus list --project e2e-other -c n -f csv | wc -l"
  },
  {
   "id": "vmAddress",
   "guest": "for i in $(seq 150); do incus list e2e-v1 -c 4 -f csv | grep -q '10\\.0\\.100\\.' && break; sleep 2; done; incus list e2e-v1 -c 4 -f csv | grep -c '10\\.0\\.100\\.'"
  },
  {
   "id": "infoV",
   "mcp": "tools/call",
