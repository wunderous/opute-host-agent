{
 "id": "e2e1.migrate-upgrade",
 "gate": "e2e-1",
 "description": "Flow 14, migration and upgrade: the host is reinstalled as a Go v0.2.4 install (the published release, the same unit, path, instance root and agent ID) and does work, one run completed and one stopped in flight; the binary is then replaced by the Rust 0.3.0 release candidate, and then upgraded in place to a newer local Rust build (0.3.1-e2e, built locally; no tag, no publish). Go is the source install, not an oracle.",
 "inputs": {
  "agent": "the dev VM's production-style system unit opute-bootstrap-mcp.service (Rust 0.3.0 release candidate binary, test identity e2e-devvm-agent, test token)",
  "files": {
   "e2etool": {
    "path": "${REPO}/evidence/e2e/guest-tools/e2etool.py",
    "sha256": "3df5fb327e6a68431ab37be00488c42b1a41b67dfb2f3b5ac166f50915cdb96f"
   },
   "mcpwire": {
    "path": "${REPO}/evidence/e2e/mcpwire.py",
    "sha256": "ab7a4bbac670918d7ab10f31ad5f157998404c8548b5c3ec974cae7aec0ab4fc"
   },
   "rustNext": {
    "path": "${PARITY}/e2e/release/rust-0.3.0-rc3-next/host-agent-linux-x64.gz",
    "sha256": "2e474a45143c1fc500620ae8df60c8c6986997cda265c7596617c51dc82a0a7d"
   }
  },
  "go": "/opt/opute-e2e/releases/go/v0.2.4 (published Go v0.2.4 release, SHA256SUMS pinned)",
  "next": "Rust release set built locally with VERSION=0.3.1-e2e"
 },
 "requirements": [
  {
   "spec": "openspec/specs/host-agent-contract/spec.md",
   "requirement": "Durable and redacted observations",
   "pass": [
    {
     "step": "aside",
     "path": "exit",
     "equals": 0
    },
    {
     "step": "goInstall",
     "path": "exit",
     "equals": 0
    },
    {
     "step": "goInstall",
     "path": "stdout",
     "matches": "\n0\\.2\\.4\n$"
    },
    {
     "step": "goDoneWait",
     "path": "response.body.result.structuredContent.status",
     "equals": "completed"
    },
    {
     "step": "goInFlight",
     "path": "response.body.result.structuredContent.nodes.n2.attempts",
     "equals": 1
    },
    {
     "step": "goStop",
     "path": "exit",
     "equals": 0
    },
    {
     "step": "goStop",
     "path": "json.integrity",
     "equals": "ok"
    },
    {
     "step": "rustInstall",
     "path": "exit",
     "equals": 0
    },
    {
     "step": "rustInstall",
     "path": "stdout",
     "matches": "\n0\\.3\\.0\n$"
    },
    {
     "step": "rustList",
     "path": "response.status",
     "equals": 200
    },
    {
     "step": "rustDb",
     "path": "json.integrity",
     "equals": "ok"
    },
    {
     "step": "rustDb",
     "path": "json.planRunIds",
     "equalsStep": {
      "step": "goStop",
      "path": "json.planRunIds"
     }
    },
    {
     "step": "rustDb",
     "path": "json.operationIds",
     "equalsStep": {
      "step": "goStop",
      "path": "json.operationIds"
     }
    },
    {
     "step": "rustDb",
     "path": "json.counts",
     "equalsStep": {
      "step": "goStop",
      "path": "json.counts"
     }
    },
    {
     "step": "rustDone",
     "path": "response.body.result.structuredContent.runId",
     "equalsStep": {
      "step": "goDone",
      "path": "response.body.result.structuredContent.runId"
     }
    },
    {
     "step": "rustDone",
     "path": "response.body.result.structuredContent.status",
     "equals": "completed"
    },
    {
     "step": "rustFlight",
     "path": "response.body.result.structuredContent.runId",
     "equalsStep": {
      "step": "goFlight",
      "path": "response.body.result.structuredContent.runId"
     }
    },
    {
     "step": "rustFlight",
     "path": "response.body.result.structuredContent.status",
     "exists": true
    }
   ],
   "scenario": "a Go v0.2.4 install's state, with a run stopped in flight, is served by Rust on the same instance root: every operation and run is there once, unchanged (D1: the schema is bit-compatible, so conversion is the identity)"
  },
  {
   "spec": "openspec/specs/host-agent-contract/spec.md",
   "requirement": "Compatible modes, configuration, and distribution",
   "pass": [
    {
     "step": "upgrade",
     "path": "exit",
     "equals": 0
    },
    {
     "step": "upgrade",
     "path": "stdout",
     "matches": "\n0\\.3\\.1-e2e\n$"
    },
    {
     "step": "nextList",
     "path": "response.status",
     "equals": 200
    },
    {
     "step": "nextDb",
     "path": "json.integrity",
     "equals": "ok"
    },
    {
     "step": "nextDb",
     "path": "json.planRunIds",
     "equalsStep": {
      "step": "goStop",
      "path": "json.planRunIds"
     }
    },
    {
     "step": "nextDb",
     "path": "json.operationIds",
     "equalsStep": {
      "step": "goStop",
      "path": "json.operationIds"
     }
    },
    {
     "step": "nextDb",
     "path": "json.counts",
     "equalsStep": {
      "step": "goStop",
      "path": "json.counts"
     }
    },
    {
     "step": "nextDone",
     "path": "response.body.result.structuredContent.status",
     "equals": "completed"
    },
    {
     "step": "nextFlight",
     "path": "response.body.result.structuredContent.runId",
     "equalsStep": {
      "step": "goFlight",
      "path": "response.body.result.structuredContent.runId"
     }
    }
   ],
   "scenario": "an in-place upgrade to a newer local Rust build keeps the state, unchanged"
  },
  {
   "spec": "openspec/specs/host-agent-contract/spec.md",
   "requirement": "One exact Host Agent identity",
   "pass": [
    {
     "step": "goHealth",
     "path": "response.body.agentId",
     "equals": "e2e-devvm-agent"
    },
    {
     "step": "rustHealth",
     "path": "response.body.agentId",
     "equals": "e2e-devvm-agent"
    },
    {
     "step": "nextHealth",
     "path": "response.body.agentId",
     "equals": "e2e-devvm-agent"
    }
   ]
  },
  {
   "spec": "openspec/changes/truthful-interrupted-plan/specs/host-agent-contract/spec.md",
   "requirement": "An interrupted plan or task reads back truthfully",
   "pass": [
    {
     "step": "rustFlight",
     "path": "response.body.result.structuredContent.status",
     "equals": "cancelled"
    },
    {
     "step": "nextFlight",
     "path": "response.body.result.structuredContent.status",
     "equals": "cancelled"
    }
   ],
   "scenario": "A run Go stopped gracefully in flight reads back cancelled after the migration and the upgrade, and is not run again (D28)"
  }
 ],
 "effects": {
  "allow": [
   "files//home/opute/.local/share/opute/opute-host-agent/sha256",
   "files//home/opute/.config/opute-e2e*",
   "files//opt/opute-e2e/releases/rust-next*",
   "system/units/e2e-slow*",
   "system/unitFiles/e2e-slow*"
  ],
  "persist": []
 },
 "steps": [
  {
   "id": "tool",
   "copy": "e2etool",
   "to": "/opt/opute-e2e/guest/e2etool.py"
  },
  {
   "id": "wire",
   "copy": "mcpwire",
   "to": "/opt/opute-e2e/guest/mcpwire.py"
  },
  {
   "id": "nextCopy",
   "copy": "rustNext",
   "to": "/opt/opute-e2e/releases/rust-next/host-agent-linux-x64.gz"
  },
  {
   "id": "aside",
   "guest": "systemctl stop opute-bootstrap-mcp.service && mv /home/opute/.config/opute/instances /tmp/e2e-j8-rust-instances"
  },
  {
   "id": "goInstall",
   "guest": "systemctl stop opute-bootstrap-mcp.service && gzip -dc /opt/opute-e2e/releases/go/v0.2.4/host-agent-linux-x64.gz > /tmp/oha && install -o opute -g opute -m 0755 /tmp/oha /home/opute/.local/share/opute/opute-host-agent && rm /tmp/oha && sha256sum /home/opute/.local/share/opute/opute-host-agent | cut -c1-64 && systemctl start opute-bootstrap-mcp.service && for i in $(seq 120); do curl -fsS -o /dev/null http://127.0.0.1:3014/health && break; sleep 0.5; done && /home/opute/.local/share/opute/opute-host-agent --version"
  },
  {
   "id": "goHealth",
   "health": true
  },
  {
   "id": "goList",
   "mcp": "tools/list"
  },
  {
   "id": "slow",
   "guest": "python3 /opt/opute-e2e/guest/e2etool.py slow start --port 8799 --delay 60"
  },
  {
   "id": "goDone",
   "mcp": "tools/call",
   "tool": "run_host_plan",
   "arguments": {
    "plan": {
     "contractVersion": "host-plan.v1",
     "planId": "e2e1-j8-done",
     "generation": 1,
     "idempotencyKey": "e2e1-j8-done-1",
     "nodes": [
      {
       "id": "n1",
       "action": {
        "tool": "ensure_host_file",
        "args": {
         "path": ".config/opute-e2e/j8-done.txt",
         "content": "e2e\n",
         "scope": "user"
        }
       },
       "validate": {
        "tool": "inspect_host_file",
        "args": {
         "path": ".config/opute-e2e/j8-done.txt",
         "scope": "user"
        },
        "assert": [
         {
          "path": "/exists",
          "op": "eq",
          "value": true
         }
        ]
       }
      }
     ]
    }
   },
   "capture": {
    "DONE": "response.body.result.structuredContent.runId"
   }
  },
  {
   "id": "goDoneWait",
   "mcp": "tools/call",
   "tool": "get_host_plan_run",
   "arguments": {
    "runId": "${DONE}"
   },
   "until": {
    "path": "response.body.result.structuredContent.status",
    "in": [
     "completed",
     "failed",
     "cancelled"
    ]
   },
   "timeout": 90
  },
  {
   "id": "goFlight",
   "mcp": "tools/call",
   "tool": "run_host_plan",
   "arguments": {
    "plan": {
     "contractVersion": "host-plan.v1",
     "planId": "e2e1-j8-flight",
     "generation": 1,
     "idempotencyKey": "e2e1-j8-flight-1",
     "nodes": [
      {
       "id": "n1",
       "action": {
        "tool": "ensure_host_file",
        "args": {
         "path": ".config/opute-e2e/j8-flight.txt",
         "content": "e2e\n",
         "scope": "user"
        }
       },
       "validate": {
        "tool": "inspect_host_file",
        "args": {
         "path": ".config/opute-e2e/j8-flight.txt",
         "scope": "user"
        },
        "assert": [
         {
          "path": "/exists",
          "op": "eq",
          "value": true
         }
        ]
       }
      },
      {
       "id": "n2",
       "dependsOn": [
        "n1"
       ],
       "action": {
        "tool": "probe_http_endpoint",
        "args": {
         "endpoint": "http://127.0.0.1:8799/"
        }
       }
      }
     ]
    }
   },
   "capture": {
    "FLIGHT": "response.body.result.structuredContent.runId"
   }
  },
  {
   "id": "goInFlight",
   "mcp": "tools/call",
   "tool": "get_host_plan_run",
   "arguments": {
    "runId": "${FLIGHT}"
   },
   "until": {
    "path": "response.body.result.structuredContent.nodes.n2.attempts",
    "in": [
     1
    ]
   },
   "timeout": 30
  },
  {
   "id": "goStop",
   "guest": "systemctl stop opute-bootstrap-mcp.service && python3 /opt/opute-e2e/guest/e2etool.py db /home/opute/.config/opute/instances/standalone/state/state.db"
  },
  {
   "id": "rustInstall",
   "guest": "systemctl stop opute-bootstrap-mcp.service && gzip -dc /opt/opute-e2e/releases/rust/v0.3.0/host-agent-linux-x64.gz > /tmp/oha && install -o opute -g opute -m 0755 /tmp/oha /home/opute/.local/share/opute/opute-host-agent && rm /tmp/oha && sha256sum /home/opute/.local/share/opute/opute-host-agent | cut -c1-64 && systemctl start opute-bootstrap-mcp.service && for i in $(seq 120); do curl -fsS -o /dev/null http://127.0.0.1:3014/health && break; sleep 0.5; done && /home/opute/.local/share/opute/opute-host-agent --version"
  },
  {
   "id": "rustHealth",
   "health": true
  },
  {
   "id": "rustList",
   "mcp": "tools/list"
  },
  {
   "id": "rustDb",
   "guest": "python3 /opt/opute-e2e/guest/e2etool.py db /home/opute/.config/opute/instances/standalone/state/state.db"
  },
  {
   "id": "rustDone",
   "mcp": "tools/call",
   "tool": "get_host_plan_run",
   "arguments": {
    "runId": "${DONE}"
   }
  },
  {
   "id": "rustFlight",
   "mcp": "tools/call",
   "tool": "get_host_plan_run",
   "arguments": {
    "runId": "${FLIGHT}"
   }
  },
  {
   "id": "upgrade",
   "guest": "systemctl stop opute-bootstrap-mcp.service && gzip -dc /opt/opute-e2e/releases/rust-next/host-agent-linux-x64.gz > /tmp/oha && install -o opute -g opute -m 0755 /tmp/oha /home/opute/.local/share/opute/opute-host-agent && rm /tmp/oha && sha256sum /home/opute/.local/share/opute/opute-host-agent | cut -c1-64 && systemctl start opute-bootstrap-mcp.service && for i in $(seq 120); do curl -fsS -o /dev/null http://127.0.0.1:3014/health && break; sleep 0.5; done && /home/opute/.local/share/opute/opute-host-agent --version"
  },
  {
   "id": "nextHealth",
   "health": true
  },
  {
   "id": "nextList",
   "mcp": "tools/list"
  },
  {
   "id": "nextDb",
   "guest": "python3 /opt/opute-e2e/guest/e2etool.py db /home/opute/.config/opute/instances/standalone/state/state.db"
  },
  {
   "id": "nextDone",
   "mcp": "tools/call",
   "tool": "get_host_plan_run",
   "arguments": {
    "runId": "${DONE}"
   }
  },
  {
   "id": "nextFlight",
   "mcp": "tools/call",
   "tool": "get_host_plan_run",
   "arguments": {
    "runId": "${FLIGHT}"
   }
  },
  {
   "id": "slowStop",
   "guest": "python3 /opt/opute-e2e/guest/e2etool.py slow stop"
  }
 ],
 "cleanup": [
  {
   "id": "restoreRust",
   "guest": "systemctl stop opute-bootstrap-mcp.service && gzip -dc /opt/opute-e2e/releases/rust/v0.3.0/host-agent-linux-x64.gz > /tmp/oha && install -o opute -g opute -m 0755 /tmp/oha /home/opute/.local/share/opute/opute-host-agent && rm /tmp/oha && sha256sum /home/opute/.local/share/opute/opute-host-agent | cut -c1-64 && rm -rf /home/opute/.config/opute/instances && mv /tmp/e2e-j8-rust-instances /home/opute/.config/opute/instances && systemctl start opute-bootstrap-mcp.service && for i in $(seq 120); do curl -fsS -o /dev/null http://127.0.0.1:3014/health && break; sleep 0.5; done && rm -rf /home/opute/.config/opute-e2e /opt/opute-e2e/releases/rust-next"
  }
 ],
 "maxMinutes": 20
}
