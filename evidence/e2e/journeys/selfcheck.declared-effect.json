{
 "id": "selfcheck.declared-effect",
 "gate": "e2e-0",
 "description": "Positive control for the effects diff: a declared file change, undone by cleanup, passes.",
 "inputs": {
  "agent": "the dev VM's production-style system unit (opute-bootstrap-mcp.service), test identity e2e-devvm-agent, test bearer token"
 },
 "requirements": [
  {
   "spec": "evidence/e2e/README.md",
   "requirement": "Harness: declared effects pass",
   "pass": [
    {
     "step": "touch",
     "path": "exit",
     "equals": 0
    }
   ]
  }
 ],
 "effects": {
  "allow": [
   "files//etc/opute-e2e-declared-probe"
  ],
  "persist": []
 },
 "steps": [
  {
   "id": "touch",
   "guest": "touch /etc/opute-e2e-declared-probe"
  }
 ],
 "cleanup": [
  {
   "id": "rm",
   "guest": "rm -f /etc/opute-e2e-declared-probe"
  }
 ],
 "maxMinutes": 10
}
