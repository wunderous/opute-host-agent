     "matches": "\n0\\.3\\.0\n$"
    },
    {
     "step": "backDb",
     "path": "json.integrity",
     "equals": "ok"
    },
    {
     "step": "backDb",
     "path": "json.counts",
     "equalsStep": {
      "step": "r4Stop",
      "path": "json.counts"
     }
    },
    {
     "step": "backDb",
     "path": "json.operationIds",
     "equalsStep": {
      "step": "r4Stop",
      "path": "json.operationIds"
     }
    },
    {
     "step": "backDb",
     "path": "json.planRunIds",
     "equalsStep": {
      "step": "r4Stop",
      "path": "json.planRunIds"
     }
    },
    {
     "step": "backGoDone",
     "path": "response.body.result.structuredContent.status",
     "equals": "completed"
    },
    {
     "step": "backR3Plan",
     "path": "response.body.result.structuredContent.status",
     "equals": "completed"
    },
    {
     "step": "backR4Plan",
     "path": "response.body.result.structuredContent.status",
     "equals": "completed"
    },
    {
     "step": "backR4Task",
     "path": "response.body.result.status",
     "equalsStep": {
      "step": "r4Task",
      "path": "response.body.result.status"
     }
    },
    {
     "step": "backR4Tunnel",
     "path": "response.body.result.status",
     "equalsStep": {
      "step": "r4Tunnel",
      "path": "response.body.result.status"
     }
    },
    {
     "step": "backR3Tunnel",
     "path": "response.body.result.status",
     "equalsStep": {
      "step": "r3Tunnel",
      "path": "response.body.result.status"
     }
    },
    {
     "step": "backR4TaskOp",
     "path": "response.body.result.structuredContent.status",
     "equals": "completed"
    },
    {
     "step": "backRead",
     "path": "response.body.result.structuredContent.exists",
     "equals": true
    }
   ],
   "scenario": "0.3.0 started on 0.4.0's state, on the same 0.4.0 unit, reads every operation, task and plan run, 0.4.0-era work included, with the status 0.4.0 last reported"
  },
  {
   "spec": "openspec/changes/platform-neutral-host-agent/specs/platform-neutral-host-agent/spec.md",
   "requirement": "One serving profile",
   "pass": [
    {
     "step": "r3PlanDone",
     "path": "response.body.result.structuredContent.status",
     "equals": "completed"
    },
    {
     "step": "r3Write",
     "path": "response.body.result.isError",
     "in": [
      false,
      "<absent>"
     ]
    },
    {
     "step": "r4PlanDone",
     "path": "response.body.result.structuredContent.status",
     "equals": "completed"
    },
    {
     "step": "r4Write",
     "path": "response.body.result.isError",
     "in": [
      false,
      "<absent>"
     ]
    },
    {
     "step": "backWrite",
     "path": "response.body.result.isError",
     "in": [
      false,
      "<absent>"
     ]
    },
    {
     "step": "r3Task",
     "path": "response.body.result.result.structuredContent.stdout",
     "equals": "r3-era\n"
    },
    {
     "step": "r4Task",
     "path": "response.body.result.result.structuredContent.stdout",
     "equals": "r4-era\n"
    }
   ],
   "scenario": "Each release admits mutations from its unit: 0.3.0 from Go's unit, 0.4.0 from the proposed unit, and 0.3.0 again from the proposed unit after rollback"
  },
  {
   "spec": "openspec/changes/secret-placement/specs/secret-placement/spec.md",
   "requirement": "A file holding a secret is private to the agent's user",
   "pass": [
    {
     "step": "plant",
     "path": "exit",
     "equals": 0
    },
    {
     "step": "r3Relay",
     "path": "response.body.result.structuredContent.ready",
     "equals": true
    },
    {
     "step": "r3Tunnel",
     "path": "response.body.result.status",
     "equals": "completed"
    },
    {
     "step": "r4Tunnel",
     "path": "response.body.result.status",
     "equals": "completed"
    },
    {
     "step": "backTunnel",
     "path": "response.body.result.status",
     "equals": "completed"
    },
    {
     "step": "r3Tunnel",
     "path": "response.body.result.result.content[0].text",
     "matches": "^Error: probe authenticated public MCP endpoint: public MCP endpoint did not become ready within "
    },
    {
     "step": "r4Tunnel",
     "path": "response.body.result.result.content[0].text",
     "matches": "^Error: probe authenticated public MCP endpoint: public MCP endpoint did not become ready within "
    },
    {
     "step": "backTunnel",
     "path": "response.body.result.result.content[0].text",
     "matches": "^Error: probe authenticated public MCP endpoint: public MCP endpoint did not become ready within "
    },
    {
     "step": "connectors",
     "path": "stdout",
     "equals": "1\n"
    },
    {
     "step": "tokenFiles",
     "path": "stdout",
     "equals": "600 opute\n"
    },
    {
     "step": "r3Scan",
     "path": "json.journal",
     "equals": []
    },
    {
     "step": "r3Scan",
     "path": "json.store",
     "equals": []
    },
    {
     "step": "r3Scan",
     "path": "json.looseFiles",
     "equals": []
    },
    {
     "step": "r3Scan",
     "path": "json.strayEnviron",
     "equals": {}
    },
    {
     "step": "r4Scan",
     "path": "json.journal",
     "equals": []
    },
    {
     "step": "r4Scan",
     "path": "json.store",
     "equals": []
    },
    {
     "step": "r4Scan",
     "path": "json.looseFiles",
     "equals": []
    },
    {
     "step": "r4Scan",
     "path": "json.strayEnviron",
     "equals": {}
    },
    {
     "step": "backScan",
     "path": "json.journal",
     "equals": []
    },
    {
     "step": "backScan",
     "path": "json.store",
     "equals": []
    },
    {
     "step": "backScan",
     "path": "json.looseFiles",
     "equals": []
    },
    {
     "step": "backScan",
     "path": "json.strayEnviron",
     "equals": {}
    }
   ],
   "scenario": "The relay's and the user-scoped connector's tokens, written under 0.3.0 and ensured again under 0.4.0 and after rollback onto the same one connector, are in no journal line, no store row and no file that is not 0600 and the agent's user's, and in no process's environment; each connector call proves its origin and stops only at the unreachable public endpoint"
  },
  {
   "spec": "openspec/specs/host-agent-contract/spec.md",
   "requirement": "One exact Host Agent identity",
   "pass": [
    {
     "step": "goHealth",
     "path": "response.body.agentId",
     "equals": "e2e-devvm-agent"
    },
    {
     "step": "r3Health",
     "path": "response.body.agentId",
     "equals": "e2e-devvm-agent"
    },
    {
     "step": "r4Health",
     "path": "response.body.agentId",
     "equals": "e2e-devvm-agent"
    },
    {
     "step": "backHealth",
     "path": "response.body.agentId",
     "equals": "e2e-devvm-agent"
    }
   ]
  }
 ],
 "effects": {
  "allow": [
   "files//home/opute/.local/share/opute/opute-host-agent/sha256",
   "files//home/opute/e2e*",
   "files//home/opute/.config/opute-e2e*",
   "system/units/e2e-slow*",
   "system/unitFiles/e2e-slow*",
   "system/units/opute-host-workload-*",
   "system/units/e2e-*",
   "system/unitFiles/e2e-*",
   "files//home/opute/.config/systemd*",
   "files//home/opute/.config/opute/tunnels*",
   "files//home/opute/.local/share/opute/tunnels*",
   "files//etc/systemd/system/*",
   "files//opt/opute-e2e/chain*",
   "linger",
   "files//var/lib/systemd/linger*",
   "system/units/user*",
   "system/units/run-user-*",
   "user/*"
  ],
  "persist": []
 },
 "steps": [
  {
   "id": "tool",
   "copy": "e2etool",
   "to": "/opt/opute-e2e/guest/e2etool.py"
  },
  {
   "id": "wire",
   "copy": "mcpwire",
   "to": "/opt/opute-e2e/guest/mcpwire.py"
  },
  {
   "id": "sweepTool",
   "copy": "secretsweep",
   "to": "/opt/opute-e2e/guest/secretsweep.py"
  },
  {
   "id": "goUnitCopy",
   "copy": "goUnit",
   "to": "/opt/opute-e2e/chain/go.service"
  },
  {
   "id": "neutralUnitCopy",
   "copy": "proposedUnit",
   "to": "/opt/opute-e2e/chain/proposed.service"
  },
  {
   "id": "rust03Copy",
   "copy": "rust03",
   "to": "/opt/opute-e2e/chain/rust-0.3.x/host-agent-linux-x64.gz"
  },
  {
   "id": "plant",
   "guest": "python3 /opt/opute-e2e/guest/secretsweep.py plant --env /root/e2e-chain/oauth.env --markers /root/e2e-chain/markers.json --set OPUTE_HOST_OAUTH_CLIENT_SECRET=${SECRET:oauthClient} --setting OPUTE_OAUTH_CLIENTS=opute-mcp-host --marker tunnelToken=${SECRET:tunnelToken} --marker incomingToken=${SECRET:relayIn} --marker upstreamToken=${SECRET:relayUp}"
  },
  {
   "id": "aside",
   "guest": "systemctl stop opute-bootstrap-mcp.service && mv /home/opute/.config/opute/instances /tmp/e2e-chain-rust-instances && cp /etc/systemd/system/opute-bootstrap-mcp.service /opt/opute-e2e/chain/vm.service && printf '[Service]\\nEnvironmentFile=/root/e2e-chain/oauth.env\\n' > /etc/systemd/system/opute-bootstrap-mcp.service.d/chain.conf && echo aside"
  },
  {
   "id": "goInstall",
   "guest": "systemctl stop opute-bootstrap-mcp.service && install -m 0644 /opt/opute-e2e/chain/go.service /etc/systemd/system/opute-bootstrap-mcp.service && systemctl daemon-reload && gzip -dc /opt/opute-e2e/releases/go/v0.2.4/host-agent-linux-x64.gz > /tmp/oha && install -o opute -g opute -m 0755 /tmp/oha /home/opute/.local/share/opute/opute-host-agent && rm /tmp/oha && sha256sum /home/opute/.local/share/opute/opute-host-agent | cut -c1-64 && systemctl start opute-bootstrap-mcp.service && for i in $(seq 120); do curl -fsS -o /dev/null http://127.0.0.1:3014/health && break; sleep 0.5; done && /home/opute/.local/share/opute/opute-host-agent --version"
  },
  {
   "id": "goHealth",
   "health": true
  },
  {
   "id": "slow",
   "guest": "python3 /opt/opute-e2e/guest/e2etool.py slow start --port 8799 --delay 60"
  },
  {
   "id": "goDone",
   "mcp": "tools/call",
   "tool": "run_host_plan",
   "arguments": {
    "plan": {
     "contractVersion": "host-plan.v1",
     "planId": "e2e-chain-go",
     "generation": 1,
     "idempotencyKey": "e2e-chain-go-1",
     "nodes": [
      {
       "id": "n1",
       "action": {
        "tool": "ensure_host_file",
        "args": {
         "path": ".config/opute-e2e/go.txt",
         "content": "e2e\n",
         "scope": "user"
        }
       },
       "validate": {
        "tool": "inspect_host_file",
        "args": {
         "path": ".config/opute-e2e/go.txt",
         "scope": "user"
        },
        "assert": [
         {
          "path": "/exists",
          "op": "eq",
          "value": true
         }
        ]
       }
      }
     ]
    }
   },
   "capture": {
    "GO_DONE": "response.body.result.structuredContent.runId"
   },
   "retryOn": [
    "host_capacity_saturated"
   ]
  },
  {
   "id": "goDoneWait",
   "mcp": "tools/call",
   "tool": "get_host_plan_run",
   "arguments": {
    "runId": "${GO_DONE}"
   },
   "until": {
    "path": "response.body.result.structuredContent.status",
    "in": [
     "completed",
     "failed",
     "cancelled"
    ]
   },
   "timeout": 90,
   "retryOn": [
    "host_capacity_saturated"
   ]
  },
  {
   "id": "goFlight",
   "mcp": "tools/call",
   "tool": "run_host_plan",
   "arguments": {
    "plan": {
     "contractVersion": "host-plan.v1",
     "planId": "e2e-chain-flight",
     "generation": 1,
     "idempotencyKey": "e2e-chain-flight-1",
     "nodes": [
      {
       "id": "n1",
       "action": {
        "tool": "ensure_host_file",
        "args": {
         "path": ".config/opute-e2e/flight.txt",
         "content": "e2e\n",
         "scope": "user"
        }
       },
       "validate": {
        "tool": "inspect_host_file",
        "args": {
         "path": ".config/opute-e2e/flight.txt",
         "scope": "user"
        },
        "assert": [
         {
          "path": "/exists",
          "op": "eq",
          "value": true
         }
        ]
       }
      },
      {
       "id": "n2",
       "dependsOn": [
        "n1"
       ],
       "action": {
        "tool": "probe_http_endpoint",
        "args": {
         "endpoint": "http://127.0.0.1:8799/"
        }
       }
      }
     ]
    }
   },
   "capture": {
    "GO_FLIGHT": "response.body.result.structuredContent.runId"
   },
   "retryOn": [
    "host_capacity_saturated"
   ]
  },
  {
   "id": "goInFlight",
   "mcp": "tools/call",
   "tool": "get_host_plan_run",
   "arguments": {
    "runId": "${GO_FLIGHT}"
   },
   "until": {
    "path": "response.body.result.structuredContent.nodes.n2.attempts",
    "in": [
     1
    ]
   },
   "timeout": 30,
   "retryOn": [
    "host_capacity_saturated"
   ]
  },
  {
   "id": "goStop",
   "guest": "systemctl stop opute-bootstrap-mcp.service && python3 /opt/opute-e2e/guest/e2etool.py db /home/opute/.config/opute/instances/standalone/state/state.db"
  },
  {
   "id": "slowStop",
   "guest": "python3 /opt/opute-e2e/guest/e2etool.py slow stop"
  },
  {
   "id": "r3Install",
   "guest": "systemctl stop opute-bootstrap-mcp.service && install -m 0644 /opt/opute-e2e/chain/go.service /etc/systemd/system/opute-bootstrap-mcp.service && systemctl daemon-reload && gzip -dc /opt/opute-e2e/chain/rust-0.3.x/host-agent-linux-x64.gz > /tmp/oha && install -o opute -g opute -m 0755 /tmp/oha /home/opute/.local/share/opute/opute-host-agent && rm /tmp/oha && sha256sum /home/opute/.local/share/opute/opute-host-agent | cut -c1-64 && systemctl start opute-bootstrap-mcp.service && for i in $(seq 120); do curl -fsS -o /dev/null http://127.0.0.1:3014/health && break; sleep 0.5; done && /home/opute/.local/share/opute/opute-host-agent --version"
  },
  {
   "id": "r3Health",
   "health": true
  },
  {
   "id": "r3Db",
   "guest": "python3 /opt/opute-e2e/guest/e2etool.py db /home/opute/.config/opute/instances/standalone/state/state.db"
  },
  {
   "id": "r3GoDone",
