{
 "id": "e2e4.upgrade-chain",
 "gate": "e2e-4",
 "description": "The release path (m21): the host is reinstalled as Go v0.2.4 on Go's unit and leaves a run in flight; the previous Rust release (0.3.0) takes over on the same unit and state and installs an LLM relay and a user-scoped public MCP connector with marked tokens; the 0.4.0 candidate takes over on the proposed 0.4.0 unit and does more work; then 0.3.0 is rolled back onto the same 0.4.0 unit. Each step reads the previous binary's records back and searches the host for the tokens.",
 "inputs": {
  "agent": "the dev VM's production-style system unit opute-bootstrap-mcp.service (Rust 0.4.0 release candidate binary, test identity e2e-devvm-agent, test token)",
  "go": "/opt/opute-e2e/releases/go/v0.2.4 (published Go v0.2.4 release, SHA256SUMS pinned)",
  "previous": "the previous Rust release (${PARITY}/e2e/release/rust-0.3.0-rc7), copied in",
  "slow": "a local endpoint answering after 60 s (e2etool slow)",
  "files": {
   "e2etool": {
    "path": "${REPO}/evidence/e2e/guest-tools/e2etool.py",
    "sha256": "41b6bbf3b75c8d8a0dcb52b2bfe3f4f465bf70c7cdb755a9d2ae60cfded464d9"
   },
   "mcpwire": {
    "path": "${REPO}/evidence/e2e/mcpwire.py",
    "sha256": "ab7a4bbac670918d7ab10f31ad5f157998404c8548b5c3ec974cae7aec0ab4fc"
   },
   "secretsweep": {
    "path": "${REPO}/evidence/e2e/guest-tools/secretsweep.py",
    "sha256": "46fa086d70bb5eda4af463477fb9001568d76d7bfe4377ef448444ec52891fe6"
   },
   "goUnit": {
    "path": "${PARITY}/go-src/deploy/opute-bootstrap-mcp.service",
    "sha256": "02246cf65d446b7bdd1dfaa62e7652ff7583e36b61a872d33835ed5799d3c3e5"
   },
   "proposedUnit": {
    "path": "${REPO}/evidence/cutover/proposed-0.4.0/opute-bootstrap-mcp.service",
    "sha256": "8ade0e7e59673216ba4e5f283dacbe707a30075b32ee5b6127fb590281622a3f"
   },
   "rust03": {
    "path": "${PARITY}/e2e/release/rust-0.3.0-rc7/host-agent-linux-x64.gz",
    "sha256": "a8443363f9284f75be74adbb5499e978ab01c5363fb0acdc8258877d0b8f3da7"
   }
  }
 },
 "requirements": [
  {
   "spec": "openspec/changes/reimplement-host-agent-in-rust/milestones.md M12 (forward and rollback: Go rolled back onto Rust's state reports every task, Rust-era work included, with the status Rust last reported) and D1 (bit-compatible schema: conversion is the identity)",
   "requirement": "Forward: each release serves the previous release's state unchanged",
   "pass": [
    {
     "step": "aside",
     "path": "exit",
     "equals": 0
    },
    {
     "step": "goInstall",
     "path": "stdout",
     "matches": "\n0\\.2\\.4\n$"
    },
    {
     "step": "goDoneWait",
     "path": "response.body.result.structuredContent.status",
     "equals": "completed"
    },
    {
     "step": "goInFlight",
     "path": "response.body.result.structuredContent.nodes.n2.attempts",
     "equals": 1
    },
    {
     "step": "goStop",
     "path": "json.integrity",
     "equals": "ok"
    },
    {
     "step": "r3Install",
     "path": "stdout",
     "matches": "\n0\\.3\\.0\n$"
    },
    {
     "step": "r3Db",
     "path": "json.integrity",
     "equals": "ok"
    },
    {
     "step": "r3Db",
     "path": "json.counts",
     "equalsStep": {
      "step": "goStop",
      "path": "json.counts"
     }
    },
    {
     "step": "r3Db",
     "path": "json.operationIds",
     "equalsStep": {
      "step": "goStop",
      "path": "json.operationIds"
     }
    },
    {
     "step": "r3Db",
     "path": "json.planRunIds",
     "equalsStep": {
      "step": "goStop",
      "path": "json.planRunIds"
     }
    },
    {
     "step": "r3GoDone",
     "path": "response.body.result.structuredContent.status",
     "equals": "completed"
    },
    {
     "step": "r3GoFlight",
     "path": "response.body.result.structuredContent.status",
     "equals": "cancelled"
    },
    {
     "step": "r4Install",
     "path": "stdout",
     "matches": "\n0\\.4\\.0\n$"
    },
    {
     "step": "r4Db",
     "path": "json.integrity",
     "equals": "ok"
    },
    {
     "step": "r4Db",
     "path": "json.counts",
     "equalsStep": {
      "step": "r3Stop",
      "path": "json.counts"
     }
    },
    {
     "step": "r4Db",
     "path": "json.operationIds",
     "equalsStep": {
      "step": "r3Stop",
      "path": "json.operationIds"
     }
    },
    {
     "step": "r4Db",
     "path": "json.planRunIds",
     "equalsStep": {
      "step": "r3Stop",
      "path": "json.planRunIds"
     }
    },
    {
     "step": "r4GoDone",
     "path": "response.body.result.structuredContent.status",
     "equals": "completed"
    },
    {
     "step": "r4GoFlight",
     "path": "response.body.result.structuredContent.status",
     "equals": "cancelled"
    },
    {
     "step": "r4R3Plan",
     "path": "response.body.result.structuredContent.status",
     "equals": "completed"
    },
    {
     "step": "r4R3Task",
     "path": "response.body.result.status",
     "equalsStep": {
      "step": "r3Task",
      "path": "response.body.result.status"
     }
    },
    {
     "step": "r4R3Tunnel",
     "path": "response.body.result.status",
     "equalsStep": {
      "step": "r3Tunnel",
      "path": "response.body.result.status"
     }
    },
    {
     "step": "r4R3TaskOp",
     "path": "response.body.result.structuredContent.status",
     "equals": "completed"
    },
    {
     "step": "r4Read",
     "path": "response.body.result.structuredContent.exists",
     "equals": true
    }
   ],
   "scenario": "Go v0.2.4's state, with a run stopped in flight, is served by 0.3.0; 0.3.0's state, with its relay, connector, plan and task, is served by 0.4.0: counts and ids reconcile per table and every record reads back with the status last reported"
  },
  {
   "spec": "openspec/changes/reimplement-host-agent-in-rust/milestones.md M12 (forward and rollback: Go rolled back onto Rust's state reports every task, Rust-era work included, with the status Rust last reported) and D1 (bit-compatible schema: conversion is the identity)",
   "requirement": "Rollback: 0.3.0 serves 0.4.0's state unchanged",
