  "persist": []
 },
 "steps": [
  {
   "id": "tool",
   "copy": "e2etool",
   "to": "/opt/opute-e2e/guest/e2etool.py"
  },
  {
   "id": "wire",
   "copy": "mcpwire",
   "to": "/opt/opute-e2e/guest/mcpwire.py"
  },
  {
   "id": "providerCopy",
   "copy": "providerK3s",
   "to": "/opt/opute-e2e/providers/opute-provider-k3s",
   "mode": "0755"
  },
  {
   "id": "recipeCopy",
   "copy": "activate",
   "to": "/home/opute/.config/opute-e2e/k3s-activate.yaml",
   "mode": "0644"
  },
  {
   "id": "setup",
   "guest": "chown -R opute /home/opute/.config/opute-e2e && for p in 4320:e2e-provider-k3s 4321:e2e-provider-k3s-b; do systemd-run --collect --unit=${p#*:} --uid=opute --gid=opute --setenv=HOME=/home/opute --setenv=OPUTE_PROVIDER_PORT=${p%%:*} --property=Restart=no /opt/opute-e2e/providers/opute-provider-k3s || exit 1; done && python3 /opt/opute-e2e/guest/e2etool.py agent start b --port 3031 --id e2e-ha-b --env OPUTE_STANDALONE_ALLOW_MUTATIONS=true --env MCP_AUTH_TOKEN='${SECRET:tokenB}' >/dev/null && for i in $(seq 60); do ss -ltnH 'sport = :4320' | grep -q . && ss -ltnH 'sport = :4321' | grep -q . && break; sleep 0.5; done; ss -ltnH '( sport = :4320 or sport = :4321 )' | wc -l"
  },
  {
   "id": "catalogB",
   "mcp": "tools/list",
   "port": 3031,
   "auth": "secret:tokenB"
  },
  {
   "id": "installA",
   "mcp": "tools/call",
   "tool": "opute.provider.install",
   "arguments": {
    "descriptor": {
     "schema": "opute-provider-plugin.v1",
     "pluginId": "com.opute.k3s",
     "version": "1.0.2",
     "capabilities": [
      {
       "id": "opute.capability.kubernetes.v1",
       "version": 1
      }
     ],
     "server": {
      "transport": "streamable_http",
      "endpoint": "http://127.0.0.1:4320/mcp"
     }
    },
    "activate": true,
    "recipeSource": "/home/opute/.config/opute-e2e/k3s-activate.yaml"
   }
  },
  {
   "id": "installB",
   "mcp": "tools/call",
   "tool": "opute.provider.install",
   "arguments": {
    "descriptor": {
     "schema": "opute-provider-plugin.v1",
     "pluginId": "com.opute.k3s",
     "version": "1.0.2",
     "capabilities": [
      {
       "id": "opute.capability.kubernetes.v1",
       "version": 1
      }
     ],
     "server": {
      "transport": "streamable_http",
      "endpoint": "http://127.0.0.1:4321/mcp"
     }
    },
    "activate": true,
    "recipeSource": "/home/opute/.config/opute-e2e/k3s-activate.yaml"
   },
   "port": 3031,
   "auth": "secret:tokenB"
  },
  {
   "id": "providerToolsA",
   "guest": "python3 -c 'import sys, time, json; sys.path.insert(0, \"/opt/opute-e2e/guest\"); import mcpwire\nfor i in range(120):\n    r = mcpwire.mcp(3014, sys.argv[1], \"tools/list\", request_id=i + 1)\n    names = [t[\"name\"] for t in ((r.get(\"body\") or {}).get(\"result\") or {}).get(\"tools\") or []]\n    if \"opute.capability.kubernetes.provision\" in names: break\n    time.sleep(0.5)\nprint(json.dumps({\"listed\": \"opute.capability.kubernetes.provision\" in names, \"tools\": len(names), \"polls\": i + 1}))' '${TOKEN}'"
  },
  {
   "id": "providerToolsB",
   "guest": "python3 -c 'import sys, time, json; sys.path.insert(0, \"/opt/opute-e2e/guest\"); import mcpwire\nfor i in range(120):\n    r = mcpwire.mcp(3031, sys.argv[1], \"tools/list\", request_id=i + 1)\n    names = [t[\"name\"] for t in ((r.get(\"body\") or {}).get(\"result\") or {}).get(\"tools\") or []]\n    if \"opute.capability.kubernetes.provision\" in names: break\n    time.sleep(0.5)\nprint(json.dumps({\"listed\": \"opute.capability.kubernetes.provision\" in names, \"tools\": len(names), \"polls\": i + 1}))' '${SECRET:tokenB}'"
  },
  {
   "id": "catalogAfterA",
   "mcp": "tools/list"
  },
  {
   "id": "catalogAfterB",
   "mcp": "tools/list",
   "port": 3031,
   "auth": "secret:tokenB"
  },
  {
   "id": "catalogA",
   "mcp": "tools/call",
   "tool": "opute.capability.kubernetes.validate",
   "arguments": {}
  },
  {
   "id": "vm1Call",
   "mcp": "tools/call",
   "tool": "provision_vm",
   "arguments": {
    "name": "e2e-k1",
    "image": "parity-noble",
    "instanceType": "container",
    "cpus": 2,
    "memory": "3GiB",
    "disk": "15GiB"
   },
   "meta": {
    "io.modelcontextprotocol/clientCapabilities": {
     "extensions": {
      "io.modelcontextprotocol/tasks": {}
     }
    }
   },
   "capture": {
    "TID_vm1": "response.body.result.taskId"
