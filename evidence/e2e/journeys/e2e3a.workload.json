 "effects": {
  "allow": [
   "incus/instances/e2e-k*",
   "incus/volumes/*",
   "incus/storage/default/used_by*",
   "incus/profiles/default/used_by*",
   "incus/networks/incusbr0/used_by*",
   "files//home/opute/.config/opute-e2e*",
   "files//home/opute/.config/incus*",
   "files//opt/opute-e2e/providers*",
   "system/units/e2e-*",
