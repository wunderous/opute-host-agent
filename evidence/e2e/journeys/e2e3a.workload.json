   "e2etool": {
    "path": "${REPO}/evidence/e2e/guest-tools/e2etool.py",
    "sha256": "074214c3b4ca317c3b9c11335908f346f27e6278f50095f0eb6a290bbd399826"
   },
   "mcpwire": {
    "path": "${REPO}/evidence/e2e/mcpwire.py",
    "sha256": "ab7a4bbac670918d7ab10f31ad5f157998404c8548b5c3ec974cae7aec0ab4fc"
   },
   "providerK3s": {
    "path": "${PARITY}/e2e/release/rust-e2e13a/opute-provider-k3s-linux-x64",
    "sha256": "ce25706303f50cfbc3f1e5c1deb984d1d6f940def2b7677240e645fcc18551bb"
   },
   "activate": {
    "path": "${REPO}/evidence/e2e/journeys/inputs/k3s-activate.yaml",
    "sha256": "91f0b596492e3c72fb5eacba4c14c6141e7da584eebfa88bc4ffbc72573c7788"
   }
  }
 },
