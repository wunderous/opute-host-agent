{
 "id": "e2e6.child-env",
 "gate": "e2e-6",
 "description": "A child's environment (D40): an agent holding its bearer, two provider credentials and an OPUTE_ setting opens a VM console and runs a recipe step; /proc shows neither child holds any of them.",
 "inputs": {
  "agent": "transient Rust agents of the installed release candidate (0.4.0) under /tmp/e2e-agents",
  "files": {
   "e2etool": {
    "path": "${REPO}/evidence/e2e/guest-tools/e2etool.py",
    "sha256": "41b6bbf3b75c8d8a0dcb52b2bfe3f4f465bf70c7cdb755a9d2ae60cfded464d9"
   },
   "mcpwire": {
    "path": "${REPO}/evidence/e2e/mcpwire.py",
    "sha256": "ab7a4bbac670918d7ab10f31ad5f157998404c8548b5c3ec974cae7aec0ab4fc"
   },
   "recipe": {
    "path": "${REPO}/evidence/e2e/journeys/inputs/e2e-child-env-recipe.yaml",
    "sha256": "487b12955bdfdc82edb6855451162dc1273ab254de341cf79ff58e3d1ca3a913"
   }
  }
 },
 "requirements": [
  {
   "spec": "openspec/changes/child-process-environment/specs/child-process-environment/spec.md",
   "requirement": "A child process never receives the agent's secrets",
   "pass": [
    {
     "step": "vm",
     "path": "response.body.result.status",
     "equals": "completed"
    },
    {
     "step": "console",
     "path": "response.body.result.structuredContent.status",
     "equals": "started"
    },
    {
     "step": "consoleEnv",
     "path": "json.agentHasExpected",
     "equals": true
    },
    {
     "step": "consoleEnv",
     "path": "json.found",
     "gte": 1
    },
    {
     "step": "consoleEnv",
     "path": "json.leaked",
     "equals": []
    },
    {
     "step": "consoleEnv",
     "path": "json.childrenKeep",
     "equals": true
    }
   ],
   "scenario": "With the bearer, two provider credentials and an OPUTE_ setting in the agent's environment, its incus console process holds PATH and none of them"
  },
  {
   "spec": "openspec/changes/child-process-environment/specs/child-process-environment/spec.md",
   "requirement": "A child process never receives the agent's secrets",
   "pass": [
    {
     "step": "recipeEnv",
     "path": "json.agentHasExpected",
     "equals": true
    },
    {
     "step": "recipeEnv",
     "path": "json.found",
     "gte": 1
    },
    {
     "step": "recipeEnv",
     "path": "json.leaked",
     "equals": []
    },
    {
     "step": "recipeEnv",
     "path": "json.childrenKeep",
     "equals": true
    },
    {
     "step": "recipeDone",
     "path": "response.body.result.structuredContent.status",
     "equals": "completed"
    }
   ],
   "scenario": "While a recipe step's run_host_command workload runs, the systemd-run client the agent started for it holds PATH and none of the agent's secrets"
  }
 ],
 "effects": {
  "allow": [
   "system/units/e2e-agent-*",
   "system/unitFiles/e2e-agent-*",
   "system/units/e2e-slow*",
   "system/unitFiles/e2e-slow*",
   "system/units/tmp-e2e*agents-*.mount",
   "incus/*",
   "files//home/opute/.config/incus*",
   "system/units/sys-devices-virtual-net-tap*",
   "system/units/sys-subsystem-net-devices-tap*",
   "system/units/var-lib-incus-devices-*"
  ],
  "persist": []
 },
 "steps": [
  {
   "id": "tool",
   "copy": "e2etool",
   "to": "/opt/opute-e2e/guest/e2etool.py"
  },
  {
   "id": "wire",
   "copy": "mcpwire",
   "to": "/opt/opute-e2e/guest/mcpwire.py"
  },
  {
   "id": "cenvAgent",
   "guest": "python3 /opt/opute-e2e/guest/e2etool.py agent start cenv --port 3050 --id e2e-cenv-agent --env MCP_AUTH_TOKEN=${SECRET:cenv} --env OPUTE_STANDALONE_ALLOW_MUTATIONS=true --env CLOUDFLARE_API_TOKEN=${SECRET:cfToken} --env TAILSCALE_AUTH_KEY=${SECRET:tsKey} --env OPUTE_E2E_MARKER=e2e-marker --user root"
  },
  {
   "id": "list",
   "mcp": "tools/list",
   "port": 3050,
   "auth": "secret:cenv"
  },
  {
   "id": "vmCall",
   "mcp": "tools/call",
   "tool": "provision_vm",
   "arguments": {
    "name": "e2e-v6",
    "instanceType": "virtual-machine",
    "image": "parity-noble-vm",
    "cpus": 1,
    "memory": "1GiB",
    "disk": "10GiB"
   },
   "meta": {
    "io.modelcontextprotocol/clientCapabilities": {
     "extensions": {
      "io.modelcontextprotocol/tasks": {}
     }
    }
   },
   "port": 3050,
   "auth": "secret:cenv",
   "capture": {
    "VM": "response.body.result.taskId"
   }
  },
  {
   "id": "vm",
   "mcp": "tasks/get",
   "params": {
    "taskId": "${VM}"
   },
   "meta": {
    "io.modelcontextprotocol/clientCapabilities": {
     "extensions": {
      "io.modelcontextprotocol/tasks": {}
     }
    }
   },
   "port": 3050,
   "auth": "secret:cenv",
   "until": {
    "path": "response.body.result.status",
    "in": [
     "completed",
     "failed",
     "cancelled"
    ]
   },
   "timeout": 900,
   "interval": 3
  },
  {
   "id": "console",
   "mcp": "tools/call",
   "tool": "stream_vm_console",
   "arguments": {
    "uri": "vm:local:e2e-v6"
   },
   "port": 3050,
   "auth": "secret:cenv"
  },
  {
   "id": "consoleEnv",
   "guest": "python3 /opt/opute-e2e/guest/e2etool.py childenv e2e-agent-cenv.service 'console e2e-v6' --expect MCP_AUTH_TOKEN --expect CLOUDFLARE_API_TOKEN --expect TAILSCALE_AUTH_KEY --expect OPUTE_E2E_MARKER --keep PATH"
  },
  {
   "id": "ctrlA",
   "mcp": "tools/call",
   "tool": "send_console_input",
   "arguments": {
    "operationId": "console-e2e-v6",
    "data": "\u0001"
   },
   "port": 3050,
   "auth": "secret:cenv"
  },
  {
   "id": "detach",
   "mcp": "tools/call",
   "tool": "send_console_input",
   "arguments": {
    "operationId": "console-e2e-v6",
    "data": "q"
   },
   "port": 3050,
   "auth": "secret:cenv"
  },
  {
   "id": "recipeCopy",
   "copy": "recipe",
   "to": "/tmp/e2e-agents/child-env-recipe.yaml",
   "mode": "0644"
  },
  {
   "id": "recipeRun",
   "mcp": "tools/call",
   "tool": "run_host_local_recipe",
   "arguments": {
    "source": "/tmp/e2e-agents/child-env-recipe.yaml"
   },
   "port": 3050,
   "auth": "secret:cenv",
   "capture": {
    "RRUN": "response.body.result.structuredContent.runId"
   }
  },
  {
   "id": "recipeEnv",
   "guest": "for i in $(seq 40); do out=$(python3 /opt/opute-e2e/guest/e2etool.py childenv e2e-agent-cenv.service 'systemd-run' --expect MCP_AUTH_TOKEN --expect CLOUDFLARE_API_TOKEN --expect TAILSCALE_AUTH_KEY --expect OPUTE_E2E_MARKER --keep PATH); echo \"$out\" | grep -q '\"found\": [1-9]' && break; sleep 1; done; echo \"$out\""
  },
  {
   "id": "recipeDone",
   "mcp": "tools/call",
   "tool": "get_host_plan_run",
   "arguments": {
    "runId": "${RRUN}"
   },
   "until": {
    "path": "response.body.result.structuredContent.status",
    "in": [
     "completed",
     "failed",
     "cancelled"
    ]
   },
   "timeout": 120,
   "port": 3050,
   "auth": "secret:cenv"
  }
 ],
 "cleanup": [
  {
   "id": "cleanVm",
   "guest": "incus delete -f e2e-v6 2>/dev/null; rm -f /tmp/e2e-agents/child-env-recipe.yaml; incus storage volume list default -f csv | awk -F, '$1==\"image\"{print $2}' | xargs -r -I{} incus storage volume delete default image/{}; true"
  },
  {
   "id": "remove",
   "guest": "python3 /opt/opute-e2e/guest/e2etool.py agent remove cenv >/dev/null ; true"
  }
 ],
 "maxMinutes": 20
}
