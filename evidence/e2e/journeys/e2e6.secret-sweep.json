{
 "id": "e2e6.secret-sweep",
 "gate": "e2e-6",
 "description": "Where each secret goes (m19): an agent holding a marker per secret class runs the OAuth grant, an LLM relay, a host cluster agent install and a public MCP connector; argv (strace of its tree, bpftrace of the host), every process's environment, the journal, the store, files under the host's writable roots and every response are searched for each marker, raw and base64-encoded.",
 "inputs": {
  "agent": "transient Rust agents of the installed release candidate (0.3.0) under /tmp/e2e-agents",
  "files": {
   "e2etool": {
    "path": "${REPO}/evidence/e2e/guest-tools/e2etool.py",
    "sha256": "85577be61795ea2275b1c8e4b8196d2202642e81b84b829da7b5288779d3eb7f"
   },
   "mcpwire": {
    "path": "${REPO}/evidence/e2e/mcpwire.py",
    "sha256": "ab7a4bbac670918d7ab10f31ad5f157998404c8548b5c3ec974cae7aec0ab4fc"
   },
   "secretsweep": {
    "path": "${REPO}/evidence/e2e/guest-tools/secretsweep.py",
    "sha256": "07ee2a7797432c347e4587df587f1291b4e7899c3bb775ee03fb1c077eb59a0f"
   }
  }
 },
 "requirements": [
  {
   "spec": "openspec/changes/secret-placement/specs/secret-placement/spec.md",
   "requirement": "A secret never travels on a command line",
   "pass": [
    {
     "step": "plant",
     "path": "exit",
     "equals": 0
    },
    {
     "step": "sweepAgent",
     "path": "exit",
     "equals": 0
    },
    {
     "step": "watch",
     "path": "json.strace",
     "equals": true
    },
    {
     "step": "watch",
     "path": "json.bpftrace",
     "equals": true
    },
    {
     "step": "bridge",
     "path": "json.serving",
     "equals": true
    },
    {
     "step": "oauth",
     "path": "json.issued",
     "equals": true
    },
    {
     "step": "oauth",
     "path": "json.listed",
     "equals": true
    },
    {
     "step": "relay",
     "path": "response.body.result.structuredContent.ready",
     "equals": true
    },
    {
     "step": "cluster",
     "path": "response.body.result.status",
     "equals": "completed"
    },
    {
     "step": "cluster",
     "path": "response.body.result.result.isError",
     "in": [
      false,
      "<absent>"
     ]
    },
    {
     "step": "relayListens",
     "path": "stdout",
     "equals": "1\n"
    },
    {
     "step": "clusterAgent",
     "path": "stdout",
     "equals": "active\n"
    },
    {
     "step": "tunnel",
     "path": "response.body.result.status",
     "in": [
      "completed",
      "failed"
     ]
    },
    {
     "step": "tunnel",
     "path": "response.body.result.result.isError",
     "equals": true
    },
    {
     "step": "tunnel",
     "path": "response.body.result.result.content[0].text",
     "matches": "^Error: probe authenticated public MCP endpoint: public MCP endpoint did not become ready within .*e2e-sweep\\.invalid"
    },
    {
     "step": "connectorRan",
     "path": "stdout",
     "matches": "^[1-9][0-9]*\n$"
    },
    {
     "step": "connectorToken",
     "path": "stdout",
     "matches": "^[1-9][0-9]*\n$"
    },
    {
     "step": "scan",
     "path": "json.execsTraced",
     "gte": 1
    },
    {
     "step": "scan",
     "path": "json.argv",
     "equals": {}
    }
   ],
   "scenario": "An agent holding its bearer, an OAuth client secret and three provider credentials issues an OAuth token, starts an LLM relay, installs a host cluster agent and a public MCP connector; no process on the host carries any of them, or the tool inputs' tokens, in its arguments"
  },
  {
   "spec": "openspec/changes/secret-placement/specs/secret-placement/spec.md",
   "requirement": "A file holding a secret is private to the agent's user",
   "pass": [
    {
     "step": "markProvider",
     "path": "json.mode",
     "equals": "0o600"
    },
    {
     "step": "markProvider",
     "path": "json.uid",
     "equals": 0
    },
    {
     "step": "scan",
     "path": "json.looseFiles",
     "equals": []
    }
   ],
   "scenario": "Every file under /etc, /opt, /tmp, /var/tmp, /home, /root, /run, /usr/local and /srv that holds a secret, raw or base64-encoded, is 0600 or stricter and owned by the agent's user"
  },
  {
   "spec": "openspec/changes/secret-placement/specs/secret-placement/spec.md",
   "requirement": "Logs, the store and responses carry a secret only redacted",
   "pass": [
    {
     "step": "scan",
     "path": "json.journal",
     "equals": []
    },
    {
     "step": "scan",
     "path": "json.store",
     "equals": []
    },
    {
     "step": "list",
     "path": "response.body",
     "excludes": "<secret:"
    },
    {
     "step": "relay",
     "path": "response.body",
     "excludes": "<secret:"
    },
    {
     "step": "clusterCall",
     "path": "response.body",
     "excludes": "<secret:"
    },
    {
     "step": "cluster",
     "path": "response.body",
     "excludes": "<secret:"
    },
    {
     "step": "tunnelCall",
     "path": "response.body",
     "excludes": "<secret:"
    },
    {
     "step": "tunnel",
     "path": "response.body",
     "excludes": "<secret:"
    }
   ],
   "scenario": "The journal, the agent's state directory and every MCP response hold no secret"
  },
  {
   "spec": "openspec/changes/child-process-environment/specs/child-process-environment/spec.md",
   "requirement": "A child process never receives the agent's secrets",
   "pass": [
    {
     "step": "scan",
     "path": "json.strayEnviron",
     "equals": {}
    }
   ],
   "scenario": "After the calls, only the agent's own process holds its secrets in its environment"
  }
 ],
 "effects": {
  "allow": [
   "files//etc/opute/cluster-agent.json",
   "files//etc/opute/tunnels",
   "files//etc/opute/tunnels/e2e-sweep.env",
   "files//etc/systemd/system/multi-user.target.wants/opute-cloudflared-e2e-sweep.service",
   "files//etc/systemd/system/multi-user.target.wants/opute-cluster-agent.service",
   "files//etc/systemd/system/opute-cloudflared-e2e-sweep.service",
   "files//etc/systemd/system/opute-cluster-agent.service",
   "files//opt/opute",
   "files//opt/opute/tunnels",
   "files//opt/opute/tunnels/e2e-sweep",
   "files//opt/opute/tunnels/e2e-sweep/cloudflared",
   "files//usr/local/lib/opute",
   "files//usr/local/lib/opute/cluster-agent",
   "system/units/sys-kernel-debug-tracing.mount",
   "system/units/e2e-sweep-bridge.service",
   "system/unitFiles/e2e-sweep-bridge.service",
   "system/units/e2e-sweep-sweep.service",
   "system/unitFiles/e2e-sweep-sweep.service",
   "system/units/opute-cloudflared-e2e-sweep.service",
   "system/unitFiles/opute-cloudflared-e2e-sweep.service",
   "system/units/opute-cluster-agent.service",
   "system/unitFiles/opute-cluster-agent.service",
   "files//root/e2e-sweep*",
   "files//tmp/e2e-agents",
   "files//tmp/e2e-agents/sweep*",
   "mounts//sys/kernel/debug/tracing tracefs",
   "processes//system.slice/e2e-sweep-bridge.service python3",
   "processes//system.slice/e2e-sweep-sweep.service opute-host-agen",
   "processes//system.slice/opute-cluster-agent.service sleep",
   "sockets/tcp 127.0.0.1:3056 opute-host-agen",
   "sockets/tcp 127.0.0.1:3057 python3",
   "sockets/tcp 127.0.0.1:3058 opute-host-agen"
  ],
  "persist": []
 },
 "steps": [
  {
   "id": "tool",
   "copy": "e2etool",
   "to": "/opt/opute-e2e/guest/e2etool.py"
  },
  {
   "id": "wire",
   "copy": "mcpwire",
   "to": "/opt/opute-e2e/guest/mcpwire.py"
  },
  {
   "id": "sweepTool",
   "copy": "secretsweep",
   "to": "/opt/opute-e2e/guest/secretsweep.py"
  },
  {
   "id": "plant",
   "guest": "python3 /opt/opute-e2e/guest/secretsweep.py plant --env /root/e2e-sweep/agent.env --markers /root/e2e-sweep/markers.json --set MCP_AUTH_TOKEN=${SECRET:sweep} --set OPUTE_HOST_OAUTH_CLIENT_SECRET=${SECRET:oauthClient} --set CLOUDFLARE_API_TOKEN=${SECRET:cfToken} --set TAILSCALE_AUTH_KEY=${SECRET:tsKey} --set TAILSCALE_API_KEY=${SECRET:tsApi} --setting OPUTE_REMOTE_AGENT_ID=e2e-sweep-agent --setting OPUTE_STANDALONE_ALLOW_MUTATIONS=true --marker tunnelToken=${SECRET:tunnelToken} --marker bridgeToken=${SECRET:bridgeToken} --marker incomingToken=${SECRET:relayIn} --marker upstreamToken=${SECRET:relayUp}"
  },
  {
   "id": "sweepAgent",
   "guest": "python3 /opt/opute-e2e/guest/secretsweep.py agent start sweep --port 3056 --env /root/e2e-sweep/agent.env"
  },
  {
   "id": "markProvider",
   "guest": "python3 /opt/opute-e2e/guest/secretsweep.py mark --credential /tmp/e2e-agents/sweep/state/credentials/host-agent-provider.json --as providerSecret --markers /root/e2e-sweep/markers.json"
  },
  {
   "id": "watch",
   "guest": "python3 /opt/opute-e2e/guest/secretsweep.py watch start --unit e2e-sweep-sweep.service"
  },
  {
   "id": "bridge",
   "guest": "python3 /opt/opute-e2e/guest/secretsweep.py bridge start --port 3057"
  },
  {
   "id": "list",
   "mcp": "tools/list",
   "port": 3056,
   "auth": "secret:sweep"
  },
  {
   "id": "oauth",
   "guest": "python3 /opt/opute-e2e/guest/secretsweep.py oauth --port 3056 --client opute-mcp-host --secret OPUTE_HOST_OAUTH_CLIENT_SECRET --as accessToken --markers /root/e2e-sweep/markers.json"
  },
  {
   "id": "relay",
   "mcp": "tools/call",
   "tool": "ensure_local_llm_relay",
   "arguments": {
    "sessionId": "e2e-sweep",
    "listenHost": "127.0.0.1",
    "listenPort": 3058,
    "targetHost": "127.0.0.1",
    "targetPort": 3059,
    "incomingToken": "${SECRET:relayIn}",
    "upstreamToken": "${SECRET:relayUp}",
    "allowedSourceCIDRs": [
     "127.0.0.1/32"
    ]
   },
   "port": 3056,
   "auth": "secret:sweep"
  },
  {
   "id": "relayListens",
   "guest": "ss -ltnH 'sport = :3058' | wc -l",
   "confirms": [
    "relay"
   ]
  },
  {
   "id": "clusterCall",
   "mcp": "tools/call",
   "tool": "install_cluster_agent",
   "arguments": {
    "source": "k3s-host",
    "clusterId": "e2e-sweep",
    "clusterName": "e2e-sweep",
    "agentId": "e2e-sweep-agent",
    "bridgeToken": "${SECRET:bridgeToken}",
    "bridgeUrl": "http://127.0.0.1:3057"
   },
   "meta": {
    "io.modelcontextprotocol/clientCapabilities": {
     "extensions": {
      "io.modelcontextprotocol/tasks": {}
     },
     "roots": {}
    }
   },
   "port": 3056,
   "auth": "secret:sweep",
   "capture": {
    "TID_cluster": "response.body.result.taskId"
   }
  },
  {
   "id": "cluster",
   "mcp": "tasks/get",
   "params": {
    "taskId": "${TID_cluster}"
   },
   "meta": {
    "io.modelcontextprotocol/clientCapabilities": {
     "extensions": {
      "io.modelcontextprotocol/tasks": {}
     },
     "roots": {}
    }
   },
   "port": 3056,
   "auth": "secret:sweep",
   "until": {
    "path": "response.body.result.status",
    "in": [
     "completed",
     "failed",
     "cancelled"
    ]
   },
   "timeout": 300,
   "interval": 3
  },
  {
   "id": "clusterAgent",
   "guest": "systemctl is-active opute-cluster-agent",
   "confirms": [
    "cluster"
   ]
  },
  {
   "id": "tunnelCall",
   "mcp": "tools/call",
   "tool": "ensure_public_mcp_tunnel",
   "arguments": {
    "bindingId": "e2e-sweep",
    "endpoint": "https://e2e-sweep.invalid/mcp",
    "scope": "system",
    "localTarget": "http://127.0.0.1:3056/mcp",
    "tunnelToken": "${SECRET:tunnelToken}"
   },
   "meta": {
    "io.modelcontextprotocol/clientCapabilities": {
     "extensions": {
      "io.modelcontextprotocol/tasks": {}
     },
     "roots": {}
    }
   },
   "port": 3056,
   "auth": "secret:sweep",
   "capture": {
    "TID_tunnel": "response.body.result.taskId"
   }
  },
  {
   "id": "tunnel",
   "mcp": "tasks/get",
   "params": {
    "taskId": "${TID_tunnel}"
   },
   "meta": {
    "io.modelcontextprotocol/clientCapabilities": {
     "extensions": {
      "io.modelcontextprotocol/tasks": {}
     },
     "roots": {}
    }
   },
   "port": 3056,
   "auth": "secret:sweep",
   "until": {
    "path": "response.body.result.status",
    "in": [
     "completed",
     "failed",
     "cancelled"
    ]
   },
   "timeout": 300,
   "interval": 3
  },
  {
   "id": "connectorRan",
   "guest": "for i in $(seq 40); do c=$(grep -c '^/opt/opute/tunnels/[^ ]*/cloudflared tunnel' /root/e2e-sweep/execve.log || true); [ \"$c\" -ge 2 ] && break; sleep 1; done; echo \"$c\""
  },
  {
   "id": "connectorToken",
   "guest": "journalctl -u 'opute-cloudflared-*' --no-pager -o cat | grep -c 'Provided Tunnel token is not valid' || true"
  },
  {
   "id": "unwatch",
   "guest": "python3 /opt/opute-e2e/guest/secretsweep.py watch stop"
  },
  {
   "id": "scan",
   "guest": "python3 /opt/opute-e2e/guest/secretsweep.py scan --markers /root/e2e-sweep/markers.json --unit e2e-sweep-sweep.service --state /tmp/e2e-agents/sweep/state --holder /tmp/e2e-agents/sweep/state/credentials/host-agent-provider.json --root /etc --root /opt --root /tmp --root /var/tmp --root /home --root /root --root /run --root /usr/local --root /srv"
  }
 ],
 "cleanup": [
  {
   "id": "unwatchAgain",
   "guest": "python3 /opt/opute-e2e/guest/secretsweep.py watch stop >/dev/null; python3 /opt/opute-e2e/guest/secretsweep.py bridge stop >/dev/null; true"
  },
  {
   "id": "removeConnector",
   "guest": "for u in /etc/systemd/system/opute-cloudflared-*.service; do [ -e \"$u\" ] && systemctl disable --now \"$(basename \"$u\")\"; done; rm -f /etc/systemd/system/opute-cloudflared-*.service; rm -rf /etc/opute/tunnels /opt/opute/tunnels; rmdir /opt/opute 2>/dev/null; true"
  },
  {
   "id": "removeClusterAgent",
   "guest": "systemctl disable --now opute-cluster-agent 2>/dev/null; rm -f /etc/systemd/system/opute-cluster-agent.service /etc/opute/cluster-agent.json /usr/local/lib/opute/cluster-agent; rmdir /usr/local/lib/opute 2>/dev/null; systemctl daemon-reload; true"
  },
  {
   "id": "removeAgent",
   "guest": "python3 /opt/opute-e2e/guest/secretsweep.py agent stop sweep >/dev/null; rm -rf /root/e2e-sweep; true"
  },
  {
   "id": "unmountTracing",
   "guest": "umount /sys/kernel/debug/tracing 2>/dev/null; true"
  }
 ],
 "maxMinutes": 15
}
