{
 "id": "e2e2.oci",
 "gate": "e2e-2",
 "description": "OCI build, push and pull on a single-node K3s cluster built through typed calls: ensure a builder, stage a context, install a registry in the cluster, build and push an image, trust the registry in K3s and run the image by digest in a pod; then apply the storage policy, inspect and clean up.",
 "inputs": {
  "agent": "the dev VM's production-style system unit opute-bootstrap-mcp.service (Rust 0.4.0 release candidate binary, test identity e2e-devvm-agent, test token), with the Rust k3s provider 1.0.2 from the release (e2e-provider-k3s, port 4320)",
  "k3s": "K3s v1.31.8+k3s1, downloaded by the provider from the K3s GitHub release and checked against its checksums; images pulled by K3s from public registries",
  "files": {
   "e2etool": {
    "path": "${REPO}/evidence/e2e/guest-tools/e2etool.py",
    "sha256": "41b6bbf3b75c8d8a0dcb52b2bfe3f4f465bf70c7cdb755a9d2ae60cfded464d9"
   },
   "mcpwire": {
    "path": "${REPO}/evidence/e2e/mcpwire.py",
    "sha256": "ab7a4bbac670918d7ab10f31ad5f157998404c8548b5c3ec974cae7aec0ab4fc"
   },
   "providerK3s": {
    "path": "${PARITY}/e2e/release/rust-0.4.0-rc6/opute-provider-k3s-linux-x64",
    "sha256": "f0e4c18623b9e271329bd3538c22219ad62aeeb489f68a8842ab6d57695239c9"
   },
   "activate": {
    "path": "${REPO}/evidence/e2e/journeys/inputs/k3s-activate.yaml",
    "sha256": "91f0b596492e3c72fb5eacba4c14c6141e7da584eebfa88bc4ffbc72573c7788"
   }
  }
 },
 "requirements": [
  {
   "spec": "baseline/inventory/catalog/provider-k3s.json (opute.capability.kubernetes, D22 neutral names)",
   "requirement": "A K3s server provisioned through typed Host Agent operations",
   "pass": [
    {
     "step": "setup",
     "path": "exit",
     "equals": 0
    },
    {
     "step": "setup",
     "path": "stdout",
     "equals": "1\n"
    },
    {
     "step": "installA",
     "path": "response.body.result.isError",
     "in": [
      false,
      "<absent>"
     ]
    },
    {
     "step": "providerToolsA",
     "path": "json.listed",
     "equals": true
    },
    {
     "step": "vm1",
     "path": "response.body.result.result.isError",
     "equals": false
    },
    {
     "step": "info1",
     "path": "response.body.result.structuredContent.ipv4[0]",
     "matches": "^\\d+\\.\\d+\\.\\d+\\.\\d+$"
    },
    {
     "step": "provision",
     "path": "response.body.result.result.structuredContent.provisioned",
     "equals": true
    },
    {
     "step": "ready",
     "path": "response.body.result.structuredContent.readyNodeCount",
     "equals": 1
    }
   ],
   "scenario": "The single-node cluster the journey runs on"
  },
  {
   "spec": "the agent's published tools/list (inputSchema, outputSchema, description) for the tool named",
   "requirement": "ensure_oci_builder, stage_build_context, install_oci_registry, build_and_push_oci_image",
   "pass": [
    {
     "step": "builder",
     "path": "response.body.result.result.isError",
     "equals": false
    },
    {
     "step": "stage",
     "path": "response.body.result.result.isError",
     "equals": false
    },
    {
     "step": "registry",
     "path": "response.body.result.result.isError",
     "equals": false
    },
    {
     "step": "registryStatus",
     "path": "response.body.result.structuredContent.status",
     "equals": "installed"
    },
    {
     "step": "registryStatus",
     "path": "response.body.result.structuredContent.deployment.status.readyReplicas",
     "equals": 1
    },
    {
     "step": "push",
     "path": "response.body.result.result.isError",
     "equals": false
    },
    {
     "step": "push",
     "path": "response.body.result.result.structuredContent.pushed",
     "equals": true
    },
    {
     "step": "digest",
     "path": "stdout",
     "matches": "^sha256:[0-9a-f]{64}$"
    }
   ],
   "scenario": "An image built on the host from a staged context and pushed to a registry running in an e2e- guest's cluster"
  },
  {
   "spec": "the agent's published tools/list (inputSchema, outputSchema, description) for the tool named",
   "requirement": "The pushed image is pulled by digest and runs",
   "pass": [
    {
     "step": "trust",
     "path": "response.body.result.result.isError",
     "equals": false
    },
    {
     "step": "readyAgain",
     "path": "response.body.result.structuredContent.readyNodeCount",
     "equals": 1
    },
    {
     "step": "pull",
     "path": "response.body.result.result.isError",
     "equals": false
    },
    {
     "step": "pulled",
     "path": "response.body.result.structuredContent.status",
     "equals": "ready"
    },
    {
     "step": "logs",
     "path": "response.body.result.structuredContent.stdout",
     "matches": "hello from the e2e registry"
    }
   ],
   "scenario": "The cluster guest pulls the image by its digest from the registry and runs it"
  },
  {
   "spec": "openspec/changes/container-runtime-stdout/specs/container-storage/spec.md",
   "requirement": "A runtime warning does not fail a storage report",
   "pass": [
    {
     "step": "inspectNoSession",
     "path": "response.body.result.isError",
     "in": [
      false,
      "<absent>"
     ]
    },
    {
     "step": "inspectNoSession",
     "path": "response.body.result.structuredContent.runtime",
     "equals": "container-engine"
    }
   ],
   "scenario": "Right after the builder is installed, with no user session, the storage report is read while Podman warns on stderr (D28)"
  },
  {
   "spec": "the agent's published tools/list (inputSchema, outputSchema, description) for the tool named",
   "requirement": "configure_oci_storage, inspect_container_storage, cleanup_container_storage",
   "pass": [
    {
     "step": "supervisor",
     "path": "response.body.result.isError",
     "in": [
      false,
      "<absent>"
     ]
    },
    {
     "step": "supervisorAgain",
     "path": "response.body.result.structuredContent.status",
     "equals": "ready"
    },
    {
     "step": "inspect",
     "path": "response.body.result.isError",
     "in": [
      false,
      "<absent>"
     ]
    },
    {
     "step": "policy",
     "path": "response.body.result.result.isError",
     "equals": false
    },
    {
     "step": "dryRun",
     "path": "response.body.result.result.isError",
     "equals": false
    },
    {
     "step": "cleanup",
     "path": "response.body.result.result.isError",
     "equals": false
    },
    {
     "step": "inspectAfter",
     "path": "response.body.result.isError",
     "in": [
      false,
      "<absent>"
     ]
    },
    {
     "step": "deleteRegistry",
     "path": "response.body.result.result.isError",
     "equals": false
    },
    {
     "step": "linger",
     "path": "stdout",
     "equals": "yes\nbus\n"
    },
    {
     "step": "podman",
     "path": "stdout",
     "equals": "/usr/bin/podman\n"
    },
    {
     "step": "staged",
     "path": "stdout",
     "equals": "./Dockerfile\n./src/main.txt\n"
    },
    {
     "step": "policyFile",
     "path": "stdout",
     "matches": "\"minAgeSeconds\": ?3600"
    },
    {
     "step": "inspectAfter",
     "path": "response.body.result.structuredContent.categories.images.bytes",
     "gte": 1
    },
    {
     "step": "registryGone",
     "path": "stdout",
     "equals": "1\n"
    }
   ],
   "scenario": "With the user service supervisor ready: the storage policy applied, a dry run, a cleanup with the shortest allowed age, and the registry deleted"
  }
 ],
