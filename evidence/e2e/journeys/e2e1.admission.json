{
 "id": "e2e1.admission",
 "gate": "e2e-1",
 "description": "Flow 3, admission: an agent with the documented defaults (mutations not enabled) refuses a mutation, a destructive call and a host plan with the D10 gate error and runs a read tool; an agent with mutations enabled and a 1 MiB memory capacity refuses a mutation with a typed resource-limit error. Neither writes a durable row or a file, and the VM diff is empty.",
 "inputs": {
  "agent": "two Rust agents started for the journey under /tmp/e2e-agents (ports 3019, 3020)",
  "files": {
   "e2etool": {
    "path": "${REPO}/evidence/e2e/guest-tools/e2etool.py",
    "sha256": "3df5fb327e6a68431ab37be00488c42b1a41b67dfb2f3b5ac166f50915cdb96f"
   },
   "mcpwire": {
    "path": "${REPO}/evidence/e2e/mcpwire.py",
    "sha256": "ab7a4bbac670918d7ab10f31ad5f157998404c8548b5c3ec974cae7aec0ab4fc"
   }
  }
 },
 "requirements": [
  {
   "spec": "openspec/changes/standalone-read-only-gate/specs/standalone-read-only-gate/spec.md",
   "requirement": "Standalone without mutations runs read tools only",
   "pass": [
    {
     "step": "gatedAgent",
     "path": "exit",
     "equals": 0
    },
    {
     "step": "mutation",
     "path": "response.body.result.isError",
     "equals": true
    },
    {
     "step": "mutation",
     "path": "response.body.result.content[0].text",
     "equals": "Error: standalone mutations are disabled; set OPUTE_STANDALONE_ALLOW_MUTATIONS=true"
    },
    {
     "step": "destructive",
     "path": "response.body.result.isError",
     "equals": true
    },
    {
     "step": "destructive",
     "path": "response.body.result.content[0].text",
     "equals": "Error: standalone mutations are disabled; set OPUTE_STANDALONE_ALLOW_MUTATIONS=true"
    },
    {
     "step": "planGate",
     "path": "response.body.result.isError",
     "equals": true
    },
    {
     "step": "planGate",
     "path": "response.body.result.content[0].text",
     "equals": "Error: standalone mutations are disabled; set OPUTE_STANDALONE_ALLOW_MUTATIONS=true"
    },
    {
     "step": "gatedRead",
     "path": "response.body.result.isError",
     "in": [
      false,
      "<absent>"
     ]
    },
    {
     "step": "gatedRead",
     "path": "response.body.result.structuredContent.uri",
     "matches": ":e2e-gated-agent$"
    }
   ]
  },
  {
   "spec": "openspec/changes/standalone-read-only-gate/specs/standalone-read-only-gate/spec.md",
   "requirement": "The gate refuses before any effect",
   "pass": [
    {
     "step": "gatedNoFile",
     "path": "exit",
     "equals": 0
    },
    {
     "step": "gatedAfter",
     "path": "json.counts",
     "equalsStep": {
      "step": "gatedBefore",
      "path": "json.counts"
     }
    }
   ]
  },
  {
   "spec": "openspec/specs/host-agent-contract/spec.md",
   "requirement": "Typed target and effect admission",
   "pass": [
    {
     "step": "limitedAgent",
     "path": "exit",
     "equals": 0
    },
    {
     "step": "saturated",
     "path": "response.body.result.isError",
     "equals": true
    },
    {
     "step": "saturated",
     "path": "response.body.result.structuredContent.code",
     "equals": "host_capacity_saturated"
    },
    {
     "step": "saturated",
     "path": "response.body.result.structuredContent.owner",
     "equals": "admission"
    },
    {
     "step": "limitedNoFile",
     "path": "exit",
     "equals": 0
    },
    {
     "step": "limitedAfter",
     "path": "json.counts",
     "equalsStep": {
      "step": "limitedBefore",
      "path": "json.counts"
     }
    }
   ],
   "scenario": "a resource-limit refusal is typed and comes before any side effect or durable row"
  },
  {
   "spec": "openspec/specs/host-agent-contract/spec.md",
   "requirement": "Typed target and effect admission",
   "pass": [
    {
     "step": "saturated",
     "path": "response.body.result.content[0].text",
     "matches": "^Error: host_capacity_saturated: "
    }
   ],
   "scenario": "the refusal names its error code; its message text is not contract (D28, Q3)"
  }
 ],
 "effects": {
  "allow": [],
  "persist": []
 },
 "steps": [
  {
   "id": "tool",
   "copy": "e2etool",
   "to": "/opt/opute-e2e/guest/e2etool.py"
  },
  {
   "id": "wire",
   "copy": "mcpwire",
   "to": "/opt/opute-e2e/guest/mcpwire.py"
  },
  {
   "id": "gatedAgent",
   "guest": "python3 /opt/opute-e2e/guest/e2etool.py agent start gated --port 3019 --id e2e-gated-agent --env MCP_AUTH_TOKEN=${SECRET:gated}"
  },
  {
   "id": "gatedList",
   "mcp": "tools/list",
   "port": 3019,
   "auth": "secret:gated"
  },
  {
   "id": "gatedBefore",
   "guest": "python3 /opt/opute-e2e/guest/e2etool.py db /tmp/e2e-agents/gated/state/state.db"
  },
  {
   "id": "mutation",
   "mcp": "tools/call",
   "tool": "ensure_host_file",
   "arguments": {
    "path": ".config/opute-e2e/j5.txt",
    "content": "e2e\n",
    "scope": "user"
   },
   "port": 3019,
   "auth": "secret:gated"
  },
  {
   "id": "destructive",
   "mcp": "tools/call",
   "tool": "remove_host_file",
   "arguments": {
    "path": ".config/opute-e2e/j5.txt",
    "confirm": true
   },
   "port": 3019,
   "auth": "secret:gated"
  },
  {
   "id": "planGate",
   "mcp": "tools/call",
   "tool": "run_host_plan",
   "arguments": {
    "plan": {
     "contractVersion": "host-plan.v1",
     "planId": "e2e1-j5",
     "generation": 1,
     "idempotencyKey": "e2e1-j5-1",
     "nodes": [
      {
       "id": "n1",
       "action": {
        "tool": "ensure_host_file",
        "args": {
         "path": ".config/opute-e2e/j5.txt",
         "content": "e2e\n",
         "scope": "user"
        }
       },
       "validate": {
        "tool": "inspect_host_file",
        "args": {
         "path": ".config/opute-e2e/j5.txt",
         "scope": "user"
        },
        "assert": [
         {
          "path": "/exists",
          "op": "eq",
          "value": true
         }
        ]
       }
      }
     ]
    }
   },
   "port": 3019,
   "auth": "secret:gated"
  },
  {
   "id": "gatedAfter",
   "guest": "python3 /opt/opute-e2e/guest/e2etool.py db /tmp/e2e-agents/gated/state/state.db"
  },
  {
   "id": "gatedRead",
   "mcp": "tools/call",
   "tool": "get_host_info",
   "arguments": {},
   "port": 3019,
   "auth": "secret:gated"
  },
  {
   "id": "gatedNoFile",
   "guest": "test ! -e /tmp/e2e-agents/gated/home/.config/opute-e2e/j5.txt"
  },
  {
   "id": "limitedAgent",
   "guest": "python3 /opt/opute-e2e/guest/e2etool.py agent start limited --port 3020 --id e2e-limited-agent --env MCP_AUTH_TOKEN=${SECRET:limited} --env OPUTE_STANDALONE_ALLOW_MUTATIONS=true --env OPUTE_HOST_RESOURCE_MEMORY_CAPACITY_BYTES=1048576"
  },
  {
   "id": "limitedList",
   "mcp": "tools/list",
   "port": 3020,
   "auth": "secret:limited"
  },
  {
   "id": "limitedCapacity",
   "mcp": "tools/call",
   "tool": "get_host_capacity",
   "arguments": {},
   "port": 3020,
   "auth": "secret:limited"
  },
  {
   "id": "limitedBefore",
   "guest": "python3 /opt/opute-e2e/guest/e2etool.py db /tmp/e2e-agents/limited/state/state.db"
  },
  {
   "id": "saturated",
   "mcp": "tools/call",
   "tool": "ensure_host_file",
   "arguments": {
    "path": ".config/opute-e2e/j5.txt",
    "content": "e2e\n",
    "scope": "user"
   },
   "port": 3020,
   "auth": "secret:limited"
  },
  {
   "id": "limitedAfter",
   "guest": "python3 /opt/opute-e2e/guest/e2etool.py db /tmp/e2e-agents/limited/state/state.db"
  },
  {
   "id": "limitedNoFile",
   "guest": "test ! -e /tmp/e2e-agents/limited/home/.config/opute-e2e/j5.txt"
  },
  {
   "id": "stop",
   "guest": "python3 /opt/opute-e2e/guest/e2etool.py agent remove gated && python3 /opt/opute-e2e/guest/e2etool.py agent remove limited"
  }
 ],
 "cleanup": [],
 "maxMinutes": 15
}
