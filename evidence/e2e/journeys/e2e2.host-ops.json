{
 "id": "e2e2.host-ops",
 "gate": "e2e-2",
 "description": "Host operations on the dev VM itself through typed calls: a user service's lifecycle (file, enable, start, listener, HTTP, restart, stop, disable, confirmed removal), a refused system unit, bounded host commands, an apt tool, a checksum-verified HTTPS artifact, a tar.zst archive and a traversal archive, the virtualization stack and the bridge control plane. Pass: each effect is observed on the VM and cleanup returns the VM diff to the baseline.",
 "inputs": {
  "agent": "the dev VM's production-style system unit opute-bootstrap-mcp.service (Rust v0.2.4 release binary, test identity e2e-devvm-agent, test token)",
  "files": {
   "e2etool": {
    "path": "${REPO}/evidence/e2e/guest-tools/e2etool.py",
    "sha256": "074214c3b4ca317c3b9c11335908f346f27e6278f50095f0eb6a290bbd399826"
   },
   "mcpwire": {
    "path": "${REPO}/evidence/e2e/mcpwire.py",
    "sha256": "ab7a4bbac670918d7ab10f31ad5f157998404c8548b5c3ec974cae7aec0ab4fc"
   }
  }
 },
 "requirements": [
  {
   "spec": "the agent's published tools/list (inputSchema, outputSchema, description) for the tool named",
   "requirement": "ensure_host_service_supervisor, ensure_host_file, set_host_service_state, inspect_host_service, list_host_services, remove_host_file, inspect_host_file",
   "pass": [
    {
     "step": "supervisorAgain",
     "path": "response.body.result.structuredContent.status",
     "equals": "ready"
    },
    {
     "step": "supervisorAgain",
     "path": "response.body.result.structuredContent.linger",
     "equals": true
    },
    {
     "step": "unit",
     "path": "response.body.result.structuredContent.changed",
     "equals": true
    },
    {
     "step": "unit",
     "path": "response.body.result.structuredContent.path",
     "equals": "/home/opute/.config/systemd/user/e2e-web.service"
    },
    {
     "step": "enable",
     "path": "response.body.result.structuredContent.status",
     "equals": "applied"
    },
    {
     "step": "start",
     "path": "response.body.result.structuredContent.status",
     "equals": "applied"
    },
    {
     "step": "inspect",
     "path": "response.body.result.structuredContent.active",
     "equals": true
    },
    {
     "step": "inspect",
     "path": "response.body.result.structuredContent.enabled",
     "equals": true
    },
    {
     "step": "inspect",
     "path": "response.body.result.structuredContent.listenerOwned",
     "equals": true
    },
    {
     "step": "services",
     "path": "response.body.result.structuredContent.services",
     "exists": true
    },
    {
     "step": "curl",
     "path": "response.body.result.result.structuredContent.stdout",
     "equals": "200"
    },
    {
     "step": "restart",
     "path": "response.body.result.structuredContent.status",
     "in": [
      "applied",
      "scheduled"
     ]
    },
    {
     "step": "running",
     "path": "json.ActiveState",
     "equals": "active"
    },
    {
     "step": "stop",
     "path": "response.body.result.structuredContent.status",
     "equals": "applied"
    },
    {
     "step": "disable",
     "path": "response.body.result.structuredContent.status",
     "equals": "applied"
    },
    {
     "step": "removeUnconfirmed",
     "path": "response.body.result.result.isError",
     "equals": true
    },
    {
     "step": "removeUnconfirmed",
     "path": "response.body.result.result.structuredContent.code",
     "equals": "invalid_arguments"
    },
    {
     "step": "removeUnit",
     "path": "response.body.result.result.isError",
     "equals": false
    },
    {
     "step": "inspectGone",
     "path": "response.body.result.structuredContent.exists",
     "equals": false
    },
    {
     "step": "systemUnitDenied",
     "path": "response.body.result.isError",
     "equals": true
    }
   ],
   "scenario": "A user service: unit file written, enabled, started, owning its port and serving HTTP, restarted, stopped, disabled and its file removed only with confirmation; a system unit file is refused to the agent's unprivileged user"
  },
  {
   "spec": "the agent's published tools/list (inputSchema, outputSchema, description) for the tool named",
   "requirement": "run_host_command",
   "pass": [
    {
     "step": "execFails",
     "path": "response.body.result.result.isError",
     "equals": true
    },
    {
     "step": "execFails",
     "path": "response.body.result.result.structuredContent.exitCode",
     "equals": 3
    },
    {
     "step": "execTimeout",
     "path": "response.body.result.result.isError",
     "equals": true
    },
    {
     "step": "execTimeout",
     "path": "response.body.result.result.content[0].text",
     "matches": "Finished with result: timeout"
    }
   ],
   "scenario": "Bounded host commands: a failing command reports its exit status, a command past its timeout is stopped and reported as failed"
  },
  {
   "spec": "the agent's published tools/list (inputSchema, outputSchema, description) for the tool named",
   "requirement": "ensure_host_tool",
   "pass": [
    {
     "step": "ninjaTool",
     "path": "response.body.result.result.isError",
     "equals": false
    },
    {
     "step": "ninjaTool",
     "path": "response.body.result.result.structuredContent.available",
     "equals": true
    },
    {
     "step": "ninjaTool",
     "path": "response.body.result.result.structuredContent.path",
     "equals": "/usr/bin/ninja"
    },
    {
     "step": "toolAgain",
     "path": "response.body.result.result.structuredContent.alreadyAvailable",
     "equals": true
    },
    {
     "step": "ninja",
     "path": "stdout",
     "equals": "install ok installed\n"
    }
   ],
   "scenario": "An allowlisted package installed through apt once, then reported already available"
  },
  {
   "spec": "the agent's published tools/list (inputSchema, outputSchema, description) for the tool named",
   "requirement": "ensure_host_artifact",
   "pass": [
    {
     "step": "artifact",
     "path": "response.body.result.result.structuredContent.changed",
     "equals": true
    },
    {
     "step": "artifact",
     "path": "response.body.result.result.structuredContent.sha256",
     "equals": "sha256:726d24fbdca8e47c01733ad73d1791efcc1ac3e96bb3daf40b17696c28176689"
    },
    {
     "step": "artifactAgain",
     "path": "response.body.result.result.structuredContent.changed",
     "equals": false
    },
    {
     "step": "artifactBad",
     "path": "response.body.result.result.isError",
     "equals": true
    },
    {
     "step": "artifactBad",
     "path": "response.body.result.result.content[0].text",
     "matches": "sha256 mismatch"
    },
    {
     "step": "artifactFile",
     "path": "response.body.result.structuredContent.sha256",
     "equals": "sha256:726d24fbdca8e47c01733ad73d1791efcc1ac3e96bb3daf40b17696c28176689"
    },
    {
     "step": "artifactBadFile",
     "path": "response.body.result.structuredContent.exists",
     "equals": false
    }
   ],
   "scenario": "An HTTPS artifact downloaded and verified against its SHA-256; a wrong checksum installs nothing"
  },
  {
   "spec": "the agent's published tools/list (inputSchema, outputSchema, description) for the tool named",
   "requirement": "extract_host_archive",
   "pass": [
    {
     "step": "extract",
     "path": "response.body.result.structuredContent.changed",
     "equals": true
    },
    {
     "step": "extract",
     "path": "response.body.result.structuredContent.entries",
     "equals": 2
    },
    {
     "step": "extracted",
     "path": "response.body.result.structuredContent.exists",
     "equals": true
    },
    {
     "step": "extractTraversal",
     "path": "response.body.result.isError",
     "equals": true
    },
    {
     "step": "noEscape",
     "path": "stdout",
     "equals": "contained\n"
    }
   ],
   "scenario": "A tar.zst archive extracted beneath the home directory; a traversal entry is rejected and nothing escapes"
  },
  {
   "spec": "the agent's published tools/list (inputSchema, outputSchema, description) for the tool named",
   "requirement": "install_virtualization_stack",
   "pass": [
    {
     "step": "virt",
     "path": "response.body.result.result.isError",
     "equals": false
    },
    {
     "step": "virt",
     "path": "response.body.result.result.structuredContent.incus",
     "matches": "Server version"
    }
   ],
   "scenario": "The virtualization stack reconciled on a host that has it: Incus reported, nothing broken"
  },
  {
   "spec": "the agent's published tools/list (inputSchema, outputSchema, description) for the tool named",
   "requirement": "restart_host_service (inputSchema: uri only)",
   "pass": [
    {
     "step": "restartIncus",
     "path": "response.body.result.isError",
     "equals": true
    },
    {
     "step": "restartIncus",
     "path": "response.body.result.content[0].text",
     "equals": "Error: serviceName is required"
    }
   ],
   "scenario": "Restarting Incus with the schema's only required input (uri) is refused for a serviceName the schema does not declare (Go v0.2.4 reads the same undeclared input)",
   "openQuestion": "Q21"
  },
  {
   "spec": "the agent's published tools/list (inputSchema, outputSchema, description) for the tool named",
   "requirement": "restart_host_service: \"Restart a host-level service such as Incus\"",
   "pass": [
    {
     "step": "restartIncusNamed",
     "path": "response.body.result.isError",
     "equals": false
    }
   ],
   "scenario": "With serviceName, the production-style agent's unprivileged systemctl is refused by polkit (\"Interactive authentication required\"); Go v0.2.4 builds the same command",
   "openQuestion": "Q23"
  },
  {
   "spec": "the agent's published tools/list (inputSchema, outputSchema, description) for the tool named",
   "requirement": "ensure_host_service_supervisor",
   "pass": [
    {
     "step": "supervisor",
     "path": "response.body.result.structuredContent.status",
     "equals": "ready"
    }
   ],
   "scenario": "The first ensure call on a host whose user manager is not running yet: does it report ready once lingering is enabled, or fail while the user bus starts?",
   "openQuestion": "Q20"
  },
  {
   "spec": "the agent's published tools/list (inputSchema, outputSchema, description) for the tool named",
   "requirement": "diagnose_bridge and recover_bridge",
   "pass": [
    {
     "step": "bridge",
     "path": "response.body.result.isError",
     "equals": false
    },
    {
     "step": "bridge",
     "path": "response.body.result.structuredContent.bridgeStatus",
     "equals": "offline"
    },
    {
     "step": "recoverBridge",
     "path": "response.body.result.isError",
     "equals": true
    }
   ],
   "scenario": "Bridge recovery on a standalone host with no bridge: diagnose reports it offline with no heartbeat (the schema marks lastHeartbeat.at nullable), recover fails closed",
   "openQuestion": "Q22"
  }
 ],
 "effects": {
  "allow": [
   "files//home/opute/e2e*",
   "files//home/opute/evil",
   "files//home/opute/.config/systemd*",
   "packages/ninja-build*",
   "files//usr/bin/ninja*",
   "files//var/lib/dpkg*",
   "files//var/lib/apt*",
   "files//var/cache*",
   "files//var/log*",
   "files//usr/share/doc/ninja-build*",
   "files//usr/share/man*",
   "files//usr/share/bash-completion*",
   "files//usr/share/zsh*",
   "files//usr/share/vim*",
   "files//usr/share/emacs*",
   "system/units/opute-host-workload-*",
   "user/units/e2e-web*",
   "user/unitFiles/e2e-web*",
   "linger/*",
   "users/opute/linger*",
   "system/units/user@*",
   "system/units/user-runtime-dir@*",
   "system/units/user-*.slice",
   "incus/*",
   "files//var/lib/systemd/linger*",
   "linger",
   "system/units/run-user-*",
   "system/units/packagekit.service",
   "files//opt/incus*",
   "files//usr/lib/systemd/system/incus*",
   "system/units/linstor-satellite.service",
   "files//var/lib/dpkg/info/incus*"
  ],
  "persist": [
   "files//opt/incus*",
   "files//usr/lib/systemd/system/incus*",
   "system/units/linstor-satellite.service",
   "system/units/packagekit.service",
   "files//var/lib/dpkg/info/incus*"
  ]
 },
 "steps": [
  {
   "id": "tool",
   "copy": "e2etool",
   "to": "/opt/opute-e2e/guest/e2etool.py"
  },
  {
   "id": "wire",
   "copy": "mcpwire",
   "to": "/opt/opute-e2e/guest/mcpwire.py"
  },
  {
   "id": "catalog",
   "mcp": "tools/list"
  },
  {
   "id": "supervisor",
   "mcp": "tools/call",
   "tool": "ensure_host_service_supervisor",
   "arguments": {},
   "retryOn": [
    "host_capacity_saturated"
   ]
  },
  {
   "id": "userBus",
   "guest": "for i in $(seq 100); do [ -S /run/user/$(id -u opute)/bus ] && break; sleep 0.1; done; test -S /run/user/$(id -u opute)/bus && echo up"
  },
  {
   "id": "supervisorAgain",
   "mcp": "tools/call",
   "tool": "ensure_host_service_supervisor",
   "arguments": {},
   "retryOn": [
    "host_capacity_saturated"
   ]
  },
  {
   "id": "unit",
   "mcp": "tools/call",
   "tool": "ensure_host_file",
   "arguments": {
    "path": "~/.config/systemd/user/e2e-web.service",
    "content": "[Unit]\nDescription=e2e web\n\n[Service]\nExecStart=/usr/bin/python3 -m http.server 8781 --bind 127.0.0.1 --directory /tmp\n\n[Install]\nWantedBy=default.target\n"
   },
   "retryOn": [
    "host_capacity_saturated"
   ]
  },
  {
   "id": "enable",
   "mcp": "tools/call",
   "tool": "set_host_service_state",
   "arguments": {
    "uri": "host-service:local:system/dbus.service",
    "serviceName": "e2e-web.service",
    "state": "enable",
    "scope": "user"
   },
   "retryOn": [
    "host_capacity_saturated"
   ]
  },
  {
   "id": "start",
   "mcp": "tools/call",
   "tool": "set_host_service_state",
   "arguments": {
    "uri": "host-service:local:system/dbus.service",
    "serviceName": "e2e-web.service",
    "state": "start",
    "scope": "user"
   },
   "retryOn": [
    "host_capacity_saturated"
   ]
  },
  {
   "id": "inspect",
   "mcp": "tools/call",
   "tool": "inspect_host_service",
   "arguments": {
    "uri": "host-service:local:user/e2e-web.service",
    "listenPort": 8781
   },
   "retryOn": [
    "host_capacity_saturated"
   ]
  },
  {
   "id": "services",
   "mcp": "tools/call",
   "tool": "list_host_services",
   "arguments": {},
   "retryOn": [
    "host_capacity_saturated"
   ]
  },
  {
   "id": "curlCall",
   "mcp": "tools/call",
   "tool": "run_host_command",
   "arguments": {
    "command": "curl -s -o /dev/null -w %{http_code} http://127.0.0.1:8781/"
   },
   "meta": {
    "io.modelcontextprotocol/clientCapabilities": {
     "extensions": {
      "io.modelcontextprotocol/tasks": {}
     }
    }
   },
   "capture": {
    "TID_curl": "response.body.result.taskId"
   },
   "retryOn": [
    "host_capacity_saturated"
   ]
  },
  {
   "id": "curl",
   "mcp": "tasks/get",
   "params": {
    "taskId": "${TID_curl}"
   },
   "meta": {
    "io.modelcontextprotocol/clientCapabilities": {
     "extensions": {
      "io.modelcontextprotocol/tasks": {}
     }
    }
   },
   "until": {
    "path": "response.body.result.status",
    "in": [
     "completed",
     "failed",
     "cancelled"
    ]
   },
   "timeout": 600,
   "interval": 3
  },
  {
   "id": "restart",
   "mcp": "tools/call",
   "tool": "set_host_service_state",
   "arguments": {
    "uri": "host-service:local:system/dbus.service",
    "serviceName": "e2e-web.service",
    "state": "restart",
    "scope": "user"
   },
   "retryOn": [
    "host_capacity_saturated"
   ]
  },
  {
   "id": "running",
   "guest": "python3 /opt/opute-e2e/guest/e2etool.py unit e2e-web.service --user opute"
  },
  {
   "id": "stop",
   "mcp": "tools/call",
   "tool": "set_host_service_state",
   "arguments": {
    "uri": "host-service:local:system/dbus.service",
    "serviceName": "e2e-web.service",
    "state": "stop",
    "scope": "user"
   },
   "retryOn": [
    "host_capacity_saturated"
   ]
  },
  {
   "id": "disable",
   "mcp": "tools/call",
   "tool": "set_host_service_state",
   "arguments": {
    "uri": "host-service:local:system/dbus.service",
    "serviceName": "e2e-web.service",
    "state": "disable",
    "scope": "user"
   },
   "retryOn": [
    "host_capacity_saturated"
   ]
  },
  {
   "id": "removeUnconfirmedCall",
   "mcp": "tools/call",
   "tool": "remove_host_file",
   "arguments": {
    "path": "~/.config/systemd/user/e2e-web.service"
   },
   "meta": {
    "io.modelcontextprotocol/clientCapabilities": {
     "extensions": {
      "io.modelcontextprotocol/tasks": {}
     }
    }
   },
   "capture": {
    "TID_removeUnconfirmed": "response.body.result.taskId"
   },
   "retryOn": [
    "host_capacity_saturated"
   ]
  },
  {
   "id": "removeUnconfirmed",
   "mcp": "tasks/get",
   "params": {
    "taskId": "${TID_removeUnconfirmed}"
   },
   "meta": {
    "io.modelcontextprotocol/clientCapabilities": {
     "extensions": {
      "io.modelcontextprotocol/tasks": {}
     }
    }
   },
   "until": {
    "path": "response.body.result.status",
    "in": [
     "completed",
     "failed",
     "cancelled"
    ]
   },
   "timeout": 600,
   "interval": 3
  },
  {
   "id": "removeUnitCall",
   "mcp": "tools/call",
   "tool": "remove_host_file",
   "arguments": {
    "path": "~/.config/systemd/user/e2e-web.service",
    "confirm": true
   },
   "meta": {
    "io.modelcontextprotocol/clientCapabilities": {
     "extensions": {
      "io.modelcontextprotocol/tasks": {}
     }
    }
   },
   "capture": {
    "TID_removeUnit": "response.body.result.taskId"
   },
   "retryOn": [
    "host_capacity_saturated"
   ]
  },
  {
   "id": "removeUnit",
   "mcp": "tasks/get",
   "params": {
    "taskId": "${TID_removeUnit}"
   },
   "meta": {
    "io.modelcontextprotocol/clientCapabilities": {
     "extensions": {
      "io.modelcontextprotocol/tasks": {}
     }
    }
   },
   "until": {
    "path": "response.body.result.status",
    "in": [
     "completed",
     "failed",
     "cancelled"
    ]
   },
   "timeout": 600,
   "interval": 3
  },
  {
   "id": "inspectGone",
   "mcp": "tools/call",
   "tool": "inspect_host_file",
   "arguments": {
    "path": "~/.config/systemd/user/e2e-web.service"
   },
   "retryOn": [
    "host_capacity_saturated"
   ]
  },
  {
   "id": "systemUnitDenied",
   "mcp": "tools/call",
   "tool": "ensure_host_file",
   "arguments": {
    "path": "/etc/systemd/system/e2e-sys.service",
    "content": "[Unit]\nDescription=e2e web\n\n[Service]\nExecStart=/usr/bin/python3 -m http.server 8781 --bind 127.0.0.1 --directory /tmp\n\n[Install]\nWantedBy=default.target\n",
    "scope": "system"
   },
   "retryOn": [
    "host_capacity_saturated"
   ]
  },
  {
   "id": "restartIncus",
   "mcp": "tools/call",
   "tool": "restart_host_service",
   "arguments": {
    "uri": "host-service:local:system/incus.service"
   },
   "retryOn": [
    "host_capacity_saturated"
   ]
  },
  {
   "id": "restartIncusNamed",
   "mcp": "tools/call",
   "tool": "restart_host_service",
   "arguments": {
    "uri": "host-service:local:system/incus.service",
    "serviceName": "incus.service"
   },
   "retryOn": [
    "host_capacity_saturated"
   ]
  },
  {
   "id": "execFailsCall",
   "mcp": "tools/call",
   "tool": "run_host_command",
   "arguments": {
    "command": "echo err >&2; exit 3"
   },
   "meta": {
    "io.modelcontextprotocol/clientCapabilities": {
     "extensions": {
      "io.modelcontextprotocol/tasks": {}
     }
    }
   },
   "capture": {
    "TID_execFails": "response.body.result.taskId"
   },
   "retryOn": [
    "host_capacity_saturated"
   ]
  },
  {
   "id": "execFails",
   "mcp": "tasks/get",
   "params": {
    "taskId": "${TID_execFails}"
   },
   "meta": {
    "io.modelcontextprotocol/clientCapabilities": {
     "extensions": {
      "io.modelcontextprotocol/tasks": {}
     }
    }
   },
   "until": {
    "path": "response.body.result.status",
    "in": [
     "completed",
     "failed",
     "cancelled"
    ]
   },
   "timeout": 600,
   "interval": 3
  },
  {
   "id": "execTimeoutCall",
   "mcp": "tools/call",
   "tool": "run_host_command",
   "arguments": {
    "command": "sleep 30",
    "timeoutMs": 1500
   },
   "meta": {
    "io.modelcontextprotocol/clientCapabilities": {
     "extensions": {
      "io.modelcontextprotocol/tasks": {}
     }
    }
   },
   "capture": {
    "TID_execTimeout": "response.body.result.taskId"
   },
   "retryOn": [
    "host_capacity_saturated"
   ]
  },
  {
   "id": "execTimeout",
   "mcp": "tasks/get",
   "params": {
    "taskId": "${TID_execTimeout}"
   },
   "meta": {
    "io.modelcontextprotocol/clientCapabilities": {
     "extensions": {
      "io.modelcontextprotocol/tasks": {}
     }
    }
   },
   "until": {
    "path": "response.body.result.status",
    "in": [
     "completed",
     "failed",
     "cancelled"
    ]
   },
   "timeout": 600,
