{
 "id": "e2e4.restart",
 "gate": "e2e-4",
 "description": "Kill, restart and upgrade mid-work on the Rust system unit: SIGTERM with a task and a plan in flight, SIGKILL with a task in flight, then an in-place upgrade to a newer local Rust build with a task in flight; each item's durable state is read back through get_operation, tasks/get and get_host_plan_run.",
 "inputs": {
  "agent": "the dev VM's production-style system unit opute-bootstrap-mcp.service (Rust 0.4.0 release candidate binary, test identity e2e-devvm-agent, test token)",
  "next": "Rust release set built locally from this branch with VERSION=0.4.1-e2e (no tag, no publish)",
  "slow": "a local endpoint answering after 25 s (e2etool slow)",
  "files": {
   "e2etool": {
    "path": "${REPO}/evidence/e2e/guest-tools/e2etool.py",
    "sha256": "ade206dda988e71aab7ddfcc6117a24d3283f70bf0b5995f0de439c552bfc606"
   },
   "mcpwire": {
    "path": "${REPO}/evidence/e2e/mcpwire.py",
    "sha256": "ab7a4bbac670918d7ab10f31ad5f157998404c8548b5c3ec974cae7aec0ab4fc"
   },
   "rustNext": {
    "path": "${PARITY}/e2e/release/rust-0.4.0-rc1-next/host-agent-linux-x64.gz",
    "sha256": "8c6cc153d93c23734ed636fea5ec30f0e4107c43bb46d59b3db673a1b21d5b06"
   }
  }
 },
 "requirements": [
  {
   "spec": "openspec/specs/host-agent-contract/spec.md",
   "requirement": "Durable and redacted observations (restart)",
   "pass": [
    {
     "step": "supervisorAgain",
     "path": "response.body.result.structuredContent.status",
     "equals": "ready"
    },
    {
     "step": "termTask",
     "path": "response.body.result.status",
     "equals": "working"
    },
    {
     "step": "termP",
     "path": "stdout",
     "equals": "up\n"
    },
    {
     "step": "term",
     "path": "stdout",
     "equals": "up\n"
    },
    {
     "step": "termTaskWire",
     "path": "response.body.result.status",
     "equals": "cancelled"
    },
    {
     "step": "termTaskWire",
     "path": "response.body.result.statusMessage",
     "equals": "The Host Agent shut down before the task completed."
    },
    {
     "step": "kill",
     "path": "stdout",
     "equals": "up\n"
    },
    {
     "step": "opsAfterKill",
     "path": "response.body.result.isError",
     "in": [
      false,
      "<absent>"
     ]
    },
    {
     "step": "upgrade",
     "path": "stdout",
     "matches": "\n0\\.3\\.1-e2e\n$"
    },
    {
     "step": "afterUpgrade",
     "path": "response.body.result.result.structuredContent.stdout",
     "equals": "upgraded\n"
    },
    {
     "step": "db",
     "path": "json.integrity",
     "equals": "ok"
    }
   ],
   "scenario": "A task in flight at SIGTERM is persisted cancelled and reads back so, through get_operation and tasks/get; the agent restarts after SIGKILL and an in-place upgrade and keeps serving"
  },
  {
   "spec": "openspec/changes/truthful-interrupted-plan/specs/host-agent-contract/spec.md",
   "requirement": "An interrupted plan or task reads back truthfully",
   "pass": [
    {
     "step": "termPlanAfter",
     "path": "response.body.result.structuredContent.status",
     "equals": "cancelled"
    },
    {
     "step": "killTaskWire",
     "path": "response.body.result.status",
     "equals": "failed"
    },
    {
     "step": "upTaskWire",
     "path": "response.body.result.status",
     "equals": "cancelled"
    },
    {
     "step": "cancelAfterKill",
     "path": "response.body.result.isError",
     "equals": true
    }
   ],
   "scenario": "A plan running at SIGTERM reads back cancelled; a task killed by SIGKILL reads back failed and cannot be cancelled; a task in flight at the in-place upgrade's graceful stop reads back cancelled (D28)"
  },
  {
   "spec": "openspec/changes/workload-unit-per-task/specs/host-agent-contract/spec.md",
   "requirement": "Each task runs in its own workload unit",
   "pass": [
    {
     "step": "termTaskWire",
     "path": "response.body.result.status",
     "equals": "cancelled"
    },
    {
     "step": "termGone",
     "path": "stdout",
     "equals": "0\n"
    },
    {
     "step": "killOrphan",
     "path": "stdout",
     "equals": "0\n"
    },
    {
     "step": "upGone",
     "path": "stdout",
     "equals": "0\n"
    },
    {
     "step": "killTask",
     "path": "response.body.result.status",
     "equals": "working"
    },
    {
     "step": "upTask",
     "path": "response.body.result.status",
     "equals": "working"
    },
    {
     "step": "twinA",
     "path": "response.body.result.status",
     "equals": "working"
    },
    {
     "step": "twinB",
     "path": "response.body.result.status",
     "equals": "working"
    },
    {
     "step": "twins",
     "path": "stdout",
     "matches": "^2\n"
    },
    {
     "step": "twinADone",
     "path": "response.body.result.status",
     "equals": "completed"
    },
    {
     "step": "twinBDone",
     "path": "response.body.result.status",
     "equals": "completed"
    }
   ],
   "scenario": "A task cancelled by SIGTERM, or by the in-place upgrade's graceful stop, leaves no process running; the same command runs again after the restart and after a SIGKILL; two tasks with the same command run side by side and both complete (decided 2026-11-08)"
  },
  {
   "spec": "openspec/changes/truthful-operation-status/specs/operation-records/spec.md",
   "requirement": "An operation record reports its task's terminal status",
   "pass": [
    {
     "step": "termTaskAfter",
     "path": "response.body.result.structuredContent.status",
     "equals": "cancelled"
    },
    {
     "step": "killTaskAfter",
     "path": "response.body.result.structuredContent.status",
     "equals": "failed"
    },
    {
     "step": "upTaskAfter",
     "path": "response.body.result.structuredContent.status",
     "equals": "cancelled"
    },
    {
     "step": "opsAfterKill",
     "path": "response.body.result.structuredContent.operations",
     "exists": true
    }
   ],
   "scenario": "get_operation reads each task's terminal status, as tasks/get does (D28)"
  }
 ],
 "effects": {
  "allow": [
   "files//home/opute/.local/share/opute/opute-host-agent/sha256",
   "incus/*",
   "files//home/opute/e2e*",
   "files//home/opute/.opute*",
   "files//opt/opute-e2e/releases/rust-next*",
   "system/units/e2e-slow*",
   "system/unitFiles/e2e-slow*",
   "system/units/opute-host-workload-*",
   "system/units/sys-devices-virtual-net-veth*",
   "system/units/sys-subsystem-net-devices-veth*",
   "linger",
   "files//var/lib/systemd/linger*",
   "system/units/user*",
   "system/units/run-user-*",
   "user/*"
  ],
  "persist": [
   "files//home/opute/.opute*"
  ]
 },
 "steps": [
  {
   "id": "tool",
   "copy": "e2etool",
   "to": "/opt/opute-e2e/guest/e2etool.py"
  },
  {
   "id": "wire",
   "copy": "mcpwire",
   "to": "/opt/opute-e2e/guest/mcpwire.py"
  },
  {
   "id": "nextCopy",
   "copy": "rustNext",
   "to": "/opt/opute-e2e/releases/rust-next/host-agent-linux-x64.gz"
  },
  {
   "id": "slow",
   "guest": "python3 /opt/opute-e2e/guest/e2etool.py slow start --port 8799 --delay 25"
  },
  {
   "id": "supervisor",
   "mcp": "tools/call",
   "tool": "ensure_host_service_supervisor",
   "arguments": {},
   "retryOn": [
    "host_capacity_saturated"
   ]
  },
  {
   "id": "userBus",
   "guest": "for i in $(seq 100); do [ -S /run/user/$(id -u opute)/bus ] && break; sleep 0.1; done; test -S /run/user/$(id -u opute)/bus && echo up"
  },
  {
   "id": "supervisorAgain",
   "mcp": "tools/call",
   "tool": "ensure_host_service_supervisor",
   "arguments": {},
   "retryOn": [
    "host_capacity_saturated"
   ]
  },
  {
   "id": "termPlan",
   "mcp": "tools/call",
   "tool": "run_host_plan",
   "arguments": {
    "plan": {
     "contractVersion": "host-plan.v1",
     "planId": "e2e.term",
     "generation": 1,
     "idempotencyKey": "e2e-term-1",
     "nodes": [
      {
       "id": "n1",
       "action": {
        "tool": "ensure_host_file",
        "args": {
         "path": "e2e/term.txt",
         "content": "e2e\n",
         "scope": "user"
        }
       },
       "validate": {
        "tool": "inspect_host_file",
        "args": {
         "path": "e2e/term.txt",
         "scope": "user"
        },
        "assert": [
         {
          "path": "/exists",
          "op": "eq",
          "value": true
         }
        ]
       }
      },
      {
       "id": "n2",
       "dependsOn": [
        "n1"
       ],
       "action": {
        "tool": "probe_http_endpoint",
        "args": {
         "endpoint": "http://127.0.0.1:8799/"
        }
       }
      }
     ]
    }
   },
   "capture": {
    "TERM_RUN": "response.body.result.structuredContent.runId"
   },
   "retryOn": [
    "host_capacity_saturated"
   ]
  },
  {
   "id": "termWaiting",
   "mcp": "tools/call",
   "tool": "get_host_plan_run",
   "arguments": {
    "runId": "${TERM_RUN}"
   },
   "until": {
    "path": "response.body.result.structuredContent.status",
    "in": [
     "running",
     "working"
    ]
   },
   "timeout": 60,
   "retryOn": [
    "host_capacity_saturated"
   ]
  },
  {
   "id": "termP",
   "guest": "systemctl restart opute-bootstrap-mcp.service && for i in $(seq 120); do curl -fsS -o /dev/null http://127.0.0.1:3014/health && break; sleep 0.5; done && echo up"
  },
  {
   "id": "settleP",
   "guest": "sleep 5"
  },
  {
   "id": "termTask",
   "mcp": "tools/call",
   "tool": "run_host_command",
   "arguments": {
    "command": "sleep 120"
   },
   "meta": {
    "io.modelcontextprotocol/clientCapabilities": {
     "extensions": {
      "io.modelcontextprotocol/tasks": {}
     }
    }
   },
   "capture": {
    "TERM_TASK": "response.body.result.taskId"
   },
   "retryOn": [
    "host_capacity_saturated"
   ]
  },
  {
   "id": "term",
   "guest": "systemctl restart opute-bootstrap-mcp.service && for i in $(seq 120); do curl -fsS -o /dev/null http://127.0.0.1:3014/health && break; sleep 0.5; done && echo up"
  },
  {
   "id": "termGone",
   "guest": "sleep 3; pgrep -fx 'sleep 120' | wc -l"
  },
  {
   "id": "termTaskAfter",
   "mcp": "tools/call",
   "tool": "get_operation",
   "arguments": {
    "operationId": "${TERM_TASK}"
   },
   "retryOn": [
    "host_capacity_saturated"
   ]
  },
  {
   "id": "termTaskWire",
   "mcp": "tasks/get",
   "params": {
    "taskId": "${TERM_TASK}"
   },
   "meta": {
    "io.modelcontextprotocol/clientCapabilities": {
     "extensions": {
      "io.modelcontextprotocol/tasks": {}
     }
    }
   }
  },
  {
   "id": "termPlanAfter",
   "mcp": "tools/call",
   "tool": "get_host_plan_run",
   "arguments": {
    "runId": "${TERM_RUN}"
   },
   "retryOn": [
    "host_capacity_saturated"
   ]
  },
  {
   "id": "killTask",
   "mcp": "tools/call",
   "tool": "run_host_command",
   "arguments": {
    "command": "sleep 120"
   },
   "meta": {
    "io.modelcontextprotocol/clientCapabilities": {
     "extensions": {
      "io.modelcontextprotocol/tasks": {}
     }
    }
   },
   "capture": {
    "KILL_TASK": "response.body.result.taskId"
   },
   "retryOn": [
    "host_capacity_saturated"
   ]
  },
  {
   "id": "kill",
   "guest": "systemctl kill -s KILL opute-bootstrap-mcp.service; sleep 1; ! systemctl is-active -q opute-bootstrap-mcp.service && systemctl start opute-bootstrap-mcp.service && for i in $(seq 120); do curl -fsS -o /dev/null http://127.0.0.1:3014/health && break; sleep 0.5; done && echo up"
  },
  {
   "id": "killTaskAfter",
   "mcp": "tools/call",
   "tool": "get_operation",
   "arguments": {
    "operationId": "${KILL_TASK}"
   },
   "retryOn": [
    "host_capacity_saturated"
   ]
  },
  {
   "id": "killTaskWire",
   "mcp": "tasks/get",
   "params": {
    "taskId": "${KILL_TASK}"
   },
   "meta": {
    "io.modelcontextprotocol/clientCapabilities": {
     "extensions": {
      "io.modelcontextprotocol/tasks": {}
     }
    }
   }
  },
  {
   "id": "opsAfterKill",
   "mcp": "tools/call",
   "tool": "list_operations",
   "arguments": {
    "limit": 100
   },
   "retryOn": [
    "host_capacity_saturated"
   ]
  },
  {
   "id": "cancelAfterKill",
   "mcp": "tools/call",
   "tool": "cancel_operation",
   "arguments": {
    "operationId": "${KILL_TASK}"
   },
   "retryOn": [
    "host_capacity_saturated"
   ]
  },
  {
   "id": "killOrphan",
   "guest": "pkill -fx 'sleep 120'; sleep 1; pgrep -fx 'sleep 120' | wc -l"
  },
  {
   "id": "upTask",
   "mcp": "tools/call",
   "tool": "run_host_command",
   "arguments": {
    "command": "sleep 120"
   },
   "meta": {
    "io.modelcontextprotocol/clientCapabilities": {
     "extensions": {
      "io.modelcontextprotocol/tasks": {}
     }
    }
   },
   "capture": {
    "UP_TASK": "response.body.result.taskId"
   },
   "retryOn": [
    "host_capacity_saturated"
   ]
  },
  {
   "id": "upgrade",
   "guest": "systemctl stop opute-bootstrap-mcp.service && gzip -dc /opt/opute-e2e/releases/rust-next/host-agent-linux-x64.gz > /tmp/oha && install -o opute -g opute -m 0755 /tmp/oha /home/opute/.local/share/opute/opute-host-agent && rm /tmp/oha && sha256sum /home/opute/.local/share/opute/opute-host-agent | cut -c1-64 && systemctl start opute-bootstrap-mcp.service && for i in $(seq 120); do curl -fsS -o /dev/null http://127.0.0.1:3014/health && break; sleep 0.5; done && /home/opute/.local/share/opute/opute-host-agent --version"
  },
  {
   "id": "upGone",
   "guest": "sleep 3; pgrep -fx 'sleep 120' | wc -l"
  },
  {
   "id": "upTaskAfter",
   "mcp": "tools/call",
   "tool": "get_operation",
   "arguments": {
    "operationId": "${UP_TASK}"
   },
   "retryOn": [
    "host_capacity_saturated"
   ]
  },
  {
   "id": "upTaskWire",
   "mcp": "tasks/get",
   "params": {
    "taskId": "${UP_TASK}"
   },
   "meta": {
    "io.modelcontextprotocol/clientCapabilities": {
     "extensions": {
      "io.modelcontextprotocol/tasks": {}
     }
    }
   }
  },
  {
   "id": "afterUpgradeCall",
   "mcp": "tools/call",
   "tool": "run_host_command",
   "arguments": {
    "command": "echo upgraded"
   },
   "meta": {
    "io.modelcontextprotocol/clientCapabilities": {
     "extensions": {
      "io.modelcontextprotocol/tasks": {}
     }
    }
   },
   "capture": {
    "TID_afterUpgrade": "response.body.result.taskId"
   },
   "retryOn": [
    "host_capacity_saturated"
   ]
  },
  {
   "id": "afterUpgrade",
   "mcp": "tasks/get",
   "params": {
    "taskId": "${TID_afterUpgrade}"
   },
   "meta": {
    "io.modelcontextprotocol/clientCapabilities": {
     "extensions": {
      "io.modelcontextprotocol/tasks": {}
     }
    }
   },
   "until": {
    "path": "response.body.result.status",
    "in": [
     "completed",
     "failed",
     "cancelled"
    ]
   },
   "timeout": 600,
   "interval": 3
  },
  {
   "id": "twinA",
   "mcp": "tools/call",
   "tool": "run_host_command",
   "arguments": {
    "command": "sleep 20"
   },
   "meta": {
    "io.modelcontextprotocol/clientCapabilities": {
     "extensions": {
      "io.modelcontextprotocol/tasks": {}
     }
    }
   },
   "retryOn": [],
   "capture": {
    "TWIN_A": "response.body.result.taskId"
   }
  },
  {
   "id": "twinB",
   "mcp": "tools/call",
   "tool": "run_host_command",
   "arguments": {
    "command": "sleep 20"
   },
   "meta": {
    "io.modelcontextprotocol/clientCapabilities": {
     "extensions": {
      "io.modelcontextprotocol/tasks": {}
     }
    }
   },
   "retryOn": [],
   "capture": {
    "TWIN_B": "response.body.result.taskId"
   }
  },
  {
   "id": "twins",
   "guest": "sleep 3; pgrep -fx 'sleep 20' | wc -l; systemctl --user -M opute@ list-units 'opute-host-workload-*' --state=active --no-legend 2>/dev/null | wc -l"
  },
  {
   "id": "twinADone",
   "mcp": "tasks/get",
   "params": {
    "taskId": "${TWIN_A}"
   },
   "meta": {
    "io.modelcontextprotocol/clientCapabilities": {
     "extensions": {
      "io.modelcontextprotocol/tasks": {}
     }
    }
   },
   "until": {
    "path": "response.body.result.status",
    "in": [
     "completed",
     "failed",
     "cancelled"
    ]
   },
   "timeout": 90,
   "interval": 3
  },
  {
   "id": "twinBDone",
   "mcp": "tasks/get",
   "params": {
    "taskId": "${TWIN_B}"
   },
   "meta": {
    "io.modelcontextprotocol/clientCapabilities": {
     "extensions": {
      "io.modelcontextprotocol/tasks": {}
     }
    }
   },
   "until": {
    "path": "response.body.result.status",
    "in": [
     "completed",
     "failed",
     "cancelled"
    ]
   },
   "timeout": 90,
   "interval": 3
  },
  {
   "id": "db",
   "guest": "python3 /opt/opute-e2e/guest/e2etool.py db /home/opute/.config/opute/instances/standalone/state/state.db"
  }
 ],
 "cleanup": [
  {
   "id": "restoreRust",
   "guest": "systemctl stop opute-bootstrap-mcp.service; python3 /opt/opute-e2e/guest/e2etool.py slow stop >/dev/null; gzip -dc /opt/opute-e2e/releases/rust/v0.4.0/host-agent-linux-x64.gz > /tmp/oha && install -o opute -g opute -m 0755 /tmp/oha /home/opute/.local/share/opute/opute-host-agent && rm /tmp/oha && sha256sum /home/opute/.local/share/opute/opute-host-agent | cut -c1-64 >/dev/null && systemctl start opute-bootstrap-mcp.service && for i in $(seq 120); do curl -fsS -o /dev/null http://127.0.0.1:3014/health && break; sleep 0.5; done; loginctl disable-linger opute; pkill -fx 'sleep 120'; incus delete -f e2e-t1 2>/dev/null; rm -rf /home/opute/e2e /home/opute/.opute/databases /opt/opute-e2e/releases/rust-next; incus storage volume list default -f csv | awk -F, '$1==\"image\"{print $2}' | xargs -r -I{} incus storage volume delete default image/{}; true"
  }
 ],
 "maxMinutes": 20
}
