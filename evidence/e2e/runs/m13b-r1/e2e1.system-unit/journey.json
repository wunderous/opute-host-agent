{
 "cleanup": [],
 "description": "Flow 2, system unit: uninstall the agent, verify the release artifact against SHA256SUMS, reinstall the binary, Go's recorded deploy/opute-bootstrap-mcp.service and sudoers, the env file and drop-in, pass --check, enable, and serve. The published docs route a production host's install through Platform's Connect Remote Host flow (docs/install), so the recorded deploy files and distribution contract are the reference; reinstalling must reproduce the snapshot exactly (no declared effect).",
 "effects": {
  "allow": [],
  "persist": []
 },
 "gate": "e2e-1",
 "id": "e2e1.system-unit",
 "inputs": {
  "agent": "the dev VM's production-style system unit opute-bootstrap-mcp.service (Rust 0.3.0 release candidate binary, test identity e2e-devvm-agent, test token)",
  "files": {
   "e2etool": {
    "path": "${REPO}/evidence/e2e/guest-tools/e2etool.py",
    "sha256": "074214c3b4ca317c3b9c11335908f346f27e6278f50095f0eb6a290bbd399826"
   },
   "mcpwire": {
    "path": "${REPO}/evidence/e2e/mcpwire.py",
    "sha256": "ab7a4bbac670918d7ab10f31ad5f157998404c8548b5c3ec974cae7aec0ab4fc"
   }
  },
  "release": "/opt/opute-e2e/releases/rust/v0.3.0 (local Rust 0.3.0 release candidate set)"
 },
 "maxMinutes": 20,
 "requirements": [
  {
   "pass": [
    {
     "equals": 0,
     "path": "exit",
     "step": "uninstall"
    },
    {
     "equals": "000",
     "path": "stdout",
     "step": "gone"
    },
    {
     "equals": 0,
     "path": "exit",
     "step": "verify"
    },
    {
     "contains": "host-agent-linux-x64.gz: OK",
     "path": "stdout",
     "step": "verify"
    },
    {
     "equalsStep": {
      "path": "stdout",
      "step": "pinned"
     },
     "path": "stdout",
     "step": "binary"
    },
    {
     "equals": 0,
     "path": "exit",
     "step": "deploy"
    },
    {
     "equals": 0,
     "path": "exit",
     "step": "envfile"
    },
    {
     "equals": 0,
     "path": "exit",
     "step": "check"
    },
    {
     "equals": "configuration ok\n",
     "path": "stdout",
     "step": "check"
    },
    {
     "equals": 0,
     "path": "exit",
     "step": "enable"
    },
    {
     "equals": "active",
     "path": "json.ActiveState",
     "step": "enable"
    },
    {
     "equals": "running",
     "path": "json.SubState",
     "step": "enable"
    },
    {
     "equals": "opute",
     "path": "json.User",
     "step": "enable"
    },
    {
     "equals": "enabled",
     "path": "json.UnitFileState",
     "step": "enable"
    },
    {
     "equals": "/etc/opute/host-agent.env",
     "path": "json.EnvironmentFiles",
     "step": "enable"
    },
    {
     "equals": 0,
     "path": "exit",
     "step": "ipv4"
    },
    {
     "equals": "e2e-devvm-agent",
     "path": "json.agentId",
     "step": "ipv4"
    }
   ],
   "requirement": "Compatible modes, configuration, and distribution",
   "scenario": "install from the release artifact; the configured port applies and the configured bind (HOST_MCP_BIND_HOST=0.0.0.0 in the recorded unit) serves the host's own IPv4 address",
   "spec": "openspec/specs/host-agent-contract/spec.md"
  },
  {
   "pass": [
    {
     "equals": [
      "0.0.0.0:3014"
     ],
     "path": "json.addresses",
     "step": "listen"
    },
    {
     "equals": "000",
     "path": "stdout",
     "step": "ipv6Refused"
    }
   ],
   "requirement": "An IPv4 wildcard bind listens on IPv4 only",
   "scenario": "HOST_MCP_BIND_HOST=0.0.0.0 opens one IPv4 socket; an IPv6 loopback connection is refused (D28)",
   "spec": "openspec/changes/ipv4-wildcard-bind/specs/mcp-listener/spec.md"
  },
  {
   "pass": [
    {
     "contains": "02246cf65d446b7bdd1dfaa62e7652ff7583e36b61a872d33835ed5799d3c3e5  /etc/systemd/system/opute-bootstrap-mcp.service",
     "path": "stdout",
     "step": "deployHashes"
    },
    {
     "contains": "38eca4cda3325c61ca1fcc7fe5220eabfb3be2628061b5faffe0c0f4734013ad  /etc/sudoers.d/opute-host-agent",
     "path": "stdout",
     "step": "deployHashes"
    }
   ],
   "requirement": "deployFiles: the installed unit and sudoers are the recorded deploy files",
   "spec": "baseline/inventory/distribution.json"
  },
  {
   "pass": [
    {
     "equals": 200,
     "path": "response.status",
     "step": "health"
    },
    {
     "equals": "e2e-devvm-agent",
     "path": "response.body.agentId",
     "step": "health"
    },
    {
     "matches": ":e2e-devvm-agent$",
     "path": "response.body.result.structuredContent.uri",
     "step": "info"
    }
   ],
   "requirement": "One exact Host Agent identity",
   "spec": "openspec/specs/host-agent-contract/spec.md"
  },
  {
   "pass": [
    {
     "equals": 200,
     "path": "response.status",
     "step": "list"
    },
    {
     "equals": 200,
     "path": "response.status",
     "step": "info"
    },
    {
     "in": [
      false,
      "<absent>"
     ],
     "path": "response.body.result.isError",
     "step": "info"
    }
   ],
   "requirement": "Compatible authenticated MCP surface",
   "scenario": "Read-only authenticated first call",
   "spec": "openspec/specs/host-agent-contract/spec.md"
  }
 ],
 "steps": [
  {
   "copy": "e2etool",
   "id": "tool",
   "to": "/opt/opute-e2e/guest/e2etool.py"
  },
  {
   "copy": "mcpwire",
   "id": "wire",
   "to": "/opt/opute-e2e/guest/mcpwire.py"
  },
  {
   "guest": "systemctl disable --now opute-bootstrap-mcp.service && rm -f /home/opute/.local/share/opute/opute-host-agent /etc/systemd/system/opute-bootstrap-mcp.service /etc/sudoers.d/opute-host-agent /etc/opute/host-agent.env && rm -rf /etc/systemd/system/opute-bootstrap-mcp.service.d && systemctl daemon-reload",
   "id": "uninstall"
  },
  {
   "guest": "curl -s -o /dev/null -w '%{http_code}' http://127.0.0.1:3014/health; true",
   "id": "gone"
  },
  {
   "guest": "cd /opt/opute-e2e/releases/rust/v0.3.0 && sha256sum -c SHA256SUMS",
   "id": "verify"
  },
  {
   "guest": "awk '$2==\"host-agent-linux-x64\"{print $1}' /opt/opute-e2e/releases/rust/v0.3.0/SHA256SUMS",
   "id": "pinned"
  },
  {
   "guest": "gzip -dc /opt/opute-e2e/releases/rust/v0.3.0/host-agent-linux-x64.gz > /tmp/oha && install -o opute -g opute -m 0755 /tmp/oha /home/opute/.local/share/opute/opute-host-agent && rm /tmp/oha && sha256sum /home/opute/.local/share/opute/opute-host-agent | cut -c1-64",
   "id": "binary"
  },
  {
   "guest": "install -m 0644 /opt/opute-e2e/deploy/opute-bootstrap-mcp.service /etc/systemd/system/opute-bootstrap-mcp.service && install -m 0440 /opt/opute-e2e/deploy/opute-host-agent-sudoers /etc/sudoers.d/opute-host-agent && visudo -cf /etc/sudoers.d/opute-host-agent",
   "id": "deploy"
  },
  {
   "guest": "sha256sum /etc/systemd/system/opute-bootstrap-mcp.service /etc/sudoers.d/opute-host-agent",
   "id": "deployHashes"
  },
  {
   "guest": "install -d -m 0750 -g opute /etc/opute && (umask 027 && printf 'OPUTE_REMOTE_AGENT_ID=e2e-devvm-agent\\nMCP_AUTH_TOKEN=%s\\n' '${TOKEN}' > /etc/opute/host-agent.env) && chgrp opute /etc/opute/host-agent.env && chmod 0640 /etc/opute/host-agent.env && install -d /etc/systemd/system/opute-bootstrap-mcp.service.d && printf '[Service]\\nEnvironmentFile=/etc/opute/host-agent.env\\n' > /etc/systemd/system/opute-bootstrap-mcp.service.d/e2e.conf",
   "id": "envfile"
  },
  {
   "guest": "runuser -u opute -- /home/opute/.local/share/opute/opute-host-agent --check --env-file /etc/opute/host-agent.env",
   "id": "check"
  },
  {
   "guest": "systemctl daemon-reload && systemctl enable --now opute-bootstrap-mcp.service && for i in $(seq 120); do curl -fsS -o /dev/null http://127.0.0.1:3014/health && break; sleep 0.5; done && python3 /opt/opute-e2e/guest/e2etool.py unit opute-bootstrap-mcp.service",
   "id": "enable"
  },
  {
   "health": true,
   "id": "health"
  },
  {
   "guest": "python3 /opt/opute-e2e/guest/e2etool.py listen 3014",
   "id": "listen"
  },
  {
   "guest": "curl -s -o /dev/null -w '%{http_code}' --max-time 3 http://[::1]:3014/health; true",
   "id": "ipv6Refused"
  },
  {
   "guest": "curl -fsS http://$(hostname -I | awk '{print $1}'):3014/health",
   "id": "ipv4"
  },
  {
   "id": "list",
   "mcp": "tools/list"
  },
  {
   "arguments": {},
   "id": "info",
   "mcp": "tools/call",
   "tool": "get_host_info"
  }
 ]
}
