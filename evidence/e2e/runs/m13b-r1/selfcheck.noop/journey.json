{
 "cleanup": [],
 "description": "Positive control: the authenticated read-only first call changes nothing on the VM and passes.",
 "effects": {
  "allow": [],
  "persist": []
 },
 "gate": "e2e-0",
 "id": "selfcheck.noop",
 "inputs": {
  "agent": "the dev VM's production-style system unit (opute-bootstrap-mcp.service), test identity e2e-devvm-agent, test bearer token"
 },
 "maxMinutes": 10,
 "requirements": [
  {
   "pass": [
    {
     "equals": 200,
     "path": "response.status",
     "step": "discover"
    },
    {
     "exists": true,
     "path": "response.body.result",
     "step": "discover"
    },
    {
     "equals": 200,
     "path": "response.status",
     "step": "list"
    },
    {
     "exists": true,
     "path": "response.body.result.tools[0].name",
     "step": "list"
    },
    {
     "equals": 200,
     "path": "response.status",
     "step": "info"
    },
    {
     "in": [
      null,
      false,
      "<absent>"
     ],
     "path": "response.body.result.isError",
     "step": "info"
    },
    {
     "exists": true,
     "path": "response.body.result.structuredContent",
     "step": "info"
    }
   ],
   "requirement": "Compatible authenticated MCP surface",
   "scenario": "Read-only authenticated first call",
   "spec": "openspec/specs/host-agent-contract/spec.md"
  },
  {
   "pass": [
    {
     "equals": 200,
     "path": "response.status",
     "step": "health"
    },
    {
     "equals": "e2e-devvm-agent",
     "path": "response.body.agentId",
     "step": "health"
    }
   ],
   "requirement": "One exact Host Agent identity",
   "scenario": "Identity is missing (the configured identity is served exactly)",
   "spec": "openspec/specs/host-agent-contract/spec.md"
  }
 ],
 "steps": [
  {
   "health": true,
   "id": "health"
  },
  {
   "id": "discover",
   "mcp": "server/discover"
  },
  {
   "id": "list",
   "mcp": "tools/list"
  },
  {
   "arguments": {},
   "id": "info",
   "mcp": "tools/call",
   "tool": "get_host_info"
  }
 ]
}
