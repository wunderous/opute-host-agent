{
 "cleanup": [
  {
   "guest": "python3 /opt/opute-e2e/guest/e2etool.py agent remove b >/dev/null; ip link del e2e-br0 2>/dev/null; if test -f /root/e2e-incus-config.yml; then runuser -u opute -- incus project switch default 2>/dev/null; incus project delete e2e-other 2>/dev/null; cp -p /root/e2e-incus-config.yml /home/opute/.config/incus/config.yml; rm -f /root/e2e-incus-config.yml; fi; for n in e2e-c1 e2e-v1 e2e-foreign; do incus delete -f $n 2>/dev/null; done; incus storage volume list default -f csv | awk -F, '$1==\"image\"{print $2}' | xargs -r -I{} incus storage volume delete default image/{}; true",
   "id": "cleanIncus"
  }
 ],
 "description": "Incus containers and VMs through typed calls on a second agent with ownership enforced: a container with a pinned address and a VM, both reachable; the VM's console (open, type, resize, detach, end with the agent) and a bridged NIC attached and removed; lifecycle; a VM resize; root disk growth and its quota; refusals on an instance the agent does not own; reset of an owned container; delete. Guests live in the default project (Q16).",
 "effects": {
  "allow": [
   "incus/*",
   "files//home/opute/.config/incus*",
   "system/units/e2e-*",
   "system/unitFiles/e2e-*",
   "files//opt/incus*",
   "files//usr/lib/systemd/system/incus*",
   "system/units/linstor-satellite.service",
   "system/units/packagekit.service",
   "files//var/lib/dpkg*",
   "files//var/lib/apt*",
   "files//var/cache*",
   "files//var/log*",
   "system/units/sys-devices-virtual-net-veth*",
   "system/units/sys-subsystem-net-devices-veth*",
   "system/units/sys-devices-virtual-net-tap*",
   "system/units/sys-subsystem-net-devices-tap*",
   "system/units/sys-devices-virtual-net-e2e*",
   "system/units/sys-subsystem-net-devices-e2e*"
  ],
  "persist": [
   "files//opt/incus*",
   "files//usr/lib/systemd/system/incus*",
   "system/units/linstor-satellite.service",
   "system/units/packagekit.service",
   "files//var/lib/dpkg*",
   "files//var/lib/apt*",
   "files//var/cache*",
   "files//var/log*"
  ]
 },
