   "files//home/opute/.config/systemd*",
   "files//var/lib/dpkg*",
   "files//var/log*",
   "files//var/cache*"
  ],
  "persist": [
   "files//var/lib/dpkg*",
   "files//var/log*",
   "files//var/cache*"
  ]
 },
 "gate": "e2e-2",
 "id": "e2e2.oci",
 "inputs": {
  "agent": "the dev VM's production-style system unit opute-bootstrap-mcp.service (Rust 0.4.0 release candidate binary, test identity e2e-devvm-agent, test token), with the Rust k3s provider 1.0.2 from the release (e2e-provider-k3s, port 4320)",
  "files": {
   "activate": {
    "path": "${REPO}/evidence/e2e/journeys/inputs/k3s-activate.yaml",
    "sha256": "91f0b596492e3c72fb5eacba4c14c6141e7da584eebfa88bc4ffbc72573c7788"
   },
   "e2etool": {
    "path": "${REPO}/evidence/e2e/guest-tools/e2etool.py",
    "sha256": "ade206dda988e71aab7ddfcc6117a24d3283f70bf0b5995f0de439c552bfc606"
   },
   "mcpwire": {
    "path": "${REPO}/evidence/e2e/mcpwire.py",
    "sha256": "ab7a4bbac670918d7ab10f31ad5f157998404c8548b5c3ec974cae7aec0ab4fc"
   },
   "providerK3s": {
    "path": "${PARITY}/e2e/release/rust-0.4.0-rc1/opute-provider-k3s-linux-x64",
    "sha256": "29bb3447fa29c7fea475f47cadabe33bc4bfeaeb88ed7a73aaed05de7d44a3e7"
   }
  },
  "k3s": "K3s v1.31.8+k3s1, downloaded by the provider from the K3s GitHub release and checked against its checksums; images pulled by K3s from public registries"
 },
 "maxMinutes": 28,
 "requirements": [
  {
   "pass": [
    {
     "equals": 0,
     "path": "exit",
     "step": "setup"
    },
    {
     "equals": "1\n",
     "path": "stdout",
     "step": "setup"
    },
    {
     "in": [
      false,
      "<absent>"
     ],
     "path": "response.body.result.isError",
     "step": "installA"
    },
    {
     "equals": true,
     "path": "json.listed",
     "step": "providerToolsA"
    },
    {
     "equals": false,
     "path": "response.body.result.result.isError",
     "step": "vm1"
    },
    {
     "equals": true,
     "path": "response.body.result.result.structuredContent.provisioned",
     "step": "provision"
    },
    {
     "equals": 1,
     "path": "response.body.result.structuredContent.readyNodeCount",
     "step": "ready"
    }
   ],
   "requirement": "A K3s server provisioned through typed Host Agent operations",
   "scenario": "The single-node cluster the journey runs on",
   "spec": "baseline/inventory/catalog/provider-k3s.json (opute.capability.kubernetes, D22 neutral names)"
  },
  {
   "pass": [
    {
     "equals": false,
     "path": "response.body.result.result.isError",
     "step": "builder"
    },
    {
     "equals": false,
     "path": "response.body.result.result.isError",
     "step": "stage"
    },
    {
     "equals": false,
     "path": "response.body.result.result.isError",
     "step": "registry"
    },
    {
     "equals": "installed",
     "path": "response.body.result.structuredContent.status",
     "step": "registryStatus"
    },
    {
     "equals": 1,
     "path": "response.body.result.structuredContent.deployment.status.readyReplicas",
     "step": "registryStatus"
    },
    {
     "equals": false,
     "path": "response.body.result.result.isError",
     "step": "push"
    },
    {
     "equals": true,
     "path": "response.body.result.result.structuredContent.pushed",
     "step": "push"
    },
    {
     "matches": "^sha256:[0-9a-f]{64}$",
     "path": "stdout",
     "step": "digest"
    }
   ],
   "requirement": "ensure_oci_builder, stage_build_context, install_oci_registry, build_and_push_oci_image",
   "scenario": "An image built on the host from a staged context and pushed to a registry running in an e2e- guest's cluster",
   "spec": "the agent's published tools/list (inputSchema, outputSchema, description) for the tool named"
  },
  {
   "pass": [
    {
     "equals": false,
     "path": "response.body.result.result.isError",
     "step": "trust"
    },
    {
     "equals": false,
     "path": "response.body.result.result.isError",
     "step": "pull"
    },
    {
     "equals": "ready",
     "path": "response.body.result.structuredContent.status",
     "step": "pulled"
    },
    {
     "matches": "hello from the e2e registry",
     "path": "response.body.result.structuredContent.stdout",
     "step": "logs"
    }
   ],
   "requirement": "The pushed image is pulled by digest and runs",
   "scenario": "The cluster guest pulls the image by its digest from the registry and runs it",
   "spec": "the agent's published tools/list (inputSchema, outputSchema, description) for the tool named"
  },
  {
