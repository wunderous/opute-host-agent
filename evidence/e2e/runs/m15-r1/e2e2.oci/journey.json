   "files//home/opute/.config/containers*",
   "files//home/opute/.config/cni*",
   "files//usr*",
   "files//etc*",
   "files//var*",
   "files//opt/cni*",
   "system/*",
   "packages/*",
   "users/*",
   "groups/*",
   "user/*",
   "linger*",
