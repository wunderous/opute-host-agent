    {
     "in": [
      false,
      "<absent>"
     ],
     "path": "response.body.result.isError",
     "step": "inspectNoSession"
    },
    {
     "equals": "container-engine",
     "path": "response.body.result.structuredContent.runtime",
     "step": "inspectNoSession"
    }
   ],
   "requirement": "A runtime warning does not fail a storage report",
   "scenario": "Right after the builder is installed, with no user session, the storage report is read while Podman warns on stderr (D28)",
   "spec": "openspec/changes/container-runtime-stdout/specs/container-storage/spec.md"
  },
  {
   "pass": [
    {
     "equals": "ready",
     "path": "response.body.result.structuredContent.status",
     "step": "supervisorAgain"
    },
    {
     "in": [
      false,
      "<absent>"
     ],
     "path": "response.body.result.isError",
     "step": "inspect"
    },
    {
     "equals": false,
     "path": "response.body.result.result.isError",
     "step": "policy"
    },
    {
     "equals": false,
     "path": "response.body.result.result.isError",
     "step": "dryRun"
    },
    {
     "equals": false,
     "path": "response.body.result.result.isError",
     "step": "cleanup"
    },
    {
     "in": [
      false,
      "<absent>"
     ],
     "path": "response.body.result.isError",
     "step": "inspectAfter"
    },
    {
     "equals": false,
     "path": "response.body.result.result.isError",
     "step": "deleteRegistry"
    }
   ],
   "requirement": "configure_oci_storage, inspect_container_storage, cleanup_container_storage",
   "scenario": "With the user service supervisor ready: the storage policy applied, a dry run, a cleanup with the shortest allowed age, and the registry deleted",
   "spec": "the agent's published tools/list (inputSchema, outputSchema, description) for the tool named"
  }
 ],
 "steps": [
  {
   "copy": "e2etool",
   "id": "tool",
   "to": "/opt/opute-e2e/guest/e2etool.py"
  },
  {
   "copy": "mcpwire",
   "id": "wire",
   "to": "/opt/opute-e2e/guest/mcpwire.py"
  },
  {
   "copy": "providerK3s",
   "id": "providerCopy",
   "mode": "0755",
   "to": "/opt/opute-e2e/providers/opute-provider-k3s"
  },
  {
   "copy": "activate",
   "id": "recipeCopy",
   "mode": "0644",
   "to": "/home/opute/.config/opute-e2e/k3s-activate.yaml"
  },
  {
   "guest": "chown -R opute /home/opute/.config/opute-e2e && systemd-run --collect --unit=e2e-provider-k3s --uid=opute --gid=opute --setenv=HOME=/home/opute --setenv=OPUTE_PROVIDER_PORT=4320 --property=Restart=no /opt/opute-e2e/providers/opute-provider-k3s >/dev/null && for i in $(seq 60); do ss -ltnH 'sport = :4320' | grep -q . && break; sleep 0.5; done; ss -ltnH 'sport = :4320' | wc -l",
   "id": "setup"
  },
  {
   "arguments": {
    "activate": true,
    "descriptor": {
     "capabilities": [
      {
       "id": "opute.capability.kubernetes.v1",
       "version": 1
      }
     ],
     "pluginId": "com.opute.k3s",
     "schema": "opute-provider-plugin.v1",
     "server": {
      "endpoint": "http://127.0.0.1:4320/mcp",
      "transport": "streamable_http"
     },
     "version": "1.0.2"
    },
    "recipeSource": "/home/opute/.config/opute-e2e/k3s-activate.yaml"
   },
   "id": "installA",
   "mcp": "tools/call",
   "retryOn": [
    "host_capacity_saturated"
   ],
   "tool": "opute.provider.install"
  },
  {
   "guest": "python3 -c 'import sys, time, json; sys.path.insert(0, \"/opt/opute-e2e/guest\"); import mcpwire\nfor i in range(120):\n    r = mcpwire.mcp(3014, sys.argv[1], \"tools/list\", request_id=i + 1)\n    names = [t[\"name\"] for t in ((r.get(\"body\") or {}).get(\"result\") or {}).get(\"tools\") or []]\n    if \"opute.capability.kubernetes.provision\" in names: break\n    time.sleep(0.5)\nprint(json.dumps({\"listed\": \"opute.capability.kubernetes.provision\" in names, \"tools\": len(names), \"polls\": i + 1}))' '${TOKEN}'",
   "id": "providerToolsA"
  },
  {
   "id": "catalogAfterA",
   "mcp": "tools/list"
  },
  {
   "arguments": {
    "cpus": 3,
    "disk": "20GiB",
    "image": "parity-noble",
    "instanceType": "container",
    "memory": "4GiB",
    "name": "e2e-k1"
   },
   "capture": {
    "TID_vm1": "response.body.result.taskId"
   },
   "id": "vm1Call",
   "mcp": "tools/call",
   "meta": {
    "io.modelcontextprotocol/clientCapabilities": {
     "extensions": {
      "io.modelcontextprotocol/tasks": {}
     }
    }
   },
   "retryOn": [
    "host_capacity_saturated"
   ],
   "tool": "provision_vm"
  },
  {
   "id": "vm1",
   "interval": 3,
   "mcp": "tasks/get",
   "meta": {
    "io.modelcontextprotocol/clientCapabilities": {
     "extensions": {
      "io.modelcontextprotocol/tasks": {}
     }
    }
   },
   "params": {
    "taskId": "${TID_vm1}"
   },
   "timeout": 600,
   "until": {
    "in": [
     "completed",
     "failed",
     "cancelled"
    ],
    "path": "response.body.result.status"
   }
  },
  {
   "arguments": {
    "uri": "container:local:e2e-k1"
   },
   "capture": {
    "K1_IP": "response.body.result.structuredContent.ipv4[0]"
   },
   "id": "info1",
   "mcp": "tools/call",
   "retryOn": [
    "host_capacity_saturated"
   ],
   "tool": "get_vm_info"
  },
  {
   "arguments": {
    "clusterInit": true,
    "instanceType": "container",
    "providerInstanceName": "e2e-k1",
    "targetUri": "container:local:e2e-k1",
    "version": "v1.31.8+k3s1"
   },
   "capture": {
    "TID_provision": "response.body.result.taskId"
   },
   "id": "provisionCall",
   "mcp": "tools/call",
   "meta": {
    "io.modelcontextprotocol/clientCapabilities": {
     "extensions": {
      "io.modelcontextprotocol/tasks": {}
     }
    }
   },
   "retryOn": [
    "host_capacity_saturated"
   ],
   "tool": "opute.capability.kubernetes.provision"
  },
  {
   "id": "provision",
   "interval": 3,
   "mcp": "tasks/get",
   "meta": {
    "io.modelcontextprotocol/clientCapabilities": {
     "extensions": {
      "io.modelcontextprotocol/tasks": {}
     }
    }
   },
   "params": {
    "taskId": "${TID_provision}"
   },
   "timeout": 600,
   "until": {
    "in": [
     "completed",
     "failed",
     "cancelled"
    ],
    "path": "response.body.result.status"
   }
  },
  {
   "arguments": {
    "instanceType": "container",
    "providerInstanceName": "e2e-k1",
    "targetUri": "cluster:local:e2e-k1"
   },
   "id": "ready",
   "interval": 5,
   "mcp": "tools/call",
   "retryOn": [
    "host_capacity_saturated"
   ],
   "timeout": 300,
   "tool": "opute.capability.kubernetes.status",
   "until": {
    "in": [
     1
    ],
    "path": "response.body.result.structuredContent.readyNodeCount"
   }
  },
  {
   "guest": "dpkg -l | awk '/^ii/{print $2}' | sort > /tmp/e2e-pkgs-before && echo recorded",
   "id": "pkgsBefore"
  },
  {
   "arguments": {},
   "capture": {
    "TID_builder": "response.body.result.taskId"
   },
   "id": "builderCall",
   "mcp": "tools/call",
   "meta": {
    "io.modelcontextprotocol/clientCapabilities": {
     "extensions": {
      "io.modelcontextprotocol/tasks": {}
     }
    }
   },
   "retryOn": [
    "host_capacity_saturated"
   ],
   "tool": "ensure_oci_builder"
  },
  {
   "id": "builder",
   "interval": 3,
   "mcp": "tasks/get",
   "meta": {
    "io.modelcontextprotocol/clientCapabilities": {
     "extensions": {
      "io.modelcontextprotocol/tasks": {}
     }
    }
   },
   "params": {
    "taskId": "${TID_builder}"
   },
   "timeout": 900,
   "until": {
    "in": [
     "completed",
     "failed",
     "cancelled"
    ],
    "path": "response.body.result.status"
   }
  },
  {
   "arguments": {
    "destDir": "/home/opute/.opute/build-contexts/e2e-app",
    "files": {
     "Dockerfile": "FROM docker.io/library/busybox:1.36\nCOPY src/ /app/\nCMD [\"sh\", \"-c\", \"cat /app/main.txt; sleep 3600\"]\n",
     "src/main.txt": "hello from the e2e registry\n"
    }
   },
   "capture": {
    "TID_stage": "response.body.result.taskId"
   },
   "id": "stageCall",
   "mcp": "tools/call",
   "meta": {
    "io.modelcontextprotocol/clientCapabilities": {
     "extensions": {
      "io.modelcontextprotocol/tasks": {}
     }
    }
   },
   "retryOn": [
    "host_capacity_saturated"
   ],
   "tool": "stage_build_context"
  },
  {
   "id": "stage",
   "interval": 3,
   "mcp": "tasks/get",
   "meta": {
    "io.modelcontextprotocol/clientCapabilities": {
     "extensions": {
      "io.modelcontextprotocol/tasks": {}
     }
    }
   },
   "params": {
    "taskId": "${TID_stage}"
   },
   "timeout": 600,
   "until": {
    "in": [
     "completed",
     "failed",
     "cancelled"
    ],
    "path": "response.body.result.status"
   }
  },
  {
   "arguments": {
    "image": "registry:2.8.3",
    "storageSize": "1Gi",
    "uri": "cluster:local:e2e-k1"
   },
   "capture": {
    "TID_registry": "response.body.result.taskId"
   },
   "id": "registryCall",
   "mcp": "tools/call",
   "meta": {
    "io.modelcontextprotocol/clientCapabilities": {
     "extensions": {
      "io.modelcontextprotocol/tasks": {}
     }
    }
   },
   "retryOn": [
    "host_capacity_saturated"
   ],
   "tool": "install_oci_registry"
  },
  {
   "id": "registry",
   "interval": 3,
   "mcp": "tasks/get",
   "meta": {
    "io.modelcontextprotocol/clientCapabilities": {
     "extensions": {
      "io.modelcontextprotocol/tasks": {}
     }
    }
   },
   "params": {
    "taskId": "${TID_registry}"
   },
   "timeout": 600,
   "until": {
    "in": [
     "completed",
     "failed",
     "cancelled"
    ],
    "path": "response.body.result.status"
   }
  },
  {
   "arguments": {
    "uri": "cluster:local:e2e-k1"
   },
   "id": "registryStatus",
   "interval": 5,
   "mcp": "tools/call",
   "retryOn": [
    "host_capacity_saturated"
   ],
   "timeout": 300,
   "tool": "get_oci_registry_status",
   "until": {
    "in": [
     1
    ],
    "path": "response.body.result.structuredContent.deployment.status.readyReplicas"
   }
  },
  {
   "arguments": {
    "contextDir": "/home/opute/.opute/build-contexts/e2e-app",
    "image": "${K1_IP}:30500/e2e/app:1",
    "insecureRegistry": true
   },
   "capture": {
    "TID_push": "response.body.result.taskId"
   },
   "id": "pushCall",
   "mcp": "tools/call",
   "meta": {
    "io.modelcontextprotocol/clientCapabilities": {
     "extensions": {
      "io.modelcontextprotocol/tasks": {}
     }
    }
   },
   "retryOn": [
    "host_capacity_saturated"
   ],
   "tool": "build_and_push_oci_image"
  },
  {
   "id": "push",
   "interval": 3,
   "mcp": "tasks/get",
   "meta": {
    "io.modelcontextprotocol/clientCapabilities": {
     "extensions": {
      "io.modelcontextprotocol/tasks": {}
     }
    }
   },
   "params": {
    "taskId": "${TID_push}"
   },
   "timeout": 900,
   "until": {
    "in": [
     "completed",
     "failed",
     "cancelled"
    ],
    "path": "response.body.result.status"
   }
  },
  {
   "capture": {
    "DIGEST": "stdout"
   },
   "guest": "curl -fsSI -H 'Accept: application/vnd.oci.image.manifest.v1+json' -H 'Accept: application/vnd.docker.distribution.manifest.v2+json' http://${K1_IP}:30500/v2/e2e/app/manifests/1 | tr -d '\\r' | awk 'tolower($1)==\"docker-content-digest:\"{printf \"%s\", $2}'",
   "id": "digest"
  },
  {
   "arguments": {
