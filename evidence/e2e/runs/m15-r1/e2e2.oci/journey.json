    ],
    "path": "response.body.result.status"
   }
  },
  {
   "guest": "rm -rf /home/opute/.opute/build-contexts/e2e-app; loginctl disable-linger opute; rm -rf /home/opute/.local/share/containers /home/opute/.config/containers /home/opute/.config/cni /home/opute/.opute/build-contexts; rmdir /home/opute/.opute 2>/dev/null; if [ -f /tmp/e2e-pkgs-before ]; then dpkg -l | awk '/^ii/{print $2}' | sort > /tmp/e2e-pkgs-after; comm -13 /tmp/e2e-pkgs-before /tmp/e2e-pkgs-after | DEBIAN_FRONTEND=noninteractive xargs -r apt-get purge -y -q >/dev/null 2>&1; fi; rm -f /tmp/e2e-pkgs-before /tmp/e2e-pkgs-after; rm -rf /etc/containers; mkdir -p -m 0755 /etc/apparmor.d/disable; systemctl daemon-reload; systemctl stop packagekit.service boot-complete.target 2>/dev/null; systemctl reset-failed podman-restart.service 2>/dev/null; systemctl stop e2e-provider-k3s 2>/dev/null; incus delete -f e2e-k1 2>/dev/null; incus storage volume list default -f csv | awk -F, '$1==\"image\"{print $2}' | xargs -r -I{} incus storage volume delete default image/{}; rm -rf /home/opute/.config/opute-e2e /opt/opute-e2e/providers; true",
   "id": "cleanSetup"
  }
 ],
 "description": "OCI build, push and pull on a single-node K3s cluster built through typed calls: ensure a builder, stage a context, install a registry in the cluster, build and push an image, trust the registry in K3s and run the image by digest in a pod; then apply the storage policy, inspect and clean up.",
 "effects": {
  "allow": [
   "incus/*",
   "files//home/opute/.config/opute-e2e*",
   "files//home/opute/.config/incus*",
   "files//opt/opute-e2e/providers*",
   "system/units/e2e-*",
   "system/unitFiles/e2e-*",
   "system/units/sys-devices-virtual-net-veth*",
   "system/units/sys-subsystem-net-devices-veth*",
   "files//home/opute/.opute*",
