{
 "cleanup": [
  {
   "arguments": {
    "instanceType": "container",
    "providerInstanceName": "e2e-k1",
    "targetUri": "cluster:local:e2e-k1"
   },
   "capture": {
    "TID_cleanRemove": "response.body.result.taskId"
   },
   "id": "cleanRemoveCall",
   "mcp": "tools/call",
   "meta": {
    "io.modelcontextprotocol/clientCapabilities": {
     "extensions": {
      "io.modelcontextprotocol/tasks": {}
     }
    }
   },
   "retryOn": [
    "host_capacity_saturated"
   ],
   "tool": "opute.capability.kubernetes.remove"
  },
  {
   "id": "cleanRemove",
   "interval": 3,
   "mcp": "tasks/get",
   "meta": {
    "io.modelcontextprotocol/clientCapabilities": {
     "extensions": {
      "io.modelcontextprotocol/tasks": {}
     }
    }
   },
   "params": {
    "taskId": "${TID_cleanRemove}"
   },
   "timeout": 600,
   "until": {
    "in": [
     "completed",
     "failed",
     "cancelled"
    ],
    "path": "response.body.result.status"
   }
  },
  {
   "arguments": {
    "uri": "container:local:e2e-k1"
   },
   "capture": {
    "TID_cleanDelete1": "response.body.result.taskId"
   },
   "id": "cleanDelete1Call",
   "mcp": "tools/call",
   "meta": {
    "io.modelcontextprotocol/clientCapabilities": {
     "extensions": {
      "io.modelcontextprotocol/tasks": {}
     }
    }
   },
   "retryOn": [
    "host_capacity_saturated"
   ],
   "tool": "delete_vm"
  },
  {
   "id": "cleanDelete1",
   "interval": 3,
   "mcp": "tasks/get",
   "meta": {
    "io.modelcontextprotocol/clientCapabilities": {
     "extensions": {
      "io.modelcontextprotocol/tasks": {}
     }
    }
   },
   "params": {
    "taskId": "${TID_cleanDelete1}"
   },
   "timeout": 600,
   "until": {
    "in": [
     "completed",
     "failed",
     "cancelled"
    ],
    "path": "response.body.result.status"
   }
  },
  {
   "guest": "rm -rf /home/opute/.opute/build-contexts/e2e-site /home/opute/e2e /tmp/e2e-site.html; loginctl disable-linger opute; rm -rf /home/opute/.local/share/containers /home/opute/.config/containers /home/opute/.config/cni /home/opute/.opute/build-contexts; rmdir /home/opute/.opute 2>/dev/null; if [ -f /tmp/e2e-pkgs-before ]; then dpkg -l | awk '/^ii/{print $2}' | sort > /tmp/e2e-pkgs-after; comm -13 /tmp/e2e-pkgs-before /tmp/e2e-pkgs-after | DEBIAN_FRONTEND=noninteractive xargs -r apt-get purge -y -q >/dev/null 2>&1; fi; rm -f /tmp/e2e-pkgs-before /tmp/e2e-pkgs-after; pkill -x catatonit; rm -rf /tmp/containers-user-1001 /tmp/podman-run-1001 /var/lib/containers; rm -rf /etc/containers; mkdir -p -m 0755 /etc/apparmor.d/disable; systemctl daemon-reload; systemctl stop packagekit.service boot-complete.target 2>/dev/null; systemctl reset-failed podman-restart.service 2>/dev/null; systemctl stop e2e-provider-k3s 2>/dev/null; incus delete -f e2e-k1 2>/dev/null; incus storage volume list default -f csv | awk -F, '$1==\"image\"{print $2}' | xargs -r -I{} incus storage volume delete default image/{}; rm -rf /home/opute/.config/opute-e2e /opt/opute-e2e/providers; true",
   "id": "cleanSetup"
  }
 ],
