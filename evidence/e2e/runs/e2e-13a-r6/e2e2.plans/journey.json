    ],
    "path": "response.body.result.structuredContent.status"
   }
  },
  {
   "guest": "sleep 5",
   "id": "released2"
  },
  {
   "arguments": {
    "plan": {
     "contractVersion": "host-plan.v1",
     "generation": 1,
     "idempotencyKey": "e2e-cancel-1",
     "nodes": [
      {
       "action": {
        "args": {
         "content": "c1\n",
         "path": "~/e2e/c1.txt",
         "scope": "user"
        },
        "tool": "ensure_host_file"
       },
       "id": "file",
       "validate": {
        "args": {
         "path": "~/e2e/c1.txt",
