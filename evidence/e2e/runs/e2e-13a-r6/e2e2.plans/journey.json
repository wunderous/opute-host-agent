   "id": "operations",
   "mcp": "tools/call",
   "retryOn": [
    "host_capacity_saturated"
   ],
   "tool": "list_operations"
  },
  {
   "arguments": {
    "inputs": {
     "name": "r1"
    },
    "source": "/home/opute/e2e/recipe.yaml"
   },
   "id": "recipeValidate",
   "mcp": "tools/call",
   "retryOn": [
    "host_capacity_saturated"
   ],
   "tool": "validate_host_local_recipe"
  },
  {
   "arguments": {
    "inputs": {
     "name": "r1"
    },
    "source": "/home/opute/e2e/recipe.yaml"
   },
   "capture": {
