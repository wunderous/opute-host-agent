   "capture": {
    "RUN": "response.body.result.structuredContent.runId"
   },
   "id": "run",
   "mcp": "tools/call",
   "retryOn": [
    "host_capacity_saturated"
   ],
   "tool": "run_host_plan"
  },
  {
   "arguments": {
    "runId": "${RUN}"
   },
   "id": "done",
   "mcp": "tools/call",
   "retryOn": [
    "host_capacity_saturated"
   ],
   "timeout": 600,
   "tool": "get_host_plan_run",
   "until": {
    "in": [
     "completed",
     "failed",
     "cancelled"
    ],
    "path": "response.body.result.structuredContent.status"
   }
  },
  {
   "arguments": {
    "plan": {
     "contractVersion": "host-plan.v1",
     "generation": 1,
