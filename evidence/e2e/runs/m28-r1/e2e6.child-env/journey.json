{
 "cleanup": [
  {
   "guest": "incus delete -f e2e-v6 2>/dev/null; rm -f /tmp/e2e-agents/child-env-recipe.yaml; incus storage volume list default -f csv | awk -F, '$1==\"image\"{print $2}' | xargs -r -I{} incus storage volume delete default image/{}; true",
   "id": "cleanVm"
  },
  {
   "guest": "python3 /opt/opute-e2e/guest/e2etool.py agent remove cenv >/dev/null ; true",
   "id": "remove"
  }
 ],
 "description": "A child's environment (D40): an agent holding its bearer, two provider credentials and an OPUTE_ setting opens a VM console and runs a recipe step; /proc shows neither child holds any of them.",
 "effects": {
  "allow": [
   "incus/instances/e2e-v6",
   "incus/volumes/default/virtual-machine/e2e-v6",
   "incus/volumes/default/image/218cdcb32645f937f1fff55b7614310d7f40d7e21120e818da04023e7ba0150b",
   "incus/networks/incusbr0/used_by",
   "incus/profiles/default/used_by",
   "incus/storage/default/used_by",
   "system/units/sys-devices-virtual-net-tap*",
   "system/units/sys-subsystem-net-devices-tap*",
   "system/units/var-lib-incus-devices-e2e\\x2dv6-config.mount.mount",
   "files//tmp/e2e-agents/child-env-recipe.yaml",
   "links/tap*",
   "mounts//var/lib/incus/devices/e2e-v6/config.mount btrfs",
   "processes//system.slice/incus.service qemu-system-x86",
   "modules/tap",
   "modules/vhost_net",
   "files//tmp/e2e-agents",
   "system/units/e2e-agent-cenv.service",
   "system/unitFiles/e2e-agent-cenv.service",
   "files//tmp/e2e-agents/cenv*",
   "processes//system.slice/e2e-agent-cenv.service opute-host-agen",
   "sockets/tcp 127.0.0.1:3050 opute-host-agen"
  ],
  "persist": [
   "modules/tap",
   "modules/vhost_net"
  ]
 },
 "gate": "e2e-6",
 "id": "e2e6.child-env",
 "inputs": {
  "agent": "transient Rust agents of the installed release candidate (0.5.0) under /tmp/e2e-agents",
  "files": {
   "e2etool": {
    "path": "${REPO}/evidence/e2e/guest-tools/e2etool.py",
    "sha256": "fb3d5480cc4a6b5f352ae67e0036a2b91179fdd8b4f1ccf9aa205474b2ba89fb"
   },
   "mcpwire": {
    "path": "${REPO}/evidence/e2e/mcpwire.py",
    "sha256": "ab7a4bbac670918d7ab10f31ad5f157998404c8548b5c3ec974cae7aec0ab4fc"
   },
   "recipe": {
    "path": "${REPO}/evidence/e2e/journeys/inputs/e2e-child-env-recipe.yaml",
    "sha256": "487b12955bdfdc82edb6855451162dc1273ab254de341cf79ff58e3d1ca3a913"
   }
  }
 },
 "maxMinutes": 20,
 "requirements": [
  {
   "pass": [
    {
     "equals": "completed",
     "path": "response.body.result.status",
     "step": "vm"
    },
    {
     "equals": false,
     "path": "response.body.result.result.isError",
     "step": "vm"
    },
    {
     "equals": "started",
     "path": "response.body.result.structuredContent.status",
     "step": "console"
    },
    {
     "equals": "sent",
     "path": "response.body.result.structuredContent.status",
     "step": "ctrlA"
    },
    {
     "equals": true,
     "path": "response.body.result.structuredContent.closed",
     "step": "detach"
    },
    {
     "equals": "RUNNING\n",
     "path": "stdout",
     "step": "vmState"
    },
    {
     "equals": "0\n",
     "path": "stdout",
     "step": "detached"
    },
    {
     "equals": true,
     "path": "json.agentHasExpected",
     "step": "consoleEnv"
    },
    {
     "gte": 1,
     "path": "json.found",
     "step": "consoleEnv"
    },
    {
     "equals": [],
     "path": "json.leaked",
     "step": "consoleEnv"
    },
    {
     "equals": true,
     "path": "json.childrenKeep",
     "step": "consoleEnv"
    }
   ],
   "requirement": "A child process never receives the agent's secrets",
   "scenario": "With the bearer, two provider credentials and an OPUTE_ setting in the agent's environment, its incus console process holds PATH and none of them",
   "spec": "openspec/changes/child-process-environment/specs/child-process-environment/spec.md"
  },
  {
   "pass": [
    {
     "equals": true,
     "path": "json.agentHasExpected",
     "step": "recipeEnv"
    },
    {
     "gte": 1,
     "path": "json.found",
     "step": "recipeEnv"
    },
    {
     "equals": [],
     "path": "json.leaked",
     "step": "recipeEnv"
    },
    {
     "equals": true,
     "path": "json.childrenKeep",
     "step": "recipeEnv"
    },
    {
     "equals": "completed",
     "path": "response.body.result.structuredContent.status",
     "step": "recipeDone"
    },
    {
     "equals": "done\n",
     "path": "stdout",
     "step": "recipeFile"
    }
   ],
   "requirement": "A child process never receives the agent's secrets",
   "scenario": "While a recipe step's run_host_command workload runs, the systemd-run client the agent started for it holds PATH and none of the agent's secrets",
   "spec": "openspec/changes/child-process-environment/specs/child-process-environment/spec.md"
  }
 ],
 "steps": [
  {
   "copy": "e2etool",
   "id": "tool",
   "to": "/opt/opute-e2e/guest/e2etool.py"
  },
  {
   "copy": "mcpwire",
   "id": "wire",
   "to": "/opt/opute-e2e/guest/mcpwire.py"
  },
  {
   "guest": "python3 /opt/opute-e2e/guest/e2etool.py agent start cenv --port 3050 --id e2e-cenv-agent --env MCP_AUTH_TOKEN=${SECRET:cenv} --allow-mutations --env CLOUDFLARE_API_TOKEN=${SECRET:cfToken} --env TAILSCALE_AUTH_KEY=${SECRET:tsKey} --env OPUTE_E2E_MARKER=e2e-marker --user root",
   "id": "cenvAgent"
  },
  {
   "auth": "secret:cenv",
   "id": "list",
   "mcp": "tools/list",
   "port": 3050
  },
  {
   "arguments": {
    "cpus": 1,
    "disk": "10GiB",
    "image": "parity-noble-vm",
    "instanceType": "virtual-machine",
    "memory": "1GiB",
    "name": "e2e-v6"
   },
   "auth": "secret:cenv",
   "capture": {
    "VM": "response.body.result.taskId"
   },
   "id": "vmCall",
   "mcp": "tools/call",
   "meta": {
    "io.modelcontextprotocol/clientCapabilities": {
     "extensions": {
      "io.modelcontextprotocol/tasks": {}
     }
    }
   },
   "port": 3050,
   "tool": "provision_vm"
  },
  {
   "auth": "secret:cenv",
   "id": "vm",
   "interval": 3,
   "mcp": "tasks/get",
   "meta": {
    "io.modelcontextprotocol/clientCapabilities": {
     "extensions": {
      "io.modelcontextprotocol/tasks": {}
     }
    }
   },
   "params": {
    "taskId": "${VM}"
   },
   "port": 3050,
   "timeout": 900,
   "until": {
    "in": [
     "completed",
     "failed",
     "cancelled"
    ],
    "path": "response.body.result.status"
   }
  },
  {
   "confirms": [
    "vm"
   ],
   "guest": "incus list e2e-v6 -c s -f csv",
   "id": "vmState"
  },
  {
   "arguments": {
    "uri": "vm:local:e2e-v6"
   },
   "auth": "secret:cenv",
   "id": "console",
   "mcp": "tools/call",
   "port": 3050,
   "tool": "stream_vm_console"
  },
  {
   "confirms": [
    "console"
   ],
   "guest": "python3 /opt/opute-e2e/guest/e2etool.py childenv e2e-agent-cenv.service 'console e2e-v6' --expect MCP_AUTH_TOKEN --expect CLOUDFLARE_API_TOKEN --expect TAILSCALE_AUTH_KEY --expect OPUTE_E2E_MARKER --keep PATH",
   "id": "consoleEnv"
  },
  {
   "arguments": {
    "data": "\u0001",
    "operationId": "console-e2e-v6"
   },
   "auth": "secret:cenv",
   "id": "ctrlA",
   "mcp": "tools/call",
   "port": 3050,
   "tool": "send_console_input"
  },
  {
   "arguments": {
    "data": "q",
    "operationId": "console-e2e-v6"
   },
   "auth": "secret:cenv",
   "id": "detach",
   "mcp": "tools/call",
   "port": 3050,
   "tool": "send_console_input"
  },
  {
   "confirms": [
    "ctrlA",
    "detach"
   ],
   "guest": "for i in $(seq 20); do pgrep -f 'console e2e-v6$' >/dev/null || break; sleep 0.5; done; pgrep -fc 'console e2e-v6$' || true",
   "id": "detached"
  },
  {
   "copy": "recipe",
   "id": "recipeCopy",
   "mode": "0644",
   "to": "/tmp/e2e-agents/child-env-recipe.yaml"
  },
  {
   "arguments": {
    "source": "/tmp/e2e-agents/child-env-recipe.yaml"
   },
   "auth": "secret:cenv",
   "capture": {
    "RRUN": "response.body.result.structuredContent.runId"
   },
   "id": "recipeRun",
   "mcp": "tools/call",
   "port": 3050,
   "tool": "run_host_local_recipe"
  },
  {
   "guest": "for i in $(seq 40); do out=$(python3 /opt/opute-e2e/guest/e2etool.py childenv e2e-agent-cenv.service 'systemd-run' --expect MCP_AUTH_TOKEN --expect CLOUDFLARE_API_TOKEN --expect TAILSCALE_AUTH_KEY --expect OPUTE_E2E_MARKER --keep PATH); echo \"$out\" | grep -q '\"found\": [1-9]' && break; sleep 1; done; echo \"$out\"",
   "id": "recipeEnv"
  },
  {
   "arguments": {
    "runId": "${RRUN}"
   },
   "auth": "secret:cenv",
   "id": "recipeDone",
   "mcp": "tools/call",
   "port": 3050,
   "timeout": 120,
   "tool": "get_host_plan_run",
   "until": {
    "in": [
     "completed",
     "failed",
     "cancelled"
    ],
    "path": "response.body.result.structuredContent.status"
   }
  },
  {
   "confirms": [
    "recipeRun"
   ],
   "guest": "test -e /tmp/e2e-agents/cenv/home/child-env.done && echo done",
   "id": "recipeFile"
  }
 ]
}
