  {
   "guest": "systemctl stop e2e-provider-k3s e2e-provider-k3s-b 2>/dev/null; python3 /opt/opute-e2e/guest/e2etool.py agent remove b >/dev/null; for n in e2e-k1 e2e-k2 e2e-k3; do incus delete -f $n 2>/dev/null; done; incus storage volume list default -f csv | awk -F, '$1==\"image\"{print $2}' | xargs -r -I{} incus storage volume delete default image/{}; rm -rf /home/opute/.config/opute-e2e /opt/opute-e2e/providers; true",
   "id": "cleanSetup"
  }
 ],
