{
 "commands": {
  "apt-cache": [
   {
    "argv": [
     "show",
     "virglrenderer2"
    ],
    "stdout": "Package: virglrenderer2"
   },
   {
    "argv": [
     "show",
     "gpu-ok"
    ],
    "stdout": "Package: gpu-ok"
   },
   {
    "argv": [
     "show",
     "gpu-missing"
    ],
    "exit": 100,
    "stderr": "E: No packages found\n"
   },
   {
    "argv": [
     "policy",
     "incus"
    ],
    "stdout": "incus:\n  Installed: (none)\n  Candidate: 1:7.3-ubuntu24.04\n"
   }
  ],
  "apt-get": [],
  "curl": [
   {
    "argvPrefix": [
     "-fsSL"
    ],
    "exit": 22,
    "stderr": "curl: (22) The requested URL returned error: 404\n"
   }
  ],
  "dpkg": [
   {
    "argv": [
     "--print-architecture"
    ],
    "stdout": "amd64"
   }
  ],
  "sudo": [
   {
    "argvPrefix": [
     "-n",
     "install"
    ],
    "hashFiles": true
   },
   {
    "argvPrefix": [
     "-n"
    ]
   }
  ],
  "incus": [
   {
    "argv": [
     "version"
    ],
    "stdout": "7.3"
   },
   {
    "argv": [
     "storage",
     "list",
     "--format",
     "json"
    ],
    "stdout": "[]"
   },
   {
    "argv": [
     "storage",
     "create",
     "default",
     "dir"
    ]
   },
   {
    "argv": [
     "network",
     "list",
     "--format",
     "json"
    ],
    "stdout": "[{\"name\":\"lxdbr0\"}]"
   },
   {
    "argvPrefix": [
     "network",
     "create"
    ]
   },
   {
    "argv": [
     "profile",
     "device",
     "show",
     "default"
    ],
    "stdout": "devices:\n  root:\n    path: /\n"
   },
   {
    "argvPrefix": [
     "profile",
     "device",
     "add"
    ]
   }
  ]
 },
 "default": {
  "exit": 1,
  "stderr": "unsupported parity shim invocation\n"
 },
 "description": "Install paths through recorded shims. virtualizationVersions ranges over a Go map, so its probes run in random order; only `incus version` is shimmed, keeping the trace ordered (the version table itself is compared by probe_incus_gpu)."
}
