{
 "commands": {
  "incus": [
   {
    "argv": [
     "list",
     "--format",
     "json"
    ],
    "stdout": "[{\"name\":"
   }
  ],
  "sudo": [
   {
    "argv": [
     "-n",
     "systemctl",
     "disable",
     "--now",
     "incus-user.socket"
    ],
    "exit": 1,
    "stderr": "Failed to disable unit\n"
   },
   {
    "argvPrefix": [
     "-n"
    ]
   }
  ],
  "apt-get": [],
  "dpkg-query": [
   {
    "argvPrefix": [
     "-W",
     "-f=${Package} ${Status}\n"
    ],
    "exit": 1,
    "stdout": "incus install ok installed\nincus-base install ok installed\nincus-client deinstall ok config-files\n",
    "stderr": "dpkg-query: no packages found matching incus-agent\n"
   }
  ]
 },
 "default": {
  "exit": 1,
  "stderr": "unsupported parity shim invocation\n"
 }
}
