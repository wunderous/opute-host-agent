{
 "description": "WSL2 interop with wsl.exe and reg.exe but no powershell.exe. The host identity's MachineGuid query is answered.",
 "commands": {
  "wsl.exe": [
   {
    "argv": [
     "--terminate",
     "Ubuntu"
    ]
   },
   {
    "argv": [
     "--terminate",
     "Busy"
    ],
    "exit": 3,
    "stderr": "The operation could not be completed.\r\n"
   },
   {
    "argv": [
     "--shutdown"
    ]
   },
   {
    "argv": [
     "-l",
     "-v"
    ],
    "stdoutBase64": ""
   }
  ],
  "reg.exe": [
   {
    "argv": [
     "query",
     "HKLM\\SOFTWARE\\Microsoft\\Cryptography",
     "/v",
     "MachineGuid"
    ],
    "stdout": "\r\nHKEY_LOCAL_MACHINE\\SOFTWARE\\Microsoft\\Cryptography\r\n    MachineGuid    REG_SZ    5f0c2a8e-1b3d-4c6e-9a7f-0123456789ab\r\n"
   },
   {
    "argv": [
     "query",
     "HKCU\\Software\\Microsoft\\Windows\\CurrentVersion\\Lxss",
     "/s"
    ],
    "stdoutBase64": ""
   }
  ]
 },
 "default": {
  "exit": 1,
  "stderr": "unsupported parity shim invocation\n"
 }
}
