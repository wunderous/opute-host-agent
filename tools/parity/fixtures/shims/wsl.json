{
 "description": "WSL2 interop through recorded wsl.exe, reg.exe and powershell.exe shims: UTF-16 listings, per-distribution disk outcomes. No Windows host is reached.",
 "commands": {
  "wsl.exe": [
   {
    "argv": [
     "--terminate",
     "Ubuntu"
    ]
   },
   {
    "argv": [
     "--terminate",
     "Busy"
    ],
    "exit": 3,
    "stderr": "The operation could not be completed.\r\n"
   },
   {
    "argv": [
     "--shutdown"
    ]
   },
   {
    "argv": [
     "-l",
     "-v"
    ],
    "stdoutBase64": ""
   }
  ],
  "reg.exe": [
   {
    "argv": [
     "query",
     "HKCU\\Software\\Microsoft\\Windows\\CurrentVersion\\Lxss",
     "/s"
    ],
    "stdoutBase64": ""
   }
  ],
  "powershell.exe": [
   {
    "argv": [
     "-NoProfile",
     "-NonInteractive",
     "-Command",
     "(Get-ItemProperty -Path 'HKLM:\\SOFTWARE\\Microsoft\\Cryptography' -Name MachineGuid).MachineGuid"
    ],
    "stdout": "5f0c2a8e-1b3d-4c6e-9a7f-0123456789ab"
   },
   {
    "argvContains": "[System.IO.File]::Open('C:\\wsl\\Ubuntu\\ext4.vhdx'"
   },
   {
    "argvContains": "Get-Item -LiteralPath 'C:\\wsl\\Ubuntu\\ext4.vhdx'",
    "stdout": "8192"
   },
   {
    "argvContains": "[System.IO.File]::Open('C:\\wsl\\Other\\ext4.vhdx'"
   },
   {
    "argvContains": "[System.IO.File]::Open('C:\\wsl\\Locked\\ext4.vhdx'",
    "stdout": "locked"
   },
   {
    "argvContains": "[System.IO.File]::Open('C:\\wsl\\Quirk\\ext4.vhdx'",
    "stdout": "unlocked"
   },
   {
    "argvContains": "[System.IO.File]::Open('C:\\wsl\\Denied\\ext4.vhdx'"
   },
   {
    "argvContains": "[System.IO.File]::Open('C:\\Program Files\\wsl\\Failing\\ext4.vhdx'"
   },
   {
    "argvContains": "[System.IO.File]::Open('C:\\wsl\\BadSize\\ext4.vhdx'"
   },
   {
    "argvContains": "[System.IO.File]::Open('C:\\wsl\\SizeFails\\ext4.vhdx'"
   },
   {
    "argvContains": "Get-Item -LiteralPath 'C:\\wsl\\Other\\ext4.vhdx'",
    "stdout": "524288",
    "ifExists": "state/other-optimized"
   },
   {
    "argvContains": "Get-Item -LiteralPath 'C:\\wsl\\Other\\ext4.vhdx'",
    "stdout": "1048576"
   },
   {
    "argvContains": "Get-Item -LiteralPath 'C:\\wsl\\Locked\\ext4.vhdx'",
    "stdout": "4096"
   },
   {
    "argvContains": "Get-Item -LiteralPath 'C:\\wsl\\Quirk\\ext4.vhdx'",
    "stdout": "4096"
   },
   {
    "argvContains": "Get-Item -LiteralPath 'C:\\wsl\\Denied\\ext4.vhdx'",
    "stdout": "4096"
   },
   {
    "argvContains": "Get-Item -LiteralPath 'C:\\Program Files\\wsl\\Failing\\ext4.vhdx'",
    "stdout": "4096"
   },
   {
    "argvContains": "Get-Item -LiteralPath 'C:\\wsl\\BadSize\\ext4.vhdx'",
    "stdout": "n/a"
   },
   {
    "argvContains": "Get-Item -LiteralPath 'C:\\wsl\\SizeFails\\ext4.vhdx'",
    "exit": 1,
    "stderr": "Get-Item : Cannot find path\r\n"
   },
   {
    "argvContains": "Optimize-VHD -Path 'C:\\wsl\\Other\\ext4.vhdx'",
    "creates": [
     "state/other-optimized"
    ]
   },
   {
    "argvContains": "Optimize-VHD -Path 'C:\\wsl\\Denied\\ext4.vhdx'",
    "exit": 1,
    "stderr": "Optimize-VHD : Access is denied.\r\n"
   },
   {
    "argvContains": "Optimize-VHD -Path 'C:\\Program Files\\wsl\\Failing\\ext4.vhdx'",
    "exit": 2,
    "stdout": "partial",
    "stderr": "Optimize-VHD : The system failed.\r\n"
   }
  ]
 },
 "default": {
  "exit": 1,
  "stderr": "unsupported parity shim invocation\n"
 }
}
