[
 {
  "id": "t2.llm-domain.ollama.lifecycle",
  "tier": "T2",
  "owner": "llm",
  "anchors": [
   "internal/tools/dispatch_llm.go",
   "internal/tools/dispatch.go:resolveLocalLLMModelArg",
   "internal/domain/llm/ollama.go",
   "internal/domain/llm/relay.go",
   "internal/domain/llm/runtime_probe.go"
  ],
  "commands": [
   "systemctl"
  ],
  "residue": "The generated opute-ollama.service stays enabled and running (Go never stops the shared runtime), with its model store, the runtime config and lingering; the relay state directory stays empty.",
  "steps": [
   {
    "as": "linger",
    "shell": {
     "argv": [
      "loginctl",
      "enable-linger",
      "ubuntu"
     ],
     "user": "root"
    }
   },
   {
    "as": "userManager",
    "shell": {
     "argv": [
      "sh",
      "-c",
      "for i in $(seq 1 100); do [ -S /run/user/1000/bus ] && exit 0; sleep 0.1; done; exit 1"
     ],
     "user": "root"
    }
   },
   {
    "as": "stub",
    "shell": {
     "argv": [
      "install",
      "-D",
      "-m",
      "0755",
      "/opt/parity-t2/llmstub.py",
      "/home/ubuntu/bin/ollama"
     ],
     "user": "ubuntu"
    }
   },
   {
    "as": "baseline",
    "snapshot": {}
   },
   {
    "as": "serve",
    "serve": {
     "env": {
      "OPUTE_OLLAMA_BINARY": "/home/ubuntu/bin/ollama",
      "OPUTE_HOST_AGENT_RELAY_DIR": "/home/ubuntu/.opute/relays"
     }
    }
   },
   {
    "as": "prerequisites",
    "mcp": {
     "method": "tools/call",
     "name": "check_local_llm_prerequisites",
     "params": {
      "name": "check_local_llm_prerequisites",
      "arguments": {}
     }
    }
   },
   {
    "as": "install",
    "mcp": {
     "method": "tools/call",
     "name": "install_local_llm_model",
     "params": {
      "name": "install_local_llm_model",
      "arguments": {
       "modelRef": "parity/tiny:1b"
      }
     },
     "capture": {
      "T_INSTALL": [
       "body",
       "result",
       "taskId"
      ]
     }
    }
   },
   {
    "as": "installDone",
    "mcp": {
     "method": "tasks/get",
     "name": "${T_INSTALL}",
     "params": {
      "taskId": "${T_INSTALL}"
     },
     "until": {
      "path": [
       "body",
       "result",
       "status"
      ],
      "in": [
       "completed",
       "failed",
       "cancelled"
      ]
     },
     "timeout": 300
    }
   },
   {
    "as": "installed",
    "snapshot": {
     "baseline": "baseline"
    }
   },
   {
    "as": "list",
    "mcp": {
     "method": "tools/call",
     "name": "list_local_llm_models",
     "params": {
      "name": "list_local_llm_models",
      "arguments": {}
     }
    }
   },
   {
    "as": "persist",
    "mcp": {
     "method": "tools/call",
     "name": "configure_local_llm_model",
     "params": {
      "name": "configure_local_llm_model",
      "arguments": {
       "modelRef": "parity/tiny:1b",
       "contextSize": 8192
      }
     },
     "capture": {
      "T_PERSIST": [
       "body",
       "result",
       "taskId"
      ]
     }
    }
   },
   {
    "as": "persistDone",
    "mcp": {
     "method": "tasks/get",
     "name": "${T_PERSIST}",
     "params": {
      "taskId": "${T_PERSIST}"
     },
     "until": {
      "path": [
       "body",
       "result",
       "status"
      ],
      "in": [
       "completed",
       "failed",
       "cancelled"
      ]
     },
     "timeout": 600
    }
   },
   {
    "as": "context",
    "mcp": {
     "method": "tools/call",
     "name": "configure_local_llm_model",
     "params": {
      "name": "configure_local_llm_model",
      "arguments": {
       "modelRef": "parity/tiny:1b"
      }
     },
     "capture": {
      "T_CONTEXT": [
       "body",
       "result",
       "taskId"
      ]
     }
    }
   },
   {
    "as": "contextDone",
    "mcp": {
     "method": "tasks/get",
     "name": "${T_CONTEXT}",
     "params": {
      "taskId": "${T_CONTEXT}"
     },
     "until": {
      "path": [
       "body",
       "result",
       "status"
      ],
      "in": [
       "completed",
       "failed",
       "cancelled"
      ]
     },
     "timeout": 600
    }
   },
   {
    "as": "probe",
    "mcp": {
     "method": "tools/call",
     "name": "probe_local_llm",
     "params": {
      "name": "probe_local_llm",
      "arguments": {
       "modelRef": "parity/tiny:1b",
       "includeChat": true
      }
     }
    }
   },
   {
    "as": "start",
    "mcp": {
     "method": "tools/call",
     "name": "start_local_llm_runtime",
     "params": {
      "name": "start_local_llm_runtime",
      "arguments": {}
     },
     "capture": {
      "T_START": [
       "body",
       "result",
       "taskId"
      ]
     }
    }
   },
   {
    "as": "startDone",
    "mcp": {
     "method": "tasks/get",
     "name": "${T_START}",
     "params": {
      "taskId": "${T_START}"
     },
     "until": {
      "path": [
       "body",
       "result",
       "status"
      ],
      "in": [
       "completed",
       "failed",
       "cancelled"
      ]
     },
     "timeout": 600
    }
   },
   {
    "as": "stop",
    "mcp": {
     "method": "tools/call",
     "name": "stop_local_llm_runtime",
     "params": {
      "name": "stop_local_llm_runtime",
      "arguments": {}
     },
     "capture": {
      "T_STOP": [
       "body",
       "result",
       "taskId"
      ]
     }
    }
   },
   {
    "as": "stopDone",
    "mcp": {
     "method": "tasks/get",
     "name": "${T_STOP}",
     "params": {
      "taskId": "${T_STOP}"
     },
     "until": {
      "path": [
       "body",
       "result",
       "status"
      ],
      "in": [
       "completed",
       "failed",
       "cancelled"
      ]
     },
     "timeout": 600
    }
   },
   {
    "as": "configured",
    "snapshot": {
     "baseline": "installed"
    }
   },
   {
    "as": "relay",
    "mcp": {
     "method": "tools/call",
     "name": "ensure_local_llm_relay",
     "params": {
      "name": "ensure_local_llm_relay",
      "arguments": {
       "sessionId": "parity-t2-relay",
       "listenHost": "127.0.0.1",
       "listenPort": 18434,
       "targetHost": "127.0.0.1",
       "targetPort": 11434,
       "incomingToken": "parity-incoming-token-0123456789abcdefghij",
       "upstreamToken": "",
       "allowedSourceCIDRs": [
        "127.0.0.0/8"
       ]
      }
     }
    }
   },
   {
    "as": "throughRelay",
    "shell": {
     "argv": [
      "python3",
      "-c",
      "import sys,urllib.request,urllib.error\nr=urllib.request.Request(sys.argv[1],method=sys.argv[2],data=(sys.argv[4].encode() if sys.argv[4] else None))\nif sys.argv[3]: r.add_header('Authorization','Bearer '+sys.argv[3])\nr.add_header('Content-Type','application/json')\ntry:\n    resp=urllib.request.urlopen(r,timeout=30); print(resp.status); print(resp.read().decode())\nexcept urllib.error.HTTPError as e:\n    print(e.code); print(e.read().decode())\nexcept OSError as e:\n    print(type(e).__name__)\n",
      "http://127.0.0.1:18434/v1/models",
      "GET",
      "parity-incoming-token-0123456789abcdefghij",
      ""
     ],
     "user": "ubuntu"
    }
   },
   {
    "as": "chatThroughRelay",
    "shell": {
     "argv": [
      "python3",
      "-c",
      "import sys,urllib.request,urllib.error\nr=urllib.request.Request(sys.argv[1],method=sys.argv[2],data=(sys.argv[4].encode() if sys.argv[4] else None))\nif sys.argv[3]: r.add_header('Authorization','Bearer '+sys.argv[3])\nr.add_header('Content-Type','application/json')\ntry:\n    resp=urllib.request.urlopen(r,timeout=30); print(resp.status); print(resp.read().decode())\nexcept urllib.error.HTTPError as e:\n    print(e.code); print(e.read().decode())\nexcept OSError as e:\n    print(type(e).__name__)\n",
      "http://127.0.0.1:18434/v1/chat/completions",
      "POST",
      "parity-incoming-token-0123456789abcdefghij",
      "{\"model\": \"parity/tiny:1b\", \"stream\": true, \"messages\": [{\"role\": \"user\", \"content\": \"hi\"}]}"
     ],
     "user": "ubuntu"
    }
   },
   {
    "as": "relayNoToken",
    "shell": {
     "argv": [
      "python3",
      "-c",
      "import sys,urllib.request,urllib.error\nr=urllib.request.Request(sys.argv[1],method=sys.argv[2],data=(sys.argv[4].encode() if sys.argv[4] else None))\nif sys.argv[3]: r.add_header('Authorization','Bearer '+sys.argv[3])\nr.add_header('Content-Type','application/json')\ntry:\n    resp=urllib.request.urlopen(r,timeout=30); print(resp.status); print(resp.read().decode())\nexcept urllib.error.HTTPError as e:\n    print(e.code); print(e.read().decode())\nexcept OSError as e:\n    print(type(e).__name__)\n",
      "http://127.0.0.1:18434/v1/models",
      "GET",
      "",
      ""
     ],
     "user": "ubuntu"
    }
   },
   {
    "as": "openai",
    "mcp": {
     "method": "tools/call",
     "name": "probe_openai_compatible_server",
     "params": {
      "name": "probe_openai_compatible_server",
      "arguments": {
       "endpoint": "http://127.0.0.1:18434",
       "bearerToken": "parity-incoming-token-0123456789abcdefghij",
       "includeChat": true
      }
     }
    }
   },
   {
    "as": "relayed",
    "snapshot": {
     "baseline": "configured"
    }
   },
   {
    "as": "removeRelay",
    "mcp": {
     "method": "tools/call",
     "name": "remove_local_llm_relay",
     "params": {
      "name": "remove_local_llm_relay",
      "arguments": {
       "sessionId": "parity-t2-relay"
      }
     }
    }
   },
   {
    "as": "relayGone",
    "shell": {
     "argv": [
      "python3",
      "-c",
      "import sys,urllib.request,urllib.error\nr=urllib.request.Request(sys.argv[1],method=sys.argv[2],data=(sys.argv[4].encode() if sys.argv[4] else None))\nif sys.argv[3]: r.add_header('Authorization','Bearer '+sys.argv[3])\nr.add_header('Content-Type','application/json')\ntry:\n    resp=urllib.request.urlopen(r,timeout=30); print(resp.status); print(resp.read().decode())\nexcept urllib.error.HTTPError as e:\n    print(e.code); print(e.read().decode())\nexcept OSError as e:\n    print(type(e).__name__)\n",
      "http://127.0.0.1:18434/v1/models",
      "GET",
      "parity-incoming-token-0123456789abcdefghij",
      ""
     ],
     "user": "ubuntu"
    }
   },
   {
    "as": "removed",
    "snapshot": {
     "baseline": "relayed"
    }
   },
   {
    "as": "stop",
    "stop": {}
   },
   {
    "as": "teardown",
    "snapshot": {
     "baseline": "baseline"
    }
   }
  ],
  "compare": {
   "masks": [
    {
     "path": [
      "steps",
      "*",
      "body",
      "result",
      "createdAt"
     ],
     "type": "rfc3339",
     "reason": "wall-clock timestamp of this twin's run",
     "optional": true
    },
    {
     "path": [
      "steps",
      "*",
      "body",
      "result",
      "lastUpdatedAt"
     ],
     "type": "rfc3339",
     "reason": "wall-clock timestamp of this twin's run",
     "optional": true
    },
    {
     "path": [
      "steps",
      "*",
      "files",
      "added",
      "/home/ubuntu/.config/opute/ollama-runtime.json",
      "sha256"
     ],
     "type": "hex",
     "optional": true,
     "reason": "the runtime config stamps each persisted model context with its updatedAt time; its content is compared in T1 (llm-domain.ollama.lifecycle)"
    },
    {
     "path": [
      "steps",
      "*",
      "files",
      "changed",
      "/home/ubuntu/.config/opute/ollama-runtime.json",
      "after",
      "sha256"
     ],
     "type": "hex",
     "optional": true,
     "reason": "the runtime config stamps each persisted model context with its updatedAt time; its content is compared in T1 (llm-domain.ollama.lifecycle)"
    },
    {
     "path": [
      "steps",
      "*",
      "files",
      "changed",
      "/home/ubuntu/.config/opute/ollama-runtime.json",
      "before",
      "sha256"
     ],
     "type": "hex",
     "optional": true,
     "reason": "the runtime config stamps each persisted model context with its updatedAt time; its content is compared in T1 (llm-domain.ollama.lifecycle)"
    }
   ]
  },
  "memoryMb": 6144
 },
