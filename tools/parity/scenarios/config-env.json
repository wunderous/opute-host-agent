      "OPUTE_HOST_RESOURCE_ENFORCEMENT": "advisory",
      "OPUTE_HOST_RESOURCE_DISK_PATHS": "${SANDBOX}/state",
      "OPUTE_HOST_RESOURCE_DISK_CAPACITY_BYTES": "1073741824",
      "OPUTE_HOST_RESOURCE_POLICY_REVISION": "opute-host-resource-policy.parity",
      "OPUTE_HOST_RESOURCE_TASK_CAPACITY": "77"
     }
    }
   },
   {
    "as": "advisoryChecksCapacity",
    "mcp": {
     "method": "tools/call",
     "name": "inspect_host_file",
     "params": {
      "name": "inspect_host_file",
      "arguments": {
       "path": "${SANDBOX}/home/policy.txt"
      }
     },
     "expand": true
    }
   },
   {
    "as": "stopAdvisory",
