[
  {
    "id": "cli.version",
    "surface": "cli",
    "owner": "cli",
    "anchors": ["internal/cli/cli.go:Run --version"],
    "steps": [
      {"as": "long", "cli": {"argv": ["--version"]}},
      {"as": "short", "cli": {"argv": ["-version"]}}
    ]
  },
  {
    "id": "cli.help",
    "surface": "cli",
    "owner": "cli",
    "anchors": ["internal/cli/cli.go:printUsage"],
    "steps": [
      {"as": "help", "cli": {"argv": ["help"]}},
      {"as": "serveFlags", "cli": {"argv": ["serve", "-h"]}},
      {"as": "publicMcpFlags", "cli": {"argv": ["public-mcp", "-h"]}}
    ]
  },
  {
    "id": "cli.usage-errors",
    "surface": "cli",
    "owner": "cli",
    "anchors": ["internal/cli/cli.go:Run", "internal/cli/cli.go:runRecipe", "internal/cli/cli.go:runProvider"],
    "steps": [
      {"as": "unknownCommand", "cli": {"argv": ["bogus"]}},
      {"as": "unknownFlag", "cli": {"argv": ["serve", "--bogus"]}},
      {"as": "recipeNoSub", "cli": {"argv": ["recipe"]}},
      {"as": "recipeValidateNoSource", "cli": {"argv": ["recipe", "validate"]}},
      {"as": "providerNoSub", "cli": {"argv": ["provider"]}},
      {"as": "envFlagMalformed", "cli": {"argv": ["serve", "--env", "NOEQUALS", "--check"]}}
    ]
  },
  {
    "id": "cli.check.standalone-ok",
    "surface": "cli",
    "owner": "config",
    "anchors": ["internal/app/app.go:Check"],
    "collect": ["files", "sqlite"],
    "steps": [
      {"as": "check", "cli": {"argv": ["serve", "--mode=standalone", "--check"], "profile": "standalone"}}
    ]
  },
  {
    "id": "cli.check.platform-ok",
    "surface": "cli",
    "owner": "config",
    "anchors": ["internal/app/app.go:Check"],
    "collect": ["files"],
    "steps": [
      {"as": "check", "cli": {"argv": ["serve", "--mode=platform", "--check"], "profile": "platform"}}
    ]
  },
  {
    "id": "startup.fail-closed",
    "surface": "config",
    "owner": "config",
    "anchors": [
      "internal/config/config.go:Validate",
      "test/standalone/isolation_test.go:TestStandaloneInvalidConfigurationExitsBeforeMCP",
      "test/standalone/transport_cli_test.go:TestDeprecatedTransportFlagIsRejectOnly"
    ],
    "collect": ["files"],
    "steps": [
      {"as": "missingId", "cli": {"argv": ["serve", "--mode=standalone"], "profile": "standalone", "env": {"OPUTE_REMOTE_AGENT_ID": null}, "probePort": true}},
      {"as": "blankId", "cli": {"argv": ["serve", "--mode=standalone"], "profile": "standalone", "env": {"OPUTE_REMOTE_AGENT_ID": "   "}, "probePort": true}},
      {"as": "transportFlagWs", "cli": {"argv": ["serve", "--mode=standalone", "--transport=ws"], "profile": "standalone", "probePort": true}},
      {"as": "transportEnvStdio", "cli": {"argv": ["serve", "--mode=standalone"], "profile": "standalone", "env": {"OPUTE_TRANSPORT": "stdio"}, "probePort": true}},
      {"as": "reverseTunnelRetired", "cli": {"argv": ["serve", "--mode=standalone"], "profile": "standalone", "env": {"OPUTE_REVERSE_TUNNEL": "true"}, "probePort": true}},
      {"as": "wsUrlRetired", "cli": {"argv": ["serve", "--mode=standalone"], "profile": "standalone", "env": {"OPUTE_HOST_WS_URL": "ws://example.invalid"}, "probePort": true}},
      {"as": "cpcTokenRetired", "cli": {"argv": ["serve", "--mode=standalone"], "profile": "standalone", "env": {"OPUTE_CPC_TOKEN": "x"}, "probePort": true}},
      {"as": "onboardingRetired", "cli": {"argv": ["serve", "--mode=standalone"], "profile": "standalone", "env": {"OPUTE_ONBOARDING_TOKEN": "x"}, "probePort": true}},
      {"as": "standaloneWithPlatformUrl", "cli": {"argv": ["serve", "--mode=standalone"], "profile": "standalone", "env": {"OPUTE_MCP_URL": "http://example.invalid/mcp"}, "probePort": true}},
      {"as": "unsupportedProvider", "cli": {"argv": ["serve", "--mode=standalone"], "profile": "standalone", "env": {"OPUTE_INFRA_PROVIDER_ID": "docker"}, "probePort": true}},
      {"as": "envFileMissing", "cli": {"argv": ["serve", "--mode=standalone", "--env-file", "${SANDBOX}/missing.env"], "profile": "standalone", "probePort": true}}
    ]
  }
]
