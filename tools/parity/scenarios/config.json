[
  {
    "id": "config.env-precedence",
    "surface": "config",
    "owner": "config",
    "anchors": [
      "internal/cli/cli.go:runServer (env-file, --env, mode, transport)",
      "internal/config/envfile.go:LoadEnvFile",
      "internal/config/config.go:envValue"
    ],
    "steps": [
      {"as": "fileWs", "write": {"path": "${SANDBOX}/ws.env", "content": "# comment\n\nexport OPUTE_TRANSPORT='ws'\n", "mode": "0600"}},
      {"as": "fileHttp", "write": {"path": "${SANDBOX}/http.env", "content": "OPUTE_TRANSPORT = \"http\"\n", "mode": "0600"}},
      {"as": "fileBad", "write": {"path": "${SANDBOX}/bad.env", "content": "GOOD=1\nNOEQUALS\n"}},
      {"as": "fileId", "write": {"path": "${SANDBOX}/id.env", "content": "OPUTE_REMOTE_AGENT_ID=\"from-file\"\n"}},
      {"as": "envFileApplies", "cli": {"argv": ["--check", "--env-file", "${SANDBOX}/ws.env"], "profile": "standalone"}},
      {"as": "processEnvWinsOverFile", "cli": {"argv": ["--check", "--env-file", "${SANDBOX}/ws.env"], "profile": "standalone", "env": {"OPUTE_TRANSPORT": "http"}}},
      {"as": "blankProcessEnvLosesToFile", "cli": {"argv": ["--check", "--env-file", "${SANDBOX}/ws.env"], "profile": "standalone", "env": {"OPUTE_TRANSPORT": "   "}}},
      {"as": "envFlagWinsOverFile", "cli": {"argv": ["--check", "--env-file", "${SANDBOX}/ws.env", "--env", "OPUTE_TRANSPORT=http"], "profile": "standalone"}},
      {"as": "envFlagLastWins", "cli": {"argv": ["--check", "--env", "OPUTE_TRANSPORT=ws", "--env", "OPUTE_TRANSPORT=http"], "profile": "standalone"}},
      {"as": "envVarFile", "cli": {"argv": ["--check"], "profile": "standalone", "env": {"OPUTE_HOST_AGENT_ENV_FILE": "${SANDBOX}/ws.env"}}},
      {"as": "flagFileBeatsEnvVarFile", "cli": {"argv": ["--check", "--env-file", "${SANDBOX}/http.env"], "profile": "standalone", "env": {"OPUTE_HOST_AGENT_ENV_FILE": "${SANDBOX}/missing.env"}}},
      {"as": "badEnvFile", "cli": {"argv": ["--check", "--env-file", "${SANDBOX}/bad.env"], "profile": "standalone"}},
      {"as": "idFromFile", "cli": {"argv": ["--check", "--env-file", "${SANDBOX}/id.env"], "profile": "standalone", "env": {"OPUTE_REMOTE_AGENT_ID": null}}},
      {"as": "modeFlagBeatsEnv", "cli": {"argv": ["--check", "--mode=standalone"], "profile": "platform", "env": {"OPUTE_MCP_URL": "http://platform.invalid/mcp"}}},
      {"as": "modeDefaultsToStandalone", "cli": {"argv": ["--check"], "profile": "standalone", "env": {"OPUTE_AGENT_MODE": null, "OPUTE_MCP_URL": "http://platform.invalid/mcp"}}},
      {"as": "modeFromEnvFile", "cli": {"argv": ["--check", "--env", "OPUTE_AGENT_MODE=platform"], "profile": "standalone", "env": {"OPUTE_AGENT_MODE": null, "OPUTE_MCP_URL": "http://platform.invalid/mcp"}}},
      {"as": "modeCaseInsensitive", "cli": {"argv": ["--check", "--mode=Platform"], "profile": "platform"}},
      {"as": "invalidModeFlag", "cli": {"argv": ["--check", "--mode=standalonee"], "profile": "standalone"}},
      {"as": "transportCaseInsensitive", "cli": {"argv": ["--check", "--transport=HTTP"], "profile": "standalone"}},
      {"as": "quotedAgentId", "cli": {"argv": ["--check"], "profile": "standalone", "env": {"OPUTE_REMOTE_AGENT_ID": "'quoted-id'"}}},
      {"as": "quotedZeroPort", "cli": {"argv": ["--check"], "profile": "standalone", "env": {"HOST_MCP_PORT": "'0'"}}}
    ]
  },
  {
    "id": "config.validation-matrix",
    "surface": "config",
    "owner": "config",
    "anchors": ["internal/config/config.go:Validate", "internal/app/app.go:validateConfig"],
    "steps": [
      {"as": "tenantInvalid", "cli": {"argv": ["--check"], "profile": "standalone", "env": {"OPUTE_TENANT_ID": "-bad"}}},
      {"as": "tenantUpper", "cli": {"argv": ["--check"], "profile": "standalone", "env": {"OPUTE_TENANT_ID": "Tenant"}}},
      {"as": "tenantTooLong", "cli": {"argv": ["--check"], "profile": "standalone", "env": {"OPUTE_TENANT_ID": "abcdefghijklmnopqrstuvwxyz0123456"}}},
      {"as": "tenantOk", "cli": {"argv": ["--check"], "profile": "standalone", "env": {"OPUTE_TENANT_ID": "team-7"}}},
      {"as": "instanceTrailingDash", "cli": {"argv": ["--check"], "profile": "standalone", "env": {"OPUTE_HOST_AGENT_INSTANCE": "blue-"}}},
      {"as": "instanceTooLong", "cli": {"argv": ["--check"], "profile": "standalone", "env": {"OPUTE_HOST_AGENT_INSTANCE": "a123456789012345678901234567890123456789012345678901234567890123"}}},
      {"as": "ownershipEnforce", "cli": {"argv": ["--check"], "profile": "standalone", "env": {"OPUTE_INCUS_OWNERSHIP_MODE": "ENFORCE"}}},
      {"as": "ownershipUnknownIsAudit", "cli": {"argv": ["--check"], "profile": "standalone", "env": {"OPUTE_INCUS_OWNERSHIP_MODE": "strict"}}},
      {"as": "agentIdWithSpace", "cli": {"argv": ["--check"], "profile": "standalone", "env": {"OPUTE_REMOTE_AGENT_ID": "agent one"}}},
      {"as": "agentIdTab", "cli": {"argv": ["--check"], "profile": "standalone", "env": {"OPUTE_REMOTE_AGENT_ID": "a\tb"}}},
      {"as": "agentIdNonAscii", "cli": {"argv": ["--check"], "profile": "standalone", "env": {"OPUTE_REMOTE_AGENT_ID": "agént"}}},
      {"as": "agentIdTooLong", "cli": {"argv": ["--check"], "profile": "standalone", "env": {"OPUTE_REMOTE_AGENT_ID": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"}}},
      {"as": "agentIdSymbols", "cli": {"argv": ["--check"], "profile": "standalone", "env": {"OPUTE_REMOTE_AGENT_ID": "urn:opute:host/α"}}},
      {"as": "agentIdPrintable", "cli": {"argv": ["--check"], "profile": "standalone", "env": {"OPUTE_REMOTE_AGENT_ID": "urn:opute:host/7~!"}}},
      {"as": "portZero", "cli": {"argv": ["--check"], "profile": "standalone", "env": {"HOST_MCP_PORT": "0"}}},
      {"as": "portNegative", "cli": {"argv": ["--check"], "profile": "standalone", "env": {"HOST_MCP_PORT": "-5"}}},
      {"as": "portText", "cli": {"argv": ["--check"], "profile": "standalone", "env": {"HOST_MCP_PORT": "abc"}}},
      {"as": "portPlusSign", "cli": {"argv": ["--check"], "profile": "standalone", "env": {"HOST_MCP_PORT": "+3015"}}},
      {"as": "portHuge", "cli": {"argv": ["--check"], "profile": "standalone", "env": {"HOST_MCP_PORT": "99999999999999999999999"}}},
      {"as": "networkNameInvalid", "cli": {"argv": ["--check"], "profile": "standalone", "env": {"OPUTE_INCUS_NETWORK_NAME": "br_0"}}},
      {"as": "networkNameTooLong", "cli": {"argv": ["--check"], "profile": "standalone", "env": {"OPUTE_INCUS_NETWORK_NAME": "a1234567890123456789012345678901234567890123456789012345678901234"}}},
      {"as": "networkAddressNoPrefix", "cli": {"argv": ["--check"], "profile": "standalone", "env": {"OPUTE_INCUS_NETWORK_ADDRESS": "10.1.2.3"}}},
      {"as": "networkAddressV6", "cli": {"argv": ["--check"], "profile": "standalone", "env": {"OPUTE_INCUS_NETWORK_ADDRESS": "fd00::1/64"}}},
      {"as": "networkAddressMapped", "cli": {"argv": ["--check"], "profile": "standalone", "env": {"OPUTE_INCUS_NETWORK_ADDRESS": "::ffff:10.0.0.1/104"}}},
      {"as": "networkAddressLeadingZeroPrefix", "cli": {"argv": ["--check"], "profile": "standalone", "env": {"OPUTE_INCUS_NETWORK_ADDRESS": "10.0.0.1/024"}}},
      {"as": "networkAddressBadPrefix", "cli": {"argv": ["--check"], "profile": "standalone", "env": {"OPUTE_INCUS_NETWORK_ADDRESS": "10.0.0.1/33"}}},
      {"as": "networkAddressLeadingZeroOctet", "cli": {"argv": ["--check"], "profile": "standalone", "env": {"OPUTE_INCUS_NETWORK_ADDRESS": "10.0.0.01/24"}}},
      {"as": "cpuNaN", "cli": {"argv": ["--check"], "profile": "standalone", "env": {"OPUTE_HOST_RESOURCE_CPU_CAPACITY_CORES": "NaN"}}},
      {"as": "cpuInf", "cli": {"argv": ["--check"], "profile": "standalone", "env": {"OPUTE_HOST_RESOURCE_CPU_CAPACITY_CORES": "+Inf"}}},
      {"as": "cpuNegativeFallsBack", "cli": {"argv": ["--check"], "profile": "standalone", "env": {"OPUTE_HOST_RESOURCE_CPU_CAPACITY_CORES": "-2"}}},
      {"as": "limitsNegativeFallBack", "cli": {"argv": ["--check"], "profile": "standalone", "env": {"OPUTE_HOST_MAX_NORMAL_OPERATIONS": "-1", "OPUTE_HOST_MIN_AVAILABLE_DISK_BYTES": "-5"}}},
      {"as": "providerQuoted", "cli": {"argv": ["--check"], "profile": "standalone", "env": {"OPUTE_INFRA_PROVIDER_ID": "'incus'"}}},
      {"as": "providerUpper", "cli": {"argv": ["--check"], "profile": "standalone", "env": {"OPUTE_INFRA_PROVIDER_ID": "INCUS"}}},
      {"as": "reverseTunnelFalse", "cli": {"argv": ["--check"], "profile": "standalone", "env": {"OPUTE_REVERSE_TUNNEL": "false"}}},
      {"as": "reverseTunnelUpper", "cli": {"argv": ["--check"], "profile": "standalone", "env": {"OPUTE_REVERSE_TUNNEL": "TRUE"}}},
      {"as": "remoteAgentAuthTokenRetired", "cli": {"argv": ["--check"], "profile": "standalone", "env": {"OPUTE_REMOTE_AGENT_AUTH_TOKEN": "x"}}},
      {"as": "onboardingSessionRetired", "cli": {"argv": ["--check"], "profile": "platform", "env": {"OPUTE_ONBOARDING_SESSION_ID": "x"}}},
      {"as": "retiredBlankIgnored", "cli": {"argv": ["--check"], "profile": "standalone", "env": {"OPUTE_CPC_TOKEN": "   "}}},
      {"as": "healthUrlStandalone", "cli": {"argv": ["--check"], "profile": "standalone", "env": {"OPUTE_MCP_HEALTH_URL": "http://x.invalid/health"}}},
      {"as": "platformUrlsAllowed", "cli": {"argv": ["--check"], "profile": "platform", "env": {"OPUTE_MCP_URL": "http://x.invalid/mcp", "OPUTE_MCP_HEALTH_URL": "http://x.invalid/health"}}},
      {"as": "transportEnvWsPlatform", "cli": {"argv": ["--check"], "profile": "platform", "env": {"OPUTE_TRANSPORT": "ws"}}}
    ]
  }
]
